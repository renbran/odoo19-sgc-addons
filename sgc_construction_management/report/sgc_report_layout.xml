<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         SGC TECH AI — Universal Report Layout (All Standard Reports)
         
         This layout overrides the standard Odoo external_layout_standard
         with full SGC brand styling: Navy header bar, gold accents,
         IBM Plex fonts, branded footer.
         
         It is assigned to the company's external_report_layout_id so
         ALL reports (quotations, invoices, deliveries, purchase orders,
         receipts, etc.) automatically render with SGC brand.
         ================================================================ -->

    <template id="external_layout_sgc" name="SGC TECH AI Brand Layout">
        <t t-set="header_shape_height" t-value="'60'"/>
        
        <!-- ── Header: Navy bar with gold bottom border ── -->
        <div t-attf-class="header o_company_#{company.id}_layout o_sgc_header">
            <div class="o_sgc_header_bar" style="background-color: #0F213D; padding: 12px 20px;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td style="width: 64px; vertical-align: middle; padding-right: 12px;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                 style="max-height: 42px; max-width: 64px; display: block;"
                                 alt="Logo" class="o_sgc_logo"/>
                        </td>
                        <td style="vertical-align: middle;">
                            <div style="font-family: 'IBM Plex Serif', Georgia, serif; font-size: 14px; font-weight: 700; color: #FFFFFF; letter-spacing: 0.5px; line-height: 1.2;">
                                <t t-esc="company.name"/>
                            </div>
                            <div style="font-size: 8px; color: #D9C08A; line-height: 1.4; margin-top: 2px;">
                                <t t-if="company.street"><t t-esc="company.street"/></t>
                                <t t-if="company.street2">, <t t-esc="company.street2"/></t>
                                <t t-if="company.city">, <t t-esc="company.city"/></t>
                                <t t-if="company.state_id">, <t t-esc="company.state_id.name"/></t>
                                <t t-if="company.country_id">, <t t-esc="company.country_id.name"/></t>
                            </div>
                            <div style="font-size: 7.5px; color: #B79554; line-height: 1.3; margin-top: 1px;">
                                <t t-if="company.vat"><span style="color: #FFFFFF;">TRN: </span><t t-esc="company.vat"/></t>
                                <t t-if="company.phone"> <span style="color: #D9C08A; margin: 0 3px;">|</span> <t t-esc="company.phone"/></t>
                                <t t-if="company.email"> <span style="color: #D9C08A; margin: 0 3px;">|</span> <t t-esc="company.email"/></t>
                                <t t-if="company.website"> <span style="color: #D9C08A; margin: 0 3px;">|</span> <t t-esc="company.website"/></t>
                            </div>
                        </td>
                        <td style="width: 180px; vertical-align: middle; text-align: right; padding-left: 16px;">
                            <t t-if="company.report_header">
                                <div style="font-size: 9px; color: #B79554; line-height: 1.4; font-style: italic; border-left: 2px solid #B79554; padding-left: 12px;">
                                    <t t-raw="company.report_header"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div style="font-size: 8px; color: #B79554; line-height: 1.4; font-style: italic; border-left: 2px solid #B79554; padding-left: 12px;">
                                    Building Excellence, Delivering Trust
                                </div>
                            </t>
                        </td>
                    </tr>
                </table>
                <div style="border-bottom: 2px solid #B79554; margin-top: 8px;"/>
            </div>
        </div>

        <!-- ── Body Content ── -->
        <div t-attf-class="article o_report_layout_sgc o_company_#{company.id}_layout {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')"
             style="padding: 16px 24px;">

            <!-- Address block (from standard layout) -->
            <t t-call="web.address_layout"/>

            <!-- Document title in SGC style -->
            <h2 style="font-family: 'IBM Plex Serif', Georgia, serif; color: #0F213D; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.5px; border-bottom: 1px solid #B79554; padding-bottom: 8px; margin-bottom: 16px;">
                <t t-out="layout_document_title"/>
            </h2>

            <!-- Main content slot -->
            <t t-out="0"/>
        </div>

        <!-- ── Footer: Company details, page numbers, SGC branding ── -->
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <div style="border-top: 2px solid #B79554; padding: 6px 20px 4px 20px; background-color: #FAFAFA;">
                <table style="width: 100%; border-collapse: collapse; font-size: 7.5px;">
                    <tr>
                        <td style="width: 45%; padding-right: 8px; vertical-align: top; color: #5F6775; line-height: 1.4;">
                            <span style="color: #0F213D; font-weight: 700; font-size: 8px;"><t t-esc="company.name"/></span><br/>
                            <t t-if="company.street"><t t-esc="company.street"/></t>
                            <t t-if="company.city">, <t t-esc="company.city"/></t>
                            <t t-if="company.country_id">, <t t-esc="company.country_id.name"/></t>
                        </td>
                        <td style="width: 30%; padding: 0 8px; vertical-align: top; color: #5F6775;">
                            <t t-if="company.vat">TRN: <span style="color: #0F213D; font-weight: 600;"><t t-esc="company.vat"/></span><br/></t>
                            <t t-if="company.phone">T: <t t-esc="company.phone"/><br/></t>
                            <t t-if="company.email"><t t-esc="company.email"/><br/></t>
                        </td>
                        <td style="width: 25%; padding-left: 8px; vertical-align: top; text-align: right; white-space: nowrap;">
                            <span style="color: #B79554; font-weight: 600; font-family: 'IBM Plex Serif', Georgia, serif; font-size: 8px;">SGC TECH AI</span><br/>
                            <span style="color: #5F6775;">Page <span class="page"/>/<span class="topage"/></span><br/>
                            <span style="color: #D9C08A;"><t t-esc="datetime.date.today().strftime('%d %b %Y')"/></span>
                        </td>
                    </tr>
                </table>
                <t t-if="company.report_footer">
                    <div style="font-size: 6.5px; color: #5F6775; line-height: 1.2; margin-top: 2px; padding-top: 2px; border-top: 1px solid #ECE7DF;">
                        <t t-raw="company.report_footer"/>
                    </div>
                </t>
            </div>
        </div>
    </template>

    <!-- Override web.external_layout to use SGC layout always.
         Replace both t-call branches (if-else) with our SGC branded layout. -->
    <template id="external_layout" inherit_id="web.external_layout" name="SGC External Layout (Brand)">
        <xpath expr="//t[@t-call]" position="replace">
            <t t-call="sgc_construction_management.external_layout_sgc">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>
</odoo>
