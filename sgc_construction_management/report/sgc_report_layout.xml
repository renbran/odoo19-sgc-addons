<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         SGC TECH AI — Universal Report Layout (All Standard Reports)
         
         This layout overrides the standard Odoo external_layout_standard
         with full SGC brand styling: Navy header bar, gold accents,
         IBM Plex fonts, branded footer.
         
         It is assigned to the company's external_report_layout_id so
         ALL reports (quotations, invoices, deliveries, purchase orders,
         receipts, etc.) automatically render with SGC brand.
         ================================================================ -->

    <template id="external_layout_sgc" name="SGC TECH AI Brand Layout">
        <t t-set="header_shape_height" t-value="'60'"/>
        
        <!-- ── Header: Navy bar with gold bottom border ── -->
        <div t-attf-class="header o_company_#{company.id}_layout o_sgc_header">
            <div class="o_sgc_header_bar" style="background-color: #0F213D; padding: 10px 20px;">
                <div class="row" style="align-items: center; margin: 0;">
                    <div class="col-4" style="padding: 0;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                             style="max-height: 36px; max-width: 140px; filter: brightness(0) invert(1);"
                             alt="Logo" class="o_sgc_logo"/>
                    </div>
                    <div class="col-4 text-center" style="padding: 0;">
                        <div style="font-family: 'IBM Plex Serif', Georgia, serif; font-size: 13px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.5px;">
                            <t t-esc="company.name"/>
                        </div>
                        <div style="font-size: 8px; color: #D9C08A; line-height: 1.3; margin-top: 2px;">
                            <t t-if="company.street"><t t-esc="company.street"/></t>
                            <t t-if="company.city"><t t-if="company.street">, </t><t t-esc="company.city"/></t>
                            <t t-if="company.country_id">, <t t-esc="company.country_id.name"/></t>
                        </div>
                        <div t-if="company.website" style="font-size: 7px; color: #B79554; margin-top: 1px;">
                            <t t-esc="company.website"/>
                        </div>
                    </div>
                    <div class="col-4 text-end" style="padding: 0; font-size: 8px; color: #B79554;">
                        <div t-if="company.vat" style="color: #FFFFFF; font-size: 9px;">
                            <span style="color: #B79554;">VAT: </span><t t-esc="company.vat"/>
                        </div>
                        <div t-if="company.phone" style="color: #D9C08A; font-size: 8px;">
                            <t t-esc="company.phone"/>
                        </div>
                        <div t-if="company.email" style="color: #D9C08A; font-size: 8px;">
                            <t t-esc="company.email"/>
                        </div>
                    </div>
                </div>
                <div style="border-bottom: 2px solid #B79554; margin-top: 6px;"/>
            </div>
            <div t-if="company.report_header" class="o_sgc_tagline" style="background-color: #F7F4EE; padding: 4px 20px; font-size: 9px; color: #5F6775; font-style: italic; text-align: center; border-bottom: 1px solid #ECE7DF;">
                <t t-raw="company.report_header"/>
            </div>
        </div>

        <!-- ── Body Content ── -->
        <div t-attf-class="article o_report_layout_sgc o_company_#{company.id}_layout {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')"
             style="padding: 16px 24px;">

            <!-- Address block (from standard layout) -->
            <t t-call="web.address_layout"/>

            <!-- Document title in SGC style -->
            <h2 style="font-family: 'IBM Plex Serif', Georgia, serif; color: #0F213D; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.5px; border-bottom: 1px solid #B79554; padding-bottom: 8px; margin-bottom: 16px;">
                <t t-out="layout_document_title"/>
            </h2>

            <!-- Main content slot -->
            <t t-out="0"/>
        </div>

        <!-- ── Footer: Gold top border, page numbers, SGC TECH AI branding ── -->
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <div style="border-top: 2px solid #B79554; padding: 8px 20px 4px 20px; background-color: #F7F4EE;">
                <div class="row" style="margin: 0; align-items: center;">
                    <div class="col-6" style="padding: 0;">
                        <!-- Company footer text if set -->
                        <t t-if="company.report_footer">
                            <div style="font-size: 7px; color: #5F6775; line-height: 1.3;">
                                <t t-raw="company.report_footer"/>
                            </div>
                        </t>
                    </div>
                    <div class="col-6 text-end" style="padding: 0;">
                        <div style="font-size: 8px; color: #5F6775; display: flex; justify-content: flex-end; align-items: center; gap: 12px;">
                            <t t-if="report_type == 'pdf' and display_name_in_footer">
                                <span style="color: #0F213D;" t-out="o.name">(doc name)</span>
                            </t>
                            <span style="color: #B79554; font-weight: 600; font-family: 'IBM Plex Serif', Georgia, serif;">SGC TECH AI</span>
                            <span>Page <span class="page"/> / <span class="topage"/></span>
                            <span style="color: #D9C08A;"><t t-esc="datetime.date.today().strftime('%d %b %Y')"/></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Override web.external_layout to use SGC layout always.
         Replace both t-call branches (if-else) with our SGC branded layout. -->
    <template id="external_layout" inherit_id="web.external_layout" name="SGC External Layout (Brand)">
        <xpath expr="//t[@t-call]" position="replace">
            <t t-call="sgc_construction_management.external_layout_sgc">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>
</odoo>
