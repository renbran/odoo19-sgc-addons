<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         SGC TECH AI — Universal Report Layout (All Standard Reports)

         This layout overrides the standard Odoo external_layout_standard
         with full SGC brand styling: cream/ivory page, navy typography,
         gold hairlines/accents, IBM Plex fonts.

         It is assigned to the company's external_report_layout_id AND
         directly hijacks web.external_layout (see the "external_layout"
         template below), so ALL reports (quotations, invoices,
         deliveries, purchase orders, receipts, etc.) automatically
         render with the SGC brand regardless of report-specific
         inheritance elsewhere.

         2026-07-27: rebuilt header/title/info-grid to match the SGC
         "Pro-Forma Invoice" reference mockup: logo + brand name/tagline
         on the LEFT, company address/contact on the RIGHT, a gold
         hairline under the header, a centered serif document title with
         a gold rule-diamond-rule accent, and individually-boxed info
         fields (Reference / Date / Salesperson / etc.) instead of one
         shared card. Table styling softened to clean hairline rows
         (see static/src/css/sgc_report.css) instead of a full grid.
         ================================================================ -->

    <template id="external_layout_sgc" name="SGC TECH AI Brand Layout">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company" t-set="company" t-value="res_company"/>

        <!-- Global SGC Fonts & Base Styles -->
        <style>
            @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@400;600;700&amp;family=IBM+Plex+Sans:wght@400;500;600;700&amp;display=swap');
            .o_sgc_header, .o_sgc_footer, .o_report_layout_sgc {
                font-family: 'IBM Plex Sans', Helvetica, Arial, sans-serif;
                color: #1C2430;
            }
            .sgc-serif {
                font-family: 'IBM Plex Serif', Georgia, serif;
            }
        </style>

        <!-- ── Header: logo + brand on the left, company address/contact on the right ── -->
        <div t-attf-class="header o_company_#{company.id}_layout o_sgc_header">
            <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                <colgroup>
                    <col style="width: 55%;"/>
                    <col style="width: 45%;"/>
                </colgroup>
                <tr>
                    <!-- Left: Logo + Brand Name + Tagline -->
                    <td style="vertical-align: middle;">
                        <table style="border-collapse: collapse;">
                            <tr>
                                <td style="width: auto; padding-right: 10px; vertical-align: middle;">
                                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 42px; max-width: 64px; display: block;" alt="Logo" class="o_sgc_logo"/>
                                </td>
                                <td style="vertical-align: middle;">
                                    <!-- Short brand name (text before the first parenthesis,
                                         e.g. "SGC TECH AI" out of "SGC TECH AI (Scholarix
                                         Global Consultant FZE)") - the full legal name is long
                                         enough that at a readable font size it wraps onto a
                                         second line and overflows wkhtmltopdf's fixed header
                                         box height. The full legal name is still shown in full
                                         in the footer. -->
                                    <t t-set="header_brand_name" t-value="company.name.split('(')[0].strip() if company.name and '(' in company.name else company.name"/>
                                    <div style="font-family: Helvetica, Arial, sans-serif; font-size: 17px; font-weight: 700; color: #FFFFFF; letter-spacing: 0.3px; line-height: 1.1; display: block !important; visibility: visible !important;">
                                        <span>VISIBLE-TEST</span>
                                    </div>
                                    <div style="font-family: 'IBM Plex Sans', Helvetica, Arial, sans-serif; font-size: 7.5px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #D9C08A; margin-top: 2px;">
                                        Finance · System · Technology
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>

                    <!-- Right: compact company info (one line of address, then one line
                         of T / E / W). Full street address is rendered in the
                         footer below, where there's room for it - keeping the
                         header band compact prevents wkhtmltopdf from clipping
                         the brand name / logo area. -->
                    <td style="vertical-align: middle; text-align: right; padding-left: 16px; font-size: 9px; line-height: 1.55; color: #FFFFFF;">
                        <div style="font-weight: 600; color: #FFFFFF; font-size: 9px; letter-spacing: 0.3px; white-space: nowrap;">
                            <t t-set="header_address_parts" t-value="[]"/>
                            <t t-if="company.city" t-set="header_address_parts" t-value="header_address_parts + [company.city]"/>
                            <t t-if="company.country_id" t-set="header_address_parts" t-value="header_address_parts + [company.country_id.name]"/>
                            <span t-if="header_address_parts" t-out="', '.join(header_address_parts)"/>
                        </div>
                        <div style="margin-top: 4px; color: #D9C08A; font-size: 7.5px; letter-spacing: 0.3px;">
                            <t t-set="header_contact_parts" t-value="[]"/>
                            <t t-if="company.phone" t-set="header_contact_parts" t-value="header_contact_parts + [company.phone]"/>
                            <t t-if="company.email" t-set="header_contact_parts" t-value="header_contact_parts + [company.email]"/>
                            <t t-if="company.website" t-set="header_contact_parts" t-value="header_contact_parts + [company.website]"/>
                            <span t-if="header_contact_parts" t-out="'  ·  '.join(header_contact_parts)"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Gold Hairline -->
            <div style="border-bottom: 2px solid #B79554; margin-top: 8px;"/>
        </div>

        <!-- ── Body Content ── -->
        <div t-attf-class="article o_report_layout_sgc o_company_#{company.id}_layout {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
             t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')"
             style="padding: 6mm 4mm;">

            <!-- Document Title: centered serif with gold rule-diamond-rule accent -->
            <div style="text-align: center; margin: 4px 0 18px 0;">
                <h2 class="sgc-serif" style="font-size: 22px; font-weight: 700; color: #0F213D; letter-spacing: 1px; text-transform: uppercase; margin: 0; border: none; padding: 0;">
                    <t t-out="layout_document_title"/>
                </h2>
                <div style="margin-top: 8px;">
                    <span style="display: inline-block; vertical-align: middle; width: 60px; height: 1px; background-color: #B79554;"/>
                    <span style="display: inline-block; vertical-align: middle; width: 5px; height: 5px; margin: 0 8px; background-color: #B79554;"/>
                    <span style="display: inline-block; vertical-align: middle; width: 60px; height: 1px; background-color: #B79554;"/>
                </div>
            </div>

            <!-- Address block: "Bill To" label for sales/invoice documents, plain otherwise -->
            <div t-if="o and o._name in ('sale.order', 'account.move')" style="font-size: 8px; text-transform: uppercase; letter-spacing: 1.5px; color: #B79554; font-weight: 700; margin-bottom: 4px;">
                <t t-if="o._name == 'account.move' and o.move_type in ('out_refund', 'in_refund')">Credit To</t>
                <t t-else="">Bill To</t>
            </div>
            <t t-call="web.address_layout"/>

            <!-- Main content slot -->
            <t t-out="0"/>
        </div>

        <!-- ── Footer: fixed-layout table, uniform vertical alignment on every cell ── -->
        <div t-attf-class="footer o_company_#{company.id}_layout o_sgc_footer {{report_type != 'pdf' and 'mt-auto'}}" style="font-size: 8px; line-height: 1.5; color: #1C2430; padding: 0 4mm; overflow: visible;">
            <div style="border-top: 2px solid #B79554; padding-top: 4mm;">

                <table style="width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 8px; line-height: 1.5; color: #5F6775;">
                    <colgroup>
                        <col style="width: 40%;"/>
                        <col style="width: 40%;"/>
                        <col style="width: 20%;"/>
                    </colgroup>
                    <tr>
                        <!-- Column 1: Company Name & Tagline -->
                        <td style="vertical-align: top; padding-right: 10px;">
                            <span style="font-weight: 700; color: #0F213D; font-size: 10px;"><t t-esc="company.name"/></span><br/>
                            <span style="font-size: 8px; letter-spacing: 0.5px; color: #B79554;">Finance · System · Technology</span>
                        </td>

                        <!-- Column 2: Address & Contact Details -->
                        <td style="vertical-align: top; padding: 0 10px;">
                            <span t-field="company.partner_id" t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/><br/>
                            <t t-set="footer_contact_parts" t-value="[]"/>
                            <t t-if="company.phone" t-set="footer_contact_parts" t-value="footer_contact_parts + ['T: ' + company.phone]"/>
                            <t t-if="company.email" t-set="footer_contact_parts" t-value="footer_contact_parts + [company.email]"/>
                            <span t-if="footer_contact_parts" t-out="' | '.join(footer_contact_parts)"/>
                        </td>

                        <!-- Column 3: Branding & Page Numbers -->
                        <td style="vertical-align: top; text-align: right; padding-left: 10px; white-space: nowrap;">
                            <span style="font-weight: 600; color: #0F213D;">SGC TECH AI</span><br/>
                            <span style="color: #5F6775;">Page <span class="page"/> / <span class="topage"/></span>
                        </td>
                    </tr>
                </table>

                <!-- Optional Custom Footer Note -->
                <t t-if="company.report_footer">
                    <div style="font-size: 7px; color: #5F6775; line-height: 1.3; margin-top: 6px; padding-top: 4px; border-top: 1px solid #ECE7DF; text-align: center;">
                        <t t-raw="company.report_footer"/>
                    </div>
                </t>
            </div>
        </div>
    </template>

    <!-- Override web.external_layout: fix doc access + use our layout.
         Fix 1: The standard template has <t t-if="not o" t-set="o" t-value="doc"/>
         which raises KeyError: 'doc' in preview mode because _get_render_information
         passes no 'doc' or 'o'. Replace with safe no-op.
         Fix 2: Replace the t-call to use our branded layout. -->
    <template id="external_layout" inherit_id="web.external_layout" name="SGC External Layout (Brand)">
        <xpath expr="//t[@t-if='not o' and @t-set='o' and @t-value='doc']" position="replace">
            <t t-set="_x" t-value="0"/>
        </xpath>
        <xpath expr="//t[@t-call]" position="replace">
            <t t-call="sgc_construction_management.external_layout_sgc">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>
</odoo>
