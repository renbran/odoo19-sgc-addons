<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_construction_portrait" model="report.paperformat">
        <field name="name">SGC Construction A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <template id="construction_external_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company" t-set="company" t-value="res_company"/>

        <div class="header sgc-report" style="background-color: #0F213D; padding: 14px 20px 16px 20px; margin: 0 -20px 16px -20px;">
            <div class="row" style="align-items: center;">
                <div class="col-8" style="padding-right: 16px;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="width: 72px; vertical-align: middle; padding-right: 12px;">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 48px; max-width: 72px; display: block;" alt="Logo"/>
                            </td>
                            <td style="vertical-align: middle;">
                                <div style="font-size: 15px; font-weight: 700; color: #FFFFFF; font-family: 'IBM Plex Serif', Georgia, serif; letter-spacing: 0.5px; line-height: 1.2;">
                                    <t t-esc="company.name"/>
                                </div>
                                <div style="font-size: 8.5px; color: #D9C08A; line-height: 1.4; margin-top: 2px;">
                                    <t t-if="company.street"><t t-esc="company.street"/></t>
                                    <t t-if="company.street2">, <t t-esc="company.street2"/></t>
                                    <t t-if="company.city">, <t t-esc="company.city"/></t>
                                    <t t-if="company.state_id">, <t t-esc="company.state_id.name"/></t>
                                    <t t-if="company.country_id">, <t t-esc="company.country_id.name"/></t>
                                </div>
                                <div style="font-size: 8px; color: #B79554; line-height: 1.3; margin-top: 1px;">
                                    <t t-if="company.vat"><span style="color: #FFFFFF;">TRN: </span><t t-esc="company.vat"/></t>
                                    <t t-if="company.phone"> <span style="color: #D9C08A; margin: 0 4px;">|</span> <t t-esc="company.phone"/></t>
                                    <t t-if="company.email"> <span style="color: #D9C08A; margin: 0 4px;">|</span> <t t-esc="company.email"/></t>
                                    <t t-if="company.website"> <span style="color: #D9C08A; margin: 0 4px;">|</span> <t t-esc="company.website"/></t>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col-4 text-end" style="padding-left: 8px;">
                    <t t-if="company.report_header">
                        <div style="font-size: 9px; color: #B79554; line-height: 1.4; font-style: italic; border-left: 2px solid #B79554; padding-left: 12px;">
                            <t t-raw="company.report_header"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div style="font-size: 8px; color: #B79554; line-height: 1.4; font-style: italic; border-left: 2px solid #B79554; padding-left: 12px;">
                            Building Excellence, Delivering Trust
                        </div>
                    </t>
                </div>
            </div>
            <div style="border-bottom: 2px solid #B79554; margin-top: 10px;"/>
            <!-- Project reference bar -->
            <t t-if="o">
                <div style="background-color: #1A2E4A; margin: 8px -20px -16px -20px; padding: 5px 20px; display: flex; justify-content: space-between; align-items: center;">
                    <t t-if="o._name == 'construction.ra.billing' and o._fields.get('project_id')">
                        <span style="font-size: 8px; color: #D9C08A; text-transform: uppercase; letter-spacing: 0.5px;">Project: <span style="color: #FFFFFF; text-transform: none; letter-spacing: 0;"><t t-esc="o.project_id.name or ''"/></span></span>
                        <span style="font-size: 8px; color: #B79554;">Ref: <t t-esc="o.ra_number or ''"/></span>
                    </t>
                    <t t-elif="o._name == 'construction.project'">
                        <span style="font-size: 8px; color: #D9C08A; text-transform: uppercase; letter-spacing: 0.5px;">Project: <span style="color: #FFFFFF; text-transform: none; letter-spacing: 0;"><t t-esc="o.name or ''"/></span></span>
                        <t t-if="o._fields.get('ref') and o.ref">
                            <span style="font-size: 8px; color: #B79554;">Code: <t t-esc="o.ref"/></span>
                        </t>
                    </t>
                    <t t-elif="o._name == 'construction.progress.billing' and o._fields.get('project_id')">
                        <span style="font-size: 8px; color: #D9C08A; text-transform: uppercase; letter-spacing: 0.5px;">Project: <span style="color: #FFFFFF; text-transform: none; letter-spacing: 0;"><t t-esc="o.project_id.name or ''"/></span></span>
                        <span style="font-size: 8px; color: #B79554;">Ref: <t t-esc="o.ref or ''"/></span>
                    </t>
                    <t t-elif="o._fields.get('project_id')">
                        <span style="font-size: 8px; color: #D9C08A; text-transform: uppercase; letter-spacing: 0.5px;">Project: <span style="color: #FFFFFF; text-transform: none; letter-spacing: 0;"><t t-esc="o.project_id.name or ''"/></span></span>
                    </t>
                </div>
            </t>
        </div>

        <div class="article sgc-report" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" style="padding: 5px 0 10px 0;">
            <t t-out="0"/>
        </div>

        <div class="footer sgc-report" style="padding-bottom: 4px;">
            <div style="border-top: 2px solid #B79554; font-size: 8px; padding-top: 8px; margin-top: 16px;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td style="width: 50%; padding-right: 8px; vertical-align: top;">
                            <div style="color: #0F213D; font-weight: 700; font-size: 9px; font-family: 'IBM Plex Serif', Georgia, serif;"><t t-esc="company.name"/></div>
                            <div style="color: #5F6775; line-height: 1.4; margin-top: 2px;">
                                <t t-if="company.street"><t t-esc="company.street"/></t>
                                <t t-if="company.city"><t t-if="company.street">, </t><t t-esc="company.city"/></t>
                                <t t-if="company.country_id">, <t t-esc="company.country_id.name"/></t>
                            </div>
                        </td>
                        <td style="width: 30%; padding: 0 8px; vertical-align: top; color: #5F6775;">
                            <t t-if="company.vat">TRN: <span style="color: #0F213D; font-weight: 600;"><t t-esc="company.vat"/></span><br/></t>
                            <t t-if="company.phone">T: <t t-esc="company.phone"/><br/></t>
                            <t t-if="company.email"><t t-esc="company.email"/><br/></t>
                        </td>
                        <td style="width: 20%; padding-left: 8px; vertical-align: top; text-align: right; white-space: nowrap;">
                            <div style="color: #5F6775;">Page <span class="page"/>/<span class="topage"/></div>
                            <div style="color: #B79554; font-weight: 600; font-family: 'IBM Plex Serif', Georgia, serif; margin-top: 2px;">SGC TECH AI</div>
                            <div style="color: #D9C08A; margin-top: 1px;"><t t-esc="datetime.date.today().strftime('%d %b %Y')"/></div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>
</odoo>
