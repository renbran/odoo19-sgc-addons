<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_construction_portrait" model="report.paperformat">
        <field name="name">SGC Construction A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <template id="construction_external_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company" t-set="company" t-value="res_company"/>

        <div class="header sgc-report" style="background-color: #0F213D; padding: 12px 20px; margin: -35px -20px 0 -20px;">
            <div class="row" style="align-items: center;">
                <div class="col-3">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 42px; max-width: 100%; filter: brightness(0) invert(1);" alt="Company Logo"/>
                </div>
                <div class="col-6 text-center">
                    <strong style="font-size:14px; color: #FFFFFF; font-family: 'IBM Plex Serif', Georgia, serif; letter-spacing: 0.5px;"><t t-esc="company.name"/></strong>
                    <div style="font-size:9px; line-height:1.4; color: #B79554;">
                        <t t-if="company.street"><t t-esc="company.street"/></t>
                        <t t-if="company.city"><t t-if="company.street">, </t><t t-esc="company.city"/></t>
                        <t t-if="company.country_id">, <t t-esc="company.country_id.name"/></t>
                    </div>
                    <div t-if="company.website" style="font-size:8px; color: #D9C08A;"><t t-esc="company.website"/></div>
                </div>
                <div class="col-3 text-end" style="font-size:9px; color: #FFFFFF;">
                    <t t-if="o and o._name != 'construction.project' and o._fields.get('project_id')">
                        <div style="font-weight:600; color: #B79554; text-transform: uppercase; letter-spacing: 1px; font-size: 8px;">Project</div>
                        <div style="font-weight:bold; color: #FFFFFF;"><t t-esc="o.project_id.name"/></div>
                    </t>
                    <t t-if="o and o._name == 'construction.project'">
                        <div style="font-weight:600; color: #B79554; text-transform: uppercase; letter-spacing: 1px; font-size: 8px;">Project</div>
                        <div style="font-weight:bold; color: #FFFFFF;"><t t-esc="o.name"/></div>
                    </t>
                    <t t-elif="o and o._name == 'construction.ra.billing'">
                        <div style="font-weight:600; color: #B79554; text-transform: uppercase; letter-spacing: 1px; font-size: 8px;">RA Reference</div>
                        <div style="color: #FFFFFF;"><t t-esc="o.ra_number"/></div>
                    </t>
                    <t t-elif="o and o._name == 'construction.progress.billing'">
                        <div style="font-weight:600; color: #B79554; text-transform: uppercase; letter-spacing: 1px; font-size: 8px;">Reference</div>
                        <div style="color: #FFFFFF;"><t t-esc="o.ref"/></div>
                    </t>
                </div>
            </div>
            <div style="border-bottom: 2px solid #B79554; margin-top: 8px;"/>
        </div>

        <div class="article sgc-report" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" style="padding: 10px 0;">
            <t t-out="0"/>
        </div>

        <div class="footer sgc-report">
            <div style="border-top: 2px solid #B79554; font-size: 8px; padding-top: 8px; margin-top: 16px;">
                <div class="row" style="margin-top: 6px;">
                    <div class="col-4 signature-block">
                        <strong style="color: #0F213D; text-transform: uppercase; letter-spacing: 0.5px; font-size: 8px;">Prepared By</strong><br/>
                        <span class="signature-line"/><br/>
                        <t t-if="o and o._fields.get('prepared_by') and o.prepared_by">
                            <span style="color: #1C2430;"><t t-esc="o.prepared_by.name"/></span>
                        </t>
                        <t t-else="">
                            <span style="color: #5F6775;">Signature</span>
                        </t>
                    </div>
                    <div class="col-4 signature-block">
                        <strong style="color: #0F213D; text-transform: uppercase; letter-spacing: 0.5px; font-size: 8px;">Checked By</strong><br/>
                        <span class="signature-line"/><br/>
                        <span style="color: #5F6775;">Project Manager / QS</span>
                    </div>
                    <div class="col-4 signature-block">
                        <strong style="color: #0F213D; text-transform: uppercase; letter-spacing: 0.5px; font-size: 8px;">Approved By</strong><br/>
                        <span class="signature-line"/><br/>
                        <span style="color: #5F6775;">Client / Consultant</span>
                    </div>
                </div>
                <div style="margin-top: 8px; padding-top: 6px; border-top: 1px solid #D9C08A; color: #5F6775; display: flex; justify-content: space-between;">
                    <span>Page <span class="page"/> of <span class="topage"/></span>
                    <span>Printed on: <t t-esc="datetime.date.today().strftime('%d %b %Y')"/></span>
                    <span style="color: #B79554; font-weight: 600;">SGC TECH AI</span>
                </div>
            </div>
        </div>
    </template>
</odoo>
