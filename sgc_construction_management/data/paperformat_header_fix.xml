<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        2026-07-27: base.paperformat_euro (the company's paperformat_id,
        used by every standard report on this single-tenant instance) had
        margin_top=30mm / header_spacing=40mm. That is not enough vertical
        room for the SGC branded header (logo + multi-line company
        address in external_layout_sgc, see report/sgc_report_layout.xml)
        wkhtmltopdf renders the header into a box sized by the margin top
        option, so content taller than that gets silently clipped, which
        is why printed reports showed a near-empty navy strip instead of
        the logo/name/address.

        Raising margin_top to comfortably fit that header and lowering
        header_spacing (the gap AFTER the header, before body content
        starts - previously larger than the header box itself, wasting
        page space) to a normal small value. margin_bottom is untouched;
        the footer already rendered fully within it.
    -->
    <record id="base.paperformat_euro" model="report.paperformat">
        <field name="margin_top">45</field>
        <field name="header_spacing">6</field>
    </record>
</odoo>
