<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action for Auto Lead Enrichment -->
        <record id="ir_cron_enrich_leads" model="ir.cron">
            <field name="name">LLM Lead Scoring: Auto Enrich Leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_enrich_leads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <!-- Deliberate, permanent divergence from prod's file on disk:
                 prod's copy still has numbercall/doall fields (Odoo 19
                 removed them from ir.cron entirely — presence raises
                 ValueError: Invalid field 'numbercall' in 'ir.cron' the
                 next time this data file is reloaded). Prod's copy is
                 only harmless because it hasn't been reloaded since the
                 Odoo 17->19 migration. Do NOT "fix" this file to match
                 prod's disk copy again — see bd0b4cc and 56f5e40. -->
        </record>
    </data>
</odoo>
