<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="sgc_approach_content" name="SGC Approach Page">
<t t-set="title">Our 90-Day Approach | SGC Tech Transformation Roadmap</t>
<t t-set="aurum_page_meta">Our proven 90-day methodology: Assess, Design, Implement and Optimize. A structured transformation roadmap that delivers measurable outcomes for UAE businesses.</t>
<t t-call="website.layout">
<div id="wrap" class="oe_structure">
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://sgctech.ai/"},
                    {"@type": "ListItem", "position": 2, "name": "Approach", "item": "https://sgctech.ai/our-approach"}
                ]
            }
            </script>

    <!-- HERO -->
    <section class="aurum-hero">
        <div class="container aurum-hero-inner">
            <div class="row align-items-center">
                <div class="col-lg-9">
                    <span class="aurum-eyebrow aurum-reveal">OUR METHODOLOGY</span>
                    <h1 class="aurum-reveal" data-aurum-delay="1">90-Day Roadmap to Transformation</h1>
                    <p class="aurum-lead aurum-reveal" data-aurum-delay="2">
                        A proven, structured approach that takes your organization from
                        assessment to sustainable transformation in just 90 days.
                    </p>
                    <div class="d-flex flex-wrap gap-3 mt-4 aurum-reveal" data-aurum-delay="3">
                        <a href="/contact-us" class="btn btn-aurum-gold" aria-label="Start your transformation journey">Start the Conversation</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4-PHASE TIMELINE -->
    <section class="aurum-section aurum-navy-bg" id="timeline">
        <div class="container text-center">
            <span class="aurum-eyebrow aurum-reveal">THE JOURNEY</span>
            <h2 class="aurum-h aurum-reveal">From Assessment to Optimization</h2>
            <div class="aurum-divider"/>

            <div class="aurum-roadmap mt-5">
                <div class="aurum-roadmap-line"/>
                <div class="row g-4">

                    <!-- Phase 1 -->
                    <div class="col-12 col-lg-3 aurum-roadmap-step aurum-reveal">
                        <div class="aurum-roadmap-badge">01</div>
                        <h3 style="color:#fff;">Assess</h3>
                        <div class="small" style="color:#c9a227;letter-spacing:.08em;">Weeks 1–3</div>
                        <p class="small text-white-50 mt-2" style="line-height:1.6;">
                            We dive deep into your current state, uncovering gaps and
                            opportunities through stakeholder interviews, process analysis,
                            and data review.
                        </p>
                        <ul class="list-unstyled small text-start mt-3" style="color:rgba(255,255,255,.7);">
                            <li style="padding:.25rem 0;">• Current State Assessment &amp; Gap Analysis</li>
                            <li style="padding:.25rem 0;">• Stakeholder Interview Findings</li>
                            <li style="padding:.25rem 0;">• Prioritized Opportunity Matrix</li>
                        </ul>
                    </div>

                    <!-- Phase 2 -->
                    <div class="col-12 col-lg-3 aurum-roadmap-step aurum-reveal" data-aurum-delay="1">
                        <div class="aurum-roadmap-badge">02</div>
                        <h3 style="color:#fff;">Design</h3>
                        <div class="small" style="color:#c9a227;letter-spacing:.08em;">Weeks 4–6</div>
                        <p class="small text-white-50 mt-2" style="line-height:1.6;">
                            We craft a tailored strategy and execution roadmap, aligned with
                            your business objectives and resource constraints.
                        </p>
                        <ul class="list-unstyled small text-start mt-3" style="color:rgba(255,255,255,.7);">
                            <li style="padding:.25rem 0;">• Strategic Transformation Roadmap</li>
                            <li style="padding:.25rem 0;">• Detailed Implementation Plan</li>
                            <li style="padding:.25rem 0;">• Resource &amp; Budget Allocation</li>
                        </ul>
                    </div>

                    <!-- Phase 3 -->
                    <div class="col-12 col-lg-3 aurum-roadmap-step aurum-reveal" data-aurum-delay="2">
                        <div class="aurum-roadmap-badge">03</div>
                        <h3 style="color:#fff;">Implement</h3>
                        <div class="small" style="color:#c9a227;letter-spacing:.08em;">Weeks 7–9</div>
                        <p class="small text-white-50 mt-2" style="line-height:1.6;">
                            We execute alongside your team, deploying solutions, configuring
                            systems, and building capabilities for lasting change.
                        </p>
                        <ul class="list-unstyled small text-start mt-3" style="color:rgba(255,255,255,.7);">
                            <li style="padding:.25rem 0;">• Solution Deployment &amp; Configuration</li>
                            <li style="padding:.25rem 0;">• Team Training &amp; Capability Building</li>
                            <li style="padding:.25rem 0;">• Go-Live Support &amp; Hypercare</li>
                        </ul>
                    </div>

                    <!-- Phase 4 -->
                    <div class="col-12 col-lg-3 aurum-roadmap-step aurum-reveal" data-aurum-delay="3">
                        <div class="aurum-roadmap-badge">04</div>
                        <h3 style="color:#fff;">Optimize</h3>
                        <div class="small" style="color:#c9a227;letter-spacing:.08em;">Weeks 10–12</div>
                        <p class="small text-white-50 mt-2" style="line-height:1.6;">
                            We measure outcomes, refine approaches, and establish continuous
                            improvement mechanisms to sustain momentum.
                        </p>
                        <ul class="list-unstyled small text-start mt-3" style="color:rgba(255,255,255,.7);">
                            <li style="padding:.25rem 0;">• Performance Review &amp; KPI Dashboard</li>
                            <li style="padding:.25rem 0;">• Process Refinement Recommendations</li>
                            <li style="padding:.25rem 0;">• Ongoing Improvement Framework</li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- WHY THIS WORKS -->
    <section class="aurum-section aurum-cream-bg" id="why-works">
        <div class="container text-center">
            <span class="aurum-eyebrow aurum-reveal">WHY THIS APPROACH</span>
            <h2 class="aurum-h aurum-reveal">Built for Results, Designed for Speed</h2>
            <div class="aurum-divider"/>

            <div class="row g-4 mt-4">
                <div class="col-md-4 aurum-reveal">
                    <div class="aurum-pillar aurum-sheen" style="background:#fff;color:#0b1f3f;">
                        <h5 style="color:#0b1f3f;">Rapid Results</h5>
                        <p class="small mb-0" style="color:#4a5568;">
                            12-week sprints deliver measurable impact fast, without the
                            endless consulting cycles.
                        </p>
                    </div>
                </div>
                <div class="col-md-4 aurum-reveal" data-aurum-delay="1">
                    <div class="aurum-pillar aurum-sheen" style="background:#fff;color:#0b1f3f;">
                        <h5 style="color:#0b1f3f;">Expert-Led</h5>
                        <p class="small mb-0" style="color:#4a5568;">
                            Every engagement is led by seasoned operators who have built and
                            scaled businesses.
                        </p>
                    </div>
                </div>
                <div class="col-md-4 aurum-reveal" data-aurum-delay="2">
                    <div class="aurum-pillar aurum-sheen" style="background:#fff;color:#0b1f3f;">
                        <h5 style="color:#0b1f3f;">Proven Process</h5>
                        <p class="small mb-0" style="color:#4a5568;">
                            Our methodology has been refined across 200+ engagements in 6
                            industries.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="aurum-section">
        <div class="container">
            <div class="aurum-cta aurum-reveal">
                <span class="aurum-eyebrow">Clarity. Control. Confidence.</span>
                <h2 class="aurum-h mb-3">Ready to transform?</h2>
                <a href="/contact-us" class="btn btn-aurum-gold" aria-label="Start your transformation journey">Start the Conversation</a>
            </div>
        </div>
    </section>

</div>
</t>
</template>

</odoo>
