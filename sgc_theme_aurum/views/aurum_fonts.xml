<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="aurum_google_fonts" name="Aurum Google Fonts" inherit_id="website.layout" priority="10">
        <xpath expr="//link[@rel='preconnect' and contains(@href, 'fonts.gstatic.com')]" position="after">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&amp;family=Inter:wght@400;500;600;700&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
