<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Layout with Aurum-branded footer pulling from company settings -->
<template id="aurum_layout" name="Aurum Layout" inherit_id="web.frontend_layout" priority="100">
        <xpath expr="//footer[@id='bottom']" position="replace">
            <footer t-if="not no_footer" id="bottom" data-anchor="true" t-attf-class="bg-light o_footer aurum-footer" role="contentinfo">
                <div class="container">
                    <div class="row g-4">
                        <!-- Company Info -->
                        <div class="col-lg-4 col-md-6">
                            <h5 class="mb-3" style="font-family:'Playfair Display',serif;font-weight:700;color:var(--aurum-gold-light);">
                                <t t-out="res_company.name or ''"/>
                            </h5>
                            <p class="mb-2" style="color:rgba(255,255,255,.78);font-size:.95rem;line-height:1.7;">
                                <t t-out="res_company.partner_id.street or ''"/>
                                <br/>
                                <t t-out="res_company.partner_id.street2 or ''"/>
                                <br/>
                                <t t-out="res_company.partner_id.city or ''"/>, 
                                <t t-out="res_company.partner_id.country_id.name or ''"/>
                            </p>
                        </div>

                        <!-- Contact Links -->
                        <div class="col-lg-3 col-md-6">
                            <h6 class="mb-3" style="font-family:'Playfair Display',serif;font-weight:700;color:var(--aurum-gold-light);text-transform:uppercase;letter-spacing:.06em;font-size:.75rem;">Contact</h6>
                            <ul class="list-unstyled mb-0" style="line-height:2.2;">
                                <li>
                                    <a t-attf-href="mailto:{{ res_company.email or '' }}" style="color:rgba(255,255,255,.78);text-decoration:none;transition:color .2s;" title="Email us">
                                        <t t-out="res_company.email or ''"/>
                                    </a>
                                </li>
                                <li>
                                    <a t-attf-href="tel:{{ res_company.phone or '' }}" style="color:rgba(255,255,255,.78);text-decoration:none;transition:color .2s;" title="Call us">
                                        <t t-out="res_company.phone or ''"/>
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Quick Links -->
                        <div class="col-lg-3 col-md-6">
                            <h6 class="mb-3" style="font-family:'Playfair Display',serif;font-weight:700;color:var(--aurum-gold-light);text-transform:uppercase;letter-spacing:.06em;font-size:.75rem;">Quick Links</h6>
                            <ul class="list-unstyled mb-0" style="line-height:2.2;">
                                <li><a href="/about-us" style="color:rgba(255,255,255,.78);text-decoration:none;transition:color .2s;">About Us</a></li>
                                <li><a href="/services" style="color:rgba(255,255,255,.78);text-decoration:none;transition:color .2s;">Services</a></li>
                                <li><a href="/our-industries" style="color:rgba(255,255,255,.78);text-decoration:none;transition:color .2s;">Industries</a></li>
                                <li><a href="/contact-us" style="color:rgba(255,255,255,.78);text-decoration:none;transition:color .2s;">Contact</a></li>
                            </ul>
                        </div>

                        <!-- Social / Legal -->
                        <div class="col-lg-2 col-md-6">
                            <h6 class="mb-3" style="font-family:'Playfair Display',serif;font-weight:700;color:var(--aurum-gold-light);text-transform:uppercase;letter-spacing:.06em;font-size:.75rem;">Follow Us</h6>
                            <div class="d-flex gap-2 mb-3">
                                <t t-if="website.social_linkedin">
                                    <a t-attf-href="{{ website.social_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;display:flex;align-items:center;justify-content:center;transition:all .2s;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                                    </a>
                                </t>
                                <t t-if="website.social_twitter">
                                    <a t-attf-href="{{ website.social_twitter }}" target="_blank" rel="noopener" aria-label="Twitter" style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;display:flex;align-items:center;justify-content:center;transition:all .2s;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                                    </a>
                                </t>
                                <t t-if="website.social_facebook">
                                    <a t-attf-href="{{ website.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook" style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;display:flex;align-items:center;justify-content:center;transition:all .2s;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                                    </a>
                                </t>
                                <t t-if="website.social_instagram">
                                    <a t-attf-href="{{ website.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram" style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;display:flex;align-items:center;justify-content:center;transition:all .2s;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.98-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4s1.791-4 4-4 4 1.791 4 4-1.79 4-4 4z"/></svg>
                                    </a>
                                </t>
                                <t t-if="website.social_youtube">
                                    <a t-attf-href="{{ website.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube" style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;display:flex;align-items:center;justify-content:center;transition:all .2s;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.186 3.186 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.185 3.185 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.185 3.185 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.186 3.186 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM10 15.167V8.833L15.817 12 10 15.167z"/></svg>
                                    </a>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Copyright Bar -->
                    <hr style="border-color:rgba(255,255,255,.1);margin:2rem 0 1.5rem;"/>
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <p class="mb-0 small" style="color:rgba(255,255,255,.65);">
                                &#169; <t t-out="datetime.datetime.now().year"/> <t t-out="res_company.name or ''"/>. All rights reserved.
                            </p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="/privacy" style="color:rgba(255,255,255,.65);text-decoration:none;margin-right:1.5rem;font-size:.85rem;">Privacy Policy</a>
                            <a href="/terms" style="color:rgba(255,255,255,.65);text-decoration:none;font-size:.85rem;">Terms of Service</a>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>

    <!-- Page-aware title and meta description.
         Each page can set <t t-set="title"> and <t t-set="meta_description">
         before calling website.layout. Falls back to site defaults. -->
    <template id="aurum_title_replace" name="Aurum Title Replace" inherit_id="web.frontend_layout">
        <xpath expr="//head/title" position="replace">
            <title t-esc="title or (request and request.website and request.website.name) or 'SGC Tech'"/>
        </xpath>
    </template>

    <template id="aurum_meta_replace" name="Aurum Meta Description Replace" inherit_id="website.layout">
        <xpath expr="//head/meta[@name='description']" position="replace">
            <t t-set="_default_meta" t-value="'SGC Tech delivers integrated CFO advisory, compliance and technology services for ambitious UAE businesses. Operator-led, outcome-focused.'"/>
            <meta name="description" t-att-content="meta_description or _default_meta"/>
        </xpath>
    </template>

    <template id="aurum_og_replace" name="Aurum OG Tags" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <t t-set="_default_meta" t-value="'SGC Tech delivers integrated CFO advisory, compliance and technology services for ambitious UAE businesses. Operator-led, outcome-focused.'"/>
            <meta property="og:title" t-att-content="title or 'SGC Tech'"/>
            <meta property="og:description" t-att-content="meta_description or _default_meta"/>
            <meta property="og:type" content="website"/>
            <meta property="og:site_name" content="SGC Tech"/>
            <meta property="og:locale" content="en_AE"/>
        </xpath>
    </template>
    <template id="aurum_twitter_replace" name="Aurum Twitter Tags" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <t t-set="_default_meta" t-value="'SGC Tech delivers integrated CFO advisory, compliance and technology services for ambitious UAE businesses. Operator-led, outcome-focused.'"/>
            <meta name="twitter:card" content="summary_large_image"/>
            <meta name="twitter:title" t-att-content="title or 'SGC Tech'"/>
            <meta name="twitter:description" t-att-content="meta_description or _default_meta"/>
        </xpath>
    </template>

    <!-- JSON-LD structured data: Organization + WebSite -->
    <template id="aurum_jsonld" name="Aurum JSON-LD" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "Organization",
                        "@id": "https://sgctech.ai/#organization",
                        "name": "SGC Tech",
                        "url": "https://sgctech.ai",
                        "sameAs": [
                            "https://www.linkedin.com/company/sgctech",
                            "https://twitter.com/sgctech"
                        ],
                        "contactPoint": {
                            "@type": "ContactPoint",
                            "contactType": "sales",
                            "areaServed": "AE",
                            "availableLanguage": ["English"]
                        }
                    },
                    {
                        "@type": "WebSite",
                        "@id": "https://sgctech.ai/#website",
                        "url": "https://sgctech.ai",
                        "name": "SGC Tech",
                        "publisher": {
                            "@id": "https://sgctech.ai/#organization"
                        }
                    }
                ]
            }
            </script>
        </xpath>
    </template>
</odoo>