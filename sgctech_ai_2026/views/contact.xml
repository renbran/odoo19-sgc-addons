<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="sgctech_contact_2026" name="SGC Contact 2026">
    <t t-call="website.layout">
      <t t-set="no_footer" t-value="False"/>

      <section class="sgc26-page-hero">
        <div class="sgc26-page-hero__inner" data-sgc-reveal="1">
          <p class="sgc26-label">Get in Touch</p>
          <h1 class="sgc26-page-hero-title sgc26-h1">Start Your ERP Journey</h1>
          <p class="sgc26-body-lg" style="text-align:center;max-width:520px">
            Book a discovery call, ask a question, or request a package proposal.
            We respond to every enquiry within one business day.
          </p>
        </div>
      </section>

      <!-- Contact layout -->
      <section class="sgc26-section">
        <div class="sgc26-container">
          <div class="sgc26-grid-2" style="gap:5rem;align-items:start">

            <!-- Left: form -->
            <div>
              <form id="sgc26-contact-form" method="post" action="/web/dataset/call_kw">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="form_type" value="contact_2026"/>

                <div style="display:flex;flex-direction:column;gap:1.5rem">

                  <!-- Name -->
                  <div>
                    <label style="display:block;font-size:0.875rem;font-weight:600;color:var(--t2);margin-bottom:0.5rem" for="sgc26-name">Full Name</label>
                    <input id="sgc26-name" name="contact_name" type="text"
                           class="sgc26-footer__email-input" style="width:100%;border-radius:var(--r-md)"
                           placeholder="Your full name"
                           data-sgc-required="true" autocomplete="name"/>
                  </div>

                  <!-- Email -->
                  <div>
                    <label style="display:block;font-size:0.875rem;font-weight:600;color:var(--t2);margin-bottom:0.5rem" for="sgc26-email">Business Email</label>
                    <input id="sgc26-email" name="email_from" type="email"
                           class="sgc26-footer__email-input" style="width:100%;border-radius:var(--r-md)"
                           placeholder="you@company.com"
                           data-sgc-required="true" autocomplete="email"/>
                  </div>

                  <!-- Company -->
                  <div>
                    <label style="display:block;font-size:0.875rem;font-weight:600;color:var(--t2);margin-bottom:0.5rem" for="sgc26-company">Company Name</label>
                    <input id="sgc26-company" name="partner_name" type="text"
                           class="sgc26-footer__email-input" style="width:100%;border-radius:var(--r-md)"
                           placeholder="Your company" autocomplete="organization"/>
                  </div>

                  <!-- Industry -->
                  <div>
                    <label style="display:block;font-size:0.875rem;font-weight:600;color:var(--t2);margin-bottom:0.5rem" for="sgc26-industry">Industry</label>
                    <select id="sgc26-industry" name="industry"
                            class="sgc26-footer__email-input" style="width:100%;border-radius:var(--r-md)">
                      <option value="">Select your industry</option>
                      <option value="real_estate">Real Estate</option>
                      <option value="construction">Construction</option>
                      <option value="trading">Trading &amp; Distribution</option>
                      <option value="retail">Retail</option>
                      <option value="hospitality">Hospitality</option>
                      <option value="other">Other</option>
                    </select>
                  </div>

                  <!-- Package interest -->
                  <div>
                    <label style="display:block;font-size:0.875rem;font-weight:600;color:var(--t2);margin-bottom:0.5rem" for="sgc26-package">Package Interest</label>
                    <select id="sgc26-package" name="package_interest"
                            class="sgc26-footer__email-input" style="width:100%;border-radius:var(--r-md)">
                      <option value="">Select a package</option>
                      <option value="core">Core — Accounting + Inventory</option>
                      <option value="growth">Growth — Full Business Suite</option>
                      <option value="enterprise">Enterprise — Industry + AI</option>
                      <option value="retainer">Support Retainer</option>
                      <option value="not_sure">Not sure yet</option>
                    </select>
                  </div>

                  <!-- Message -->
                  <div>
                    <label style="display:block;font-size:0.875rem;font-weight:600;color:var(--t2);margin-bottom:0.5rem" for="sgc26-message">Message</label>
                    <textarea id="sgc26-message" name="description" rows="5"
                              class="sgc26-footer__email-input" style="width:100%;border-radius:var(--r-md);resize:vertical"
                              placeholder="Tell us about your current systems and what you want to achieve."
                              data-sgc-required="true"/>
                  </div>

                  <!-- Submit -->
                  <button type="submit" class="sgc26-btn sgc26-btn-primary sgc26-btn-lg" style="align-self:flex-start">
                    Send Enquiry
                    <svg width="18" height="18"><use href="#i-arrow-right"/></svg>
                  </button>

                  <p class="sgc26-body-sm">
                    We respond within one UAE business day.
                    Your information is not shared with third parties.
                  </p>
                </div>
              </form>
            </div>

            <!-- Right: contact info + paths -->
            <div style="display:flex;flex-direction:column;gap:2rem">

              <!-- Direct contact -->
              <div class="sgc26-card">
                <h3 class="sgc26-h4" style="margin-bottom:1.25rem">Direct Contact</h3>
                <div style="display:flex;flex-direction:column;gap:1rem">
                  <a href="mailto:hello@sgctech.ai" style="display:flex;align-items:center;gap:0.75rem;color:var(--t2);font-size:0.9rem">
                    <svg width="18" height="18" style="color:var(--cyan);flex-shrink:0"><use href="#i-mail"/></svg>
                    hello@sgctech.ai
                  </a>
                  <a href="https://maps.google.com/?q=Dubai+UAE" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:0.75rem;color:var(--t2);font-size:0.9rem">
                    <svg width="18" height="18" style="color:var(--cyan);flex-shrink:0"><use href="#i-map-pin"/></svg>
                    Dubai, UAE
                  </a>
                  <a href="https://sgctech.ai" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:0.75rem;color:var(--t2);font-size:0.9rem">
                    <svg width="18" height="18" style="color:var(--cyan);flex-shrink:0"><use href="#i-globe"/></svg>
                    sgctech.ai
                  </a>
                </div>
              </div>

              <!-- Engagement paths -->
              <div class="sgc26-card">
                <h3 class="sgc26-h4" style="margin-bottom:1.25rem">Engagement Paths</h3>
                <div style="display:flex;flex-direction:column;gap:1rem">
                  <div style="display:flex;align-items:flex-start;gap:0.75rem">
                    <div style="width:32px;height:32px;background:var(--grad-brand);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                      <svg width="16" height="16" style="color:white"><use href="#i-clock"/></svg>
                    </div>
                    <div>
                      <p style="font-weight:600;font-size:0.9rem;color:var(--t1);margin-bottom:0.25rem">30-Min Discovery Call</p>
                      <p class="sgc26-body-sm">Assess your requirements and outline a delivery approach.</p>
                    </div>
                  </div>
                  <div style="display:flex;align-items:flex-start;gap:0.75rem">
                    <div style="width:32px;height:32px;background:var(--grad-brand);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                      <svg width="16" height="16" style="color:white"><use href="#i-bar-chart"/></svg>
                    </div>
                    <div>
                      <p style="font-weight:600;font-size:0.9rem;color:var(--t1);margin-bottom:0.25rem">Package Proposal</p>
                      <p class="sgc26-body-sm">Detailed scope, timeline, and fixed-price quote for your project.</p>
                    </div>
                  </div>
                  <div style="display:flex;align-items:flex-start;gap:0.75rem">
                    <div style="width:32px;height:32px;background:var(--grad-brand);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                      <svg width="16" height="16" style="color:white"><use href="#i-info"/></svg>
                    </div>
                    <div>
                      <p style="font-weight:600;font-size:0.9rem;color:var(--t1);margin-bottom:0.25rem">Compliance Briefing</p>
                      <p class="sgc26-body-sm">Walk through UAE regulatory requirements and how our ERP covers them.</p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Response SLA -->
              <div class="sgc26-compliance-card sgc26-compliance-card--pass">
                <p class="sgc26-body-sm">
                  <strong style="color:var(--t1)">Response guarantee:</strong>
                  Every enquiry receives a substantive reply within one UAE business day.
                  No automated responses, no offshore call centres.
                </p>
              </div>
            </div>

          </div>
        </div>
      </section>

    </t>
  </template>

</odoo>
