<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ══════════════════════════════════════════════════════════
       Guard class + Google Fonts + meta on #wrapwrap
       ══════════════════════════════════════════════════════════ -->
  <template id="sgc26_body_class" inherit_id="website.layout" name="SGC 2026 Body Class">
    <xpath expr="//div[@id='wrapwrap']" position="attributes">
      <attribute name="t-attf-class" add="sgc-v26" separator=" "/>
    </xpath>
  </template>

  <!-- ── Google Fonts + OG meta ───────────────────────────── -->
  <template id="sgc26_meta" inherit_id="website.layout" name="SGC 2026 Meta">
    <xpath expr="//head" position="inside">
      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@300;400;500;600;700&amp;family=Share+Tech+Mono&amp;display=swap"/>
      <meta property="og:image" content="/website_sgctech_ai/static/src/img/og_image.png"/>
    </xpath>
  </template>

  <!-- ══════════════════════════════════════════════════════════
       SVG icon symbol definitions (injected once into body)
       ══════════════════════════════════════════════════════════ -->
  <template id="sgc26_icon_defs" inherit_id="website.layout" name="SGC 2026 Icon Defs">
    <xpath expr="//body" position="inside">
      <svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
        <defs>
          <!-- Brand gradient used on icon strokes -->
          <linearGradient id="sgc26-grad-icon" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"   stop-color="#00D4FF"/>
            <stop offset="100%" stop-color="#7B2FBE"/>
          </linearGradient>

          <!-- i-check -->
          <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </symbol>
          <!-- i-x -->
          <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </symbol>
          <!-- i-arrow-right -->
          <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </symbol>
          <!-- i-zap -->
          <symbol id="i-zap" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </symbol>
          <!-- i-shield -->
          <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </symbol>
          <!-- i-globe -->
          <symbol id="i-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </symbol>
          <!-- i-users -->
          <symbol id="i-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </symbol>
          <!-- i-cpu -->
          <symbol id="i-cpu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="6" height="6"/>
            <path d="M15 9V5h-2M9 9V5h2M15 15v4h-2M9 15v4h2M21 15h-4v-2M3 15h4v-2M21 9h-4v2M3 9h4v2"/>
            <rect x="2" y="2" width="20" height="20" rx="2" ry="2"/>
          </symbol>
          <!-- i-trending-up -->
          <symbol id="i-trending-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
          </symbol>
          <!-- i-bar-chart -->
          <symbol id="i-bar-chart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"/>
            <line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6"  y1="20" x2="6"  y2="14"/>
          </symbol>
          <!-- i-layers -->
          <symbol id="i-layers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"/>
            <polyline points="2 17 12 22 22 17"/>
            <polyline points="2 12 12 17 22 12"/>
          </symbol>
          <!-- i-settings -->
          <symbol id="i-settings" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </symbol>
          <!-- i-clock -->
          <symbol id="i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </symbol>
          <!-- i-map-pin -->
          <symbol id="i-map-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </symbol>
          <!-- i-mail -->
          <symbol id="i-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </symbol>
          <!-- i-phone -->
          <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </symbol>
          <!-- i-building -->
          <symbol id="i-building" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="18"/>
            <path d="M16 8h4l3 3v10h-7V8z"/>
            <line x1="5" y1="8"  x2="8" y2="8"/>
            <line x1="5" y1="12" x2="8" y2="12"/>
            <line x1="5" y1="16" x2="8" y2="16"/>
          </symbol>
          <!-- i-truck -->
          <symbol id="i-truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
            <circle cx="5.5"  cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </symbol>
          <!-- i-home -->
          <symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </symbol>
          <!-- i-shopping-cart -->
          <symbol id="i-shopping-cart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9"  cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </symbol>
          <!-- i-utensils -->
          <symbol id="i-utensils" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="2"  x2="3"  y2="22"/>
            <path d="M9 2v3l.5 1.5L9 8v14"/>
            <path d="M12 2a5 5 0 0 1 5 5v3H7V7a5 5 0 0 1 5-5z"/>
          </symbol>
          <!-- i-info -->
          <symbol id="i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8"  x2="12.01" y2="8"/>
          </symbol>
          <!-- i-alert-triangle -->
          <symbol id="i-alert-triangle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9"  x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </symbol>
          <!-- i-star -->
          <symbol id="i-star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </symbol>
          <!-- i-linkedin -->
          <symbol id="i-linkedin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </symbol>
          <!-- i-twitter -->
          <symbol id="i-twitter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
          </symbol>
        </defs>
      </svg>
    </xpath>
  </template>

  <!-- ══════════════════════════════════════════════════════════
       Animated mesh background div
       ══════════════════════════════════════════════════════════ -->
  <template id="sgc26_mesh_bg" inherit_id="website.layout" name="SGC 2026 Mesh Background">
    <xpath expr="//div[@id='wrapwrap']" position="inside">
      <div class="sgc26-mesh-bg" aria-hidden="true"/>
    </xpath>
  </template>

  <!-- ══════════════════════════════════════════════════════════
       Navigation bar
       ══════════════════════════════════════════════════════════ -->
  <template id="sgc26_nav" inherit_id="website.layout" name="SGC 2026 Nav">
    <xpath expr="//div[@id='wrapwrap']" position="inside">
      <nav class="sgc26-nav" aria-label="Main navigation">
        <div class="sgc26-nav__inner">
          <a href="/" class="sgc26-nav__logo">
            <div class="sgc26-nav__logo-mark">S</div>
            <span class="sgc26-nav__logo-text">SGC <span>TECH AI</span></span>
          </a>
          <ul class="sgc26-nav__links">
            <li><a href="/sgctech/home">Home</a></li>
            <li><a href="/sgctech/industries">Industries</a></li>
            <li><a href="/sgctech/how-we-work">How We Work</a></li>
            <li><a href="/sgctech/pricing">Pricing</a></li>
            <li><a href="/sgctech/compliance">Compliance</a></li>
            <li><a href="/sgctech/about">About</a></li>
          </ul>
          <div class="sgc26-nav__cta">
            <a href="/sgctech/contact" class="sgc26-btn sgc26-btn-primary sgc26-btn-sm">
              Book Discovery Call
              <svg width="14" height="14"><use href="#i-arrow-right"/></svg>
            </a>
          </div>
          <button class="sgc26-nav__hamburger" aria-label="Open menu" aria-expanded="false">
            <span/><span/><span/>
          </button>
        </div>
      </nav>

      <!-- Mobile nav overlay -->
      <div class="sgc26-nav__mobile" role="dialog" aria-label="Mobile menu">
        <a href="/sgctech/home">Home</a>
        <a href="/sgctech/industries">Industries</a>
        <a href="/sgctech/how-we-work">How We Work</a>
        <a href="/sgctech/pricing">Pricing</a>
        <a href="/sgctech/compliance">Compliance</a>
        <a href="/sgctech/about">About</a>
        <a href="/sgctech/contact" class="sgc26-btn sgc26-btn-primary" style="margin-top:1rem">Book Discovery Call</a>
      </div>
    </xpath>
  </template>

  <!-- ══════════════════════════════════════════════════════════
       Footer — replaces default Odoo footer
       ══════════════════════════════════════════════════════════ -->
  <template id="sgc26_footer" inherit_id="website.layout" name="SGC 2026 Footer">
    <xpath expr="//div[@id='footer']" position="replace">
      <footer id="footer" class="sgc26-footer oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
        <div class="sgc26-container">
          <div class="sgc26-footer__grid">
            <!-- Brand column -->
            <div>
              <div class="sgc26-footer__brand-name">
                SGC <span class="sgc26-gradient-text">TECH AI</span>
              </div>
              <p class="sgc26-footer__tagline">
                AI-powered ERP for real estate, construction, trading and retail in UAE.
                Structured delivery. Expert support.
              </p>
              <div style="display:flex;gap:0.75rem;margin-top:1rem">
                <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn"
                   class="sgc26-btn sgc26-btn-outline sgc26-btn-icon">
                  <svg width="18" height="18"><use href="#i-linkedin"/></svg>
                </a>
                <a href="https://twitter.com/SGCTECHAI" target="_blank" rel="noopener" aria-label="Twitter"
                   class="sgc26-btn sgc26-btn-outline sgc26-btn-icon">
                  <svg width="18" height="18"><use href="#i-twitter"/></svg>
                </a>
                <a href="mailto:hello@sgctech.ai" aria-label="Email"
                   class="sgc26-btn sgc26-btn-outline sgc26-btn-icon">
                  <svg width="18" height="18"><use href="#i-mail"/></svg>
                </a>
              </div>
            </div>
            <!-- Links column -->
            <div>
              <p class="sgc26-footer__col-title">Pages</p>
              <ul class="sgc26-footer__links">
                <li><a href="/sgctech/industries">Industries</a></li>
                <li><a href="/sgctech/how-we-work">How We Work</a></li>
                <li><a href="/sgctech/pricing">Pricing</a></li>
                <li><a href="/sgctech/compliance">Compliance</a></li>
                <li><a href="/sgctech/about">About</a></li>
                <li><a href="/sgctech/contact">Contact</a></li>
                <li><a href="/shop">Packages</a></li>
              </ul>
            </div>
            <!-- Contact column -->
            <div>
              <p class="sgc26-footer__col-title">Contact</p>
              <ul class="sgc26-footer__links">
                <li>
                  <a href="mailto:hello@sgctech.ai">
                    <svg width="14" height="14" style="display:inline;margin-right:6px"><use href="#i-mail"/></svg>
                    hello@sgctech.ai
                  </a>
                </li>
                <li>
                  <a href="https://maps.google.com/?q=Dubai+UAE" target="_blank" rel="noopener">
                    <svg width="14" height="14" style="display:inline;margin-right:6px"><use href="#i-map-pin"/></svg>
                    Dubai, UAE
                  </a>
                </li>
                <li>
                  <a href="https://sgctech.ai" target="_blank" rel="noopener">
                    <svg width="14" height="14" style="display:inline;margin-right:6px"><use href="#i-globe"/></svg>
                    sgctech.ai
                  </a>
                </li>
              </ul>
              <p class="sgc26-footer__col-title" style="margin-top:2rem">Stay Updated</p>
              <form class="sgc26-footer__email-form" onsubmit="return false;">
                <input type="email" class="sgc26-footer__email-input" placeholder="your@email.com" aria-label="Email address"/>
                <button type="submit" class="sgc26-btn sgc26-btn-primary sgc26-btn-sm">
                  <svg width="14" height="14"><use href="#i-arrow-right"/></svg>
                </button>
              </form>
            </div>
          </div>
          <div class="sgc26-footer__legal">
            <p>&#169; <t t-esc="request.website.sudo().name or 'SGC TECH AI'"/> &#8212; Scholarix Global Consultants. All rights reserved. UAE VAT registered.</p>
            <p style="margin-top:0.5rem;font-family:var(--font-mono);font-size:0.72rem">
              Powered by <span class="sgc26-gradient-text" style="font-weight:700">SGC Tech AI</span>
            </p>
          </div>
        </div>
      </footer>
    </xpath>
  </template>

</odoo>
