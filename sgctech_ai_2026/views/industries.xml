<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="sgctech_industries_2026" name="SGC Industries 2026">
    <t t-call="website.layout">
      <t t-set="no_footer" t-value="False"/>

      <section class="sgc26-page-hero">
        <div class="sgc26-page-hero__inner" data-sgc-reveal="1">
          <p class="sgc26-label">Industry Verticals</p>
          <h1 class="sgc26-page-hero-title sgc26-h1">Built for Your Sector</h1>
          <p class="sgc26-body-lg" style="text-align:center;max-width:580px">
            Pre-configured ERP modules with UAE-specific workflows, terminology, and compliance built in — not added later.
          </p>
        </div>
      </section>

      <!-- Real Estate — Featured -->
      <section class="sgc26-section">
        <div class="sgc26-container">
          <div class="sgc26-industry-featured" data-sgc-reveal="1">
            <div>
              <span class="sgc26-tier-badge sgc26-tier-badge--enterprise" style="margin-bottom:1rem">Most Requested</span>
              <p class="sgc26-label">Real Estate</p>
              <h2 class="sgc26-h2" style="margin-bottom:1rem">Property Management ERP</h2>
              <p class="sgc26-body" style="margin-bottom:1.5rem">
                End-to-end management for residential, commercial, and mixed-use portfolios.
                RERA-aware workflows, multi-currency leasing, and service charge accounting — all in one system.
              </p>
              <ul class="sgc26-check-list sgc26-check-list--pass" style="margin-bottom:2rem">
                <li><svg width="16" height="16"><use href="#i-check"/></svg> Lease contract lifecycle management</li>
                <li><svg width="16" height="16"><use href="#i-check"/></svg> Tenancy renewal reminders and notices</li>
                <li><svg width="16" height="16"><use href="#i-check"/></svg> Maintenance request tracking with SLA</li>
                <li><svg width="16" height="16"><use href="#i-check"/></svg> Owner and tenant portal (self-service)</li>
                <li><svg width="16" height="16"><use href="#i-check"/></svg> Service charge collection and reconciliation</li>
                <li><svg width="16" height="16"><use href="#i-check"/></svg> Cheque-based payment scheduling</li>
              </ul>
              <a href="/sgctech/contact?vertical=real-estate" class="sgc26-btn sgc26-btn-primary">
                Start Real Estate Project
                <svg width="16" height="16"><use href="#i-arrow-right"/></svg>
              </a>
            </div>
            <div style="display:flex;flex-direction:column;gap:1rem">
              <div class="sgc26-kpi-tile">
                <div class="sgc26-kpi-number">UAE</div>
                <div class="sgc26-kpi-tile__label">RERA-Aware</div>
              </div>
              <div class="sgc26-kpi-tile">
                <div class="sgc26-kpi-number">Multi</div>
                <div class="sgc26-kpi-tile__label">Currency Leasing</div>
              </div>
              <div class="sgc26-kpi-tile">
                <div class="sgc26-kpi-number">360°</div>
                <div class="sgc26-kpi-tile__label">Portfolio View</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Grid: Construction, Trading, Retail, Hospitality -->
      <section class="sgc26-section" style="background:var(--bg-2)">
        <div class="sgc26-container">
          <div class="sgc26-section-title" data-sgc-reveal="1">
            <p class="sgc26-label">More Verticals</p>
            <h2 class="sgc26-h2">Every Sector Has a Pre-Built Start</h2>
          </div>

          <div class="sgc26-industry-grid">

            <div class="sgc26-industry-card" data-accent="violet" data-sgc-reveal="1" data-sgc-delay="100" data-sgc-tilt="1">
              <div class="sgc26-industry-card__header">
                <div class="sgc26-industry-card__icon">
                  <svg width="26" height="26"><use href="#i-layers" stroke="url(#sgc26-grad-icon)"/></svg>
                </div>
                <div class="sgc26-industry-card__title">Construction</div>
                <div class="sgc26-industry-card__tagline">Project costing, BOQ management, subcontractor billing</div>
              </div>
              <div class="sgc26-industry-card__body">
                <ul class="sgc26-industry-card__modules">
                  <li>Project budget vs actual tracking</li>
                  <li>Bill of Quantities (BOQ) sheets</li>
                  <li>Subcontractor retention management</li>
                  <li>Progress billing milestones</li>
                  <li>Material procurement and costing</li>
                </ul>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.75rem">
                  <span class="sgc26-tier-badge sgc26-tier-badge--core">Core</span>
                  <span class="sgc26-tier-badge sgc26-tier-badge--growth">Growth</span>
                  <span class="sgc26-tier-badge sgc26-tier-badge--enterprise">Enterprise</span>
                </div>
              </div>
            </div>

            <div class="sgc26-industry-card" data-accent="emerald" data-sgc-reveal="1" data-sgc-delay="200" data-sgc-tilt="1">
              <div class="sgc26-industry-card__header">
                <div class="sgc26-industry-card__icon">
                  <svg width="26" height="26"><use href="#i-truck" stroke="url(#sgc26-grad-icon)"/></svg>
                </div>
                <div class="sgc26-industry-card__title">Trading &amp; Distribution</div>
                <div class="sgc26-industry-card__tagline">Multi-warehouse, landed costs, import/export</div>
              </div>
              <div class="sgc26-industry-card__body">
                <ul class="sgc26-industry-card__modules">
                  <li>Multi-currency purchasing</li>
                  <li>Landed cost allocation</li>
                  <li>Batch, serial, and lot tracking</li>
                  <li>Customer-specific price lists</li>
                  <li>Cross-docking workflows</li>
                </ul>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.75rem">
                  <span class="sgc26-tier-badge sgc26-tier-badge--core">Core</span>
                  <span class="sgc26-tier-badge sgc26-tier-badge--growth">Growth</span>
                </div>
              </div>
            </div>

            <div class="sgc26-industry-card" data-accent="amber" data-sgc-reveal="1" data-sgc-delay="300" data-sgc-tilt="1">
              <div class="sgc26-industry-card__header">
                <div class="sgc26-industry-card__icon">
                  <svg width="26" height="26"><use href="#i-shopping-cart" stroke="url(#sgc26-grad-icon)"/></svg>
                </div>
                <div class="sgc26-industry-card__title">Retail</div>
                <div class="sgc26-industry-card__tagline">POS, multi-store inventory, loyalty programs</div>
              </div>
              <div class="sgc26-industry-card__body">
                <ul class="sgc26-industry-card__modules">
                  <li>Point of Sale (POS) configuration</li>
                  <li>Multi-store stock management</li>
                  <li>Loyalty &amp; gift card programs</li>
                  <li>eCommerce integration</li>
                  <li>Daily Z-report reconciliation</li>
                </ul>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.75rem">
                  <span class="sgc26-tier-badge sgc26-tier-badge--core">Core</span>
                  <span class="sgc26-tier-badge sgc26-tier-badge--growth">Growth</span>
                </div>
              </div>
            </div>

            <div class="sgc26-industry-card" data-accent="cyan" data-sgc-reveal="1" data-sgc-delay="100" data-sgc-tilt="1">
              <div class="sgc26-industry-card__header">
                <div class="sgc26-industry-card__icon">
                  <svg width="26" height="26"><use href="#i-utensils" stroke="url(#sgc26-grad-icon)"/></svg>
                </div>
                <div class="sgc26-industry-card__title">Hospitality</div>
                <div class="sgc26-industry-card__tagline">F&amp;B cost control, hotel operations, reservations</div>
              </div>
              <div class="sgc26-industry-card__body">
                <ul class="sgc26-industry-card__modules">
                  <li>Recipe costing and menu management</li>
                  <li>Reservation and room management</li>
                  <li>F&amp;B inventory control</li>
                  <li>Staff scheduling and payroll</li>
                  <li>Supplier invoice matching</li>
                </ul>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.75rem">
                  <span class="sgc26-tier-badge sgc26-tier-badge--growth">Growth</span>
                  <span class="sgc26-tier-badge sgc26-tier-badge--enterprise">Enterprise</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="sgc26-section">
        <div class="sgc26-container" style="text-align:center">
          <div data-sgc-reveal="1">
            <h2 class="sgc26-h2" style="margin-bottom:1rem">Your Industry. Your Workflow.</h2>
            <p class="sgc26-body-lg" style="max-width:520px;margin:0 auto 2rem">
              Tell us your vertical and current systems — we'll map a configuration that fits from day one.
            </p>
            <a href="/sgctech/contact" class="sgc26-btn sgc26-btn-primary sgc26-btn-lg">
              Book Industry Consultation
              <svg width="18" height="18"><use href="#i-arrow-right"/></svg>
            </a>
          </div>
        </div>
      </section>

    </t>
  </template>

</odoo>
