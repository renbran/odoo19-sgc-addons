<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="sgctech_about_2026" name="SGC About 2026">
    <t t-call="website.layout">
      <t t-set="no_footer" t-value="False"/>

      <section class="sgc26-page-hero">
        <div class="sgc26-page-hero__inner" data-sgc-reveal="1">
          <p class="sgc26-label">About SGC Tech AI</p>
          <h1 class="sgc26-page-hero-title sgc26-h1">Who We Are</h1>
          <p class="sgc26-body-lg" style="text-align:center;max-width:580px">
            Scholarix Global Consultants — UAE-based AI-powered ERP partner
            for businesses that need structured implementation, not just software installation.
          </p>
        </div>
      </section>

      <!-- Mission -->
      <section class="sgc26-section">
        <div class="sgc26-container">
          <div class="sgc26-grid-2" style="align-items:center;gap:5rem" data-sgc-reveal="1">
            <div>
              <p class="sgc26-label">Our Mission</p>
              <h2 class="sgc26-h2" style="margin-bottom:1.25rem">
                ERP That Runs on Day One, <span class="sgc26-gradient-text">Not Month Three</span>
              </h2>
              <p class="sgc26-body" style="margin-bottom:1rem">
                Most ERP projects fail not because the software is wrong, but because implementation
                is underscoped, rushed, or handed to people who have never run the business workflows
                they are configuring.
              </p>
              <p class="sgc26-body">
                SGC Tech AI exists to close that gap — with structured methodology, UAE-specific
                domain knowledge, and AI tools that accelerate without cutting corners.
              </p>
            </div>
            <div>
              <div class="sgc26-grid-2" style="gap:1rem">
                <div class="sgc26-kpi-tile">
                  <div class="sgc26-kpi-number">UAE</div>
                  <div class="sgc26-kpi-tile__label">Incorporated</div>
                  <div class="sgc26-kpi-tile__sub">Based in Dubai</div>
                </div>
                <div class="sgc26-kpi-tile">
                  <div class="sgc26-kpi-number">ERP</div>
                  <div class="sgc26-kpi-tile__label">Partner</div>
                  <div class="sgc26-kpi-tile__sub">Certified v19</div>
                </div>
                <div class="sgc26-kpi-tile">
                  <div class="sgc26-kpi-number">AI</div>
                  <div class="sgc26-kpi-tile__label">Native Platform</div>
                  <div class="sgc26-kpi-tile__sub">Built into workflow</div>
                </div>
                <div class="sgc26-kpi-tile">
                  <div class="sgc26-kpi-number">5+</div>
                  <div class="sgc26-kpi-tile__label">Industry Verticals</div>
                  <div class="sgc26-kpi-tile__sub">Pre-configured</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- What sets us apart -->
      <section class="sgc26-section" style="background:var(--bg-2)">
        <div class="sgc26-container">
          <div class="sgc26-section-title" data-sgc-reveal="1">
            <p class="sgc26-label">Differentiators</p>
            <h2 class="sgc26-h2">What Sets SGC Tech AI Apart</h2>
          </div>
          <div class="sgc26-grid-3">
            <div class="sgc26-feature-card" data-sgc-reveal="1" data-sgc-delay="100" data-sgc-tilt="1">
              <div class="sgc26-feature-card__icon"><svg width="22" height="22"><use href="#i-map-pin" stroke="url(#sgc26-grad-icon)"/></svg></div>
              <h4 class="sgc26-feature-card__title">UAE-Native Expertise</h4>
              <p class="sgc26-feature-card__body">
                We know UAE VAT, FTA e-invoicing, RERA workflows, and local payroll law — because
                we have configured them dozens of times across different sectors.
              </p>
            </div>
            <div class="sgc26-feature-card" data-sgc-reveal="1" data-sgc-delay="200" data-sgc-tilt="1">
              <div class="sgc26-feature-card__icon"><svg width="22" height="22"><use href="#i-cpu" stroke="url(#sgc26-grad-icon)"/></svg></div>
              <h4 class="sgc26-feature-card__title">AI-Augmented Delivery</h4>
              <p class="sgc26-feature-card__body">
                AI tools accelerate chart-of-accounts mapping, test scenario generation, and report
                design — not to replace judgement, but to remove the time sink of repetitive tasks.
              </p>
            </div>
            <div class="sgc26-feature-card" data-sgc-reveal="1" data-sgc-delay="300" data-sgc-tilt="1">
              <div class="sgc26-feature-card__icon"><svg width="22" height="22"><use href="#i-clock" stroke="url(#sgc26-grad-icon)"/></svg></div>
              <h4 class="sgc26-feature-card__title">Fixed-Scope Pricing</h4>
              <p class="sgc26-feature-card__body">
                We define scope before quoting. Once agreed, price does not change unless you
                change scope — in writing, with a change order.
              </p>
            </div>
            <div class="sgc26-feature-card" data-sgc-reveal="1" data-sgc-delay="100" data-sgc-tilt="1">
              <div class="sgc26-feature-card__icon"><svg width="22" height="22"><use href="#i-trending-up" stroke="url(#sgc26-grad-icon)"/></svg></div>
              <h4 class="sgc26-feature-card__title">Structured Data Migration</h4>
              <p class="sgc26-feature-card__body">
                Every data migration uses validated templates with row-level error reports.
                No data enters production until reconciliation is confirmed.
              </p>
            </div>
            <div class="sgc26-feature-card" data-sgc-reveal="1" data-sgc-delay="200" data-sgc-tilt="1">
              <div class="sgc26-feature-card__icon"><svg width="22" height="22"><use href="#i-users" stroke="url(#sgc26-grad-icon)"/></svg></div>
              <h4 class="sgc26-feature-card__title">Role-Based Training</h4>
              <p class="sgc26-feature-card__body">
                Training is designed per role — accountant, warehouse manager, salesperson — not a
                generic walkthrough of the interface.
              </p>
            </div>
            <div class="sgc26-feature-card" data-sgc-reveal="1" data-sgc-delay="300" data-sgc-tilt="1">
              <div class="sgc26-feature-card__icon"><svg width="22" height="22"><use href="#i-shield" stroke="url(#sgc26-grad-icon)"/></svg></div>
              <h4 class="sgc26-feature-card__title">SLA-Backed Support</h4>
              <p class="sgc26-feature-card__body">
                Post-go-live support is structured, not informal. Response times are contractual,
                escalation paths are defined, and quarterly reviews are scheduled.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Company facts -->
      <section class="sgc26-section">
        <div class="sgc26-container">
          <div class="sgc26-section-title" data-sgc-reveal="1">
            <p class="sgc26-label">Company Facts</p>
            <h2 class="sgc26-h2">About Scholarix Global Consultants</h2>
          </div>
          <div class="sgc26-card" style="max-width:760px;margin:0 auto" data-sgc-reveal="1">
            <ul class="sgc26-check-list sgc26-check-list--pass">
              <li><svg width="16" height="16"><use href="#i-check"/></svg> Incorporated in UAE</li>
              <li><svg width="16" height="16"><use href="#i-check"/></svg> UAE VAT registered — tax invoice issued on every engagement</li>
              <li><svg width="16" height="16"><use href="#i-check"/></svg> ERP Partner — certified on v19</li>
              <li><svg width="16" height="16"><use href="#i-check"/></svg> Operating under brand SGC TECH AI</li>
              <li><svg width="16" height="16"><use href="#i-check"/></svg> Industry coverage: real estate, construction, trading, retail, hospitality</li>
              <li><svg width="16" height="16"><use href="#i-check"/></svg> All engagements governed by written scope of work</li>
              <li><svg width="16" height="16"><use href="#i-check"/></svg> Support SLAs defined in writing before project sign-off</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="sgc26-section" style="background:var(--bg-2)">
        <div class="sgc26-container" style="text-align:center">
          <div data-sgc-reveal="1">
            <h2 class="sgc26-h2" style="margin-bottom:1rem">Work With Us</h2>
            <p class="sgc26-body-lg" style="max-width:480px;margin:0 auto 2rem">
              Let's discuss your ERP requirements and build a realistic delivery plan together.
            </p>
            <div class="sgc26-cta-group" style="justify-content:center">
              <a href="/sgctech/contact" class="sgc26-btn sgc26-btn-primary sgc26-btn-lg">
                Book Discovery Call
                <svg width="18" height="18"><use href="#i-arrow-right"/></svg>
              </a>
              <a href="/sgctech/pricing" class="sgc26-btn sgc26-btn-ghost sgc26-btn-lg">View Packages</a>
            </div>
          </div>
        </div>
      </section>

    </t>
  </template>

</odoo>
