<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    SGC Report Theme - Core: reusable QWeb blocks.

    D2 (core purity, statically assertable): none of these templates carry
    an inherit_id targeting an ir.actions.report template, external_layout*,
    or any stock layout - they are new, standalone templates only ever
    reached via an explicit t-call from a bridge module's own report
    template or from external_layout_sgc itself. Installing this file alone
    changes nothing, because nothing calls these templates yet.

    Numeric fidelity (C4/F4): these blocks render structural/metadata markup
    only. Any bridge that calls block_metadata_grid / block_summary_card
    with amounts MUST pass the same t-field/t-esc value expression the
    original stock template used - these blocks must never introduce their
    own rounding/formatting of monetary or date values.
-->

    <!-- 1. Brand block -->
    <template id="block_brand" name="SGC Brand Block">
        <!--
            2026-07-23 fix: this block previously read
            company.report_footer_tagline, a field that does not exist on
            res.company - it broke every report going through block_header.
            QWeb raises AttributeError for undefined ORM fields (unlike
            plain template variables, which fail silently), so this crashed
            in production. Only genuinely real res.company fields are used
            below; no invented "tagline" concept.
        -->
        <div class="o_sgc_brand_block">
            <span class="o_sgc_brand_name" t-esc="company.name"/>
        </div>
    </template>

    <!-- 2. Address block (generic - caller passes a res.partner-like record and a label) -->
    <template id="block_address" name="SGC Address Block">
        <div class="o_sgc_address_block">
            <div class="o_sgc_address_label" t-esc="address_label"/>
            <div class="o_sgc_address_name" t-field="address_partner.name"/>
            <div t-field="address_partner"
                 t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/>
        </div>
    </template>

    <!--
        2026-07-23: block_header / block_footer were removed. They
        duplicated plumbing (logo, company address, tagline, footer
        fields, page numbers) that external_layout_sgc now inherits for
        free from web.external_layout_standard (see report_layout_sgc.xml)
        - the stock header/footer divs already render this correctly and
        are styled directly via the .o_sgc_report.header / .o_sgc_report.
        footer selectors in sgc_report_blocks.scss. block_brand above
        remains available as an opt-in helper for bridges that want the
        brand name styled somewhere inside their own body content.
    -->

    <!-- 5. Signature block -->
    <template id="block_signature" name="SGC Signature Block">
        <table class="o_sgc_signature_block" style="width:100%;">
            <tr>
                <td style="width:50%;">
                    <div class="o_sgc_signature_line">
                        <span t-esc="signature_left_label or 'Authorised Signatory'"/>
                    </div>
                </td>
                <td style="width:50%;">
                    <div class="o_sgc_signature_line">
                        <span t-esc="signature_right_label or 'Customer Acceptance'"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <!-- 6. Status badge (caller passes state_label + a normalized state_class
         suffix matching one of: draft/open/paid/done/overdue/pending) -->
    <template id="block_status_badge" name="SGC Status Badge">
        <span t-attf-class="o_sgc_status_badge o_sgc_status_#{status_class or 'draft'}"
              t-esc="status_label"/>
    </template>

    <!-- 7. Metadata grid (caller passes a list of {label, value} dicts via
         metadata_rows; values must already be the same t-field/t-esc output
         the stock template used - this block does not reformat them) -->
    <template id="block_metadata_grid" name="SGC Metadata Grid">
        <table class="o_sgc_metadata_grid">
            <t t-foreach="metadata_rows" t-as="row">
                <tr>
                    <td class="o_sgc_metadata_label" t-esc="row['label']"/>
                    <td class="o_sgc_metadata_value" t-esc="row['value']"/>
                </tr>
            </t>
        </table>
    </template>

    <!-- 8. Summary card (single KPI/total tile; caller supplies the exact
         formatted value string it already computed, unchanged) -->
    <template id="block_summary_card" name="SGC Summary Card">
        <div class="o_sgc_summary_card">
            <div class="o_sgc_summary_label" t-esc="summary_label"/>
            <div class="o_sgc_summary_value" t-esc="summary_value"/>
        </div>
    </template>

    <!-- 9. Table style: not a t-call block but a class contract - bridges
         add class="o_sgc_table" to their existing <table> (and
         class="o_sgc_table_total_row" to their existing totals <tr>)
         without altering any <td> value expression. Documented here so the
         convention lives next to the other blocks. -->

    <!-- 10. Watermark -->
    <template id="block_watermark" name="SGC Watermark">
        <t t-if="watermark_text">
            <div class="o_sgc_watermark" t-esc="watermark_text"/>
        </t>
    </template>

</odoo>
