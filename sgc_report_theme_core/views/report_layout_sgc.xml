<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    external_layout_sgc - the additive SGC TECH AI report layout.

    2026-07-23 architecture change: rebuilt as a PRIMARY-MODE inheritance
    of web.external_layout_standard instead of a from-scratch template.

    Building from scratch (the original approach) meant reinventing
    plumbing Odoo's stock layout already gets right - the header/footer/
    article class-marker convention ir.actions.report._prepare_html()
    requires for wkhtmltopdf's repeating-header mechanism, and
    background-color handling - and that reinvention is exactly what
    caused this module's early bugs.

    inherit_id="web.external_layout_standard" + primary="True" gives us
    both properties at once:
    - The stock template is NEVER modified (mode=primary creates a
      genuinely new, independently-callable view starting from a COPY of
      the parent's arch) - untouched reports remain provably unaffected,
      satisfying the same non-destructive guarantee the from-scratch
      approach was trying to achieve (C1).
    - We inherit all of the parent's already-correct, battle-tested
      structure (header/article/footer divs with the right class markers,
      company logo/address/tagline/footer field rendering, page numbers,
      background-image support) instead of re-implementing it and
      introducing new bugs.

    We only XPath-patch in our own "o_sgc_report" scoping class onto the
    three structural divs; sgc_report_tokens.scss / sgc_report_blocks.scss
    style anything carrying that class. No inherit_id/t-call re-point of
    any EXISTING REPORT happens here - only bridge modules do that, by
    changing a report's own template to
    t-call="sgc_report_theme_core.external_layout_sgc" instead of
    "web.external_layout".
-->

    <!--
        2026-07-23 fix: the stock header/article/footer divs use
        t-attf-class (a QWeb directive), not a plain class attribute -
        view-inheritance XPath surgery operates on the RAW arch before
        QWeb directives are evaluated, so hasclass('header') (which
        specifically checks a literal class="..." attribute) matched
        nothing and failed module install with "cannot be located in
        parent view". Match via contains(@t-attf-class, ...) instead, and
        patch t-attf-class itself (not class) with a full replacement
        value - not add/remove, to avoid depending on undocumented
        add/separator semantics for a non-"class" attribute, and to avoid
        repeating the earlier bug where a second class-bearing attribute
        on the same element got silently dropped.
    -->
    <template id="external_layout_sgc" inherit_id="web.external_layout_standard" primary="True">

        <!--
            2026-07-23 second fix: external_layout_standard assumes `o`
            and `company` are ALREADY set - normally true because reports
            t-call the web.external_layout DISPATCHER first, which sets
            them up before delegating to external_layout_standard. Our
            bridges t-call external_layout_sgc directly, bypassing that
            dispatcher entirely, so `company` was undefined - confirmed
            live via KeyError: 'company' in the actual PDF render.
            Reproduces the dispatcher's own setup logic (copied verbatim
            from web.external_layout in report_templates.xml) so this
            template is usable standalone.
        -->
        <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="before">
            <t t-if="not o" t-set="o" t-value="doc"/>
            <t t-if="not company">
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <!-- 2026-07-28 content-aware density: pick a vertical rhythm from the
                 real line count, so a 3-line pro-forma breathes and a 30-line one
                 compresses instead of spilling onto page 2 with two orphan rows.
                 Works for invoices/pro-formas (invoice_line_ids) and quotations
                 (order_line); anything else falls back to the regular rhythm.
                 Section and note rows are excluded so they cannot inflate the
                 count and wrongly tighten a short document. -->
            <t t-set="sgc_lines"
               t-value="(o.invoice_line_ids if o and 'invoice_line_ids' in o
                         else (o.order_line if o and 'order_line' in o else []))"/>
            <t t-set="sgc_lines"
               t-value="sgc_lines.filtered(lambda l: l.display_type not in ('line_section', 'line_note')) if sgc_lines else []"/>
            <t t-set="sgc_count" t-value="len(sgc_lines)"/>

            <!-- 2026-08-02: measure the TEXT, not the row count. Counting rows
                 got this exactly backwards on the documents that need help
                 most: a 3-line quotation carrying 816 characters of product
                 description scored "short" and was handed the airy 10pt/1.6
                 rhythm, which blew it onto a second page holding two orphan
                 lines. Estimate how many rendered lines the table will really
                 occupy - one per row, one per author newline (white-space is
                 pre-line, so those survive), plus the wrap-around from long
                 text at roughly 60 characters per line in a 46% column. -->
            <t t-set="sgc_chars" t-value="sum(len(l.name or '') for l in sgc_lines)"/>
            <t t-set="sgc_breaks" t-value="sum((l.name or '').count('\n') for l in sgc_lines)"/>
            <t t-set="sgc_rows" t-value="sgc_count + sgc_breaks + int(sgc_chars / 60)"/>
            <t t-set="sgc_density"
               t-value="'sgc-airy' if sgc_rows &lt;= 8 else ('sgc-tight' if sgc_rows &gt; 20 else 'sgc-regular')"/>

            <!-- Text-heavy documents also change how page breaks are allowed:
                 see the sgc-flow block in sgc_report.scss. -->
            <t t-set="sgc_flow" t-value="'sgc-flow' if sgc_rows &gt; 20 else ''"/>

            <!-- 2026-08-02 Dubai landmark watermark, picked per document type
                 so a quotation and an invoice are not the same page. The class
                 only selects which artwork sgc_report.scss paints as the
                 article's background; a fourth (o_sgc_wm_burj_al_arab) ships
                 unused and is available to any bridge that wants it. Change
                 the mapping here - nothing else needs to know. -->
            <t t-set="sgc_wm"
               t-value="'o_sgc_wm_burj_khalifa' if o and o._name == 'sale.order'
                        else ('o_sgc_wm_museum' if o and o._name == 'account.move'
                        else 'o_sgc_wm_palm')"/>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="attributes">
            <attribute name="t-attf-class">o_sgc_report o_sgc_header #{sgc_density} header o_company_#{company.id}_layout</attribute>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'article o_report_layout_standard')]" position="attributes">
            <attribute name="t-attf-class">o_sgc_report o_sgc_body #{sgc_density} #{sgc_flow} #{sgc_wm} article o_report_layout_standard o_table_standard o_company_#{company.id}_layout o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}</attribute>
        </xpath>

        <!--
            2026-08-02 page chrome: gold corner brackets (page-1 chrome).
            All elements are position:fixed (sgc_report_signature.scss) and
            z-index:0 keeps them behind the flowing content. Inserted as the
            FIRST child of the article div so they frame the document body
            itself. Opt-in only: these classes change nothing unless a bridge
            report t-calls this template (same additive guarantee as the rest
            of the module).

            Note: this chrome renders on the FIRST PAGE ONLY. wkhtmltopdf does
            not repeat position:fixed elements onto continuation pages - see
            the measurement recorded on .o_sgc_ivory_bleed in
            sgc_report_signature.scss before assuming otherwise.
        -->
        <xpath expr="//div[contains(@t-attf-class, 'article o_report_layout_standard')]/*[1]" position="before">
            <span class="o_sgc_corner o_sgc_corner_tl"><span class="o_sgc_corner_tertiary"></span></span>
            <span class="o_sgc_corner o_sgc_corner_tr"><span class="o_sgc_corner_tertiary"></span></span>
            <span class="o_sgc_corner o_sgc_corner_bl"><span class="o_sgc_corner_tertiary"></span></span>
            <span class="o_sgc_corner o_sgc_corner_br"><span class="o_sgc_corner_tertiary"></span></span>
            <span class="o_sgc_ivory_bleed"></span>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_')]" position="attributes">
            <attribute name="t-attf-class">o_sgc_report o_sgc_footer #{sgc_density} footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}</attribute>
        </xpath>

    </template>

</odoo>
