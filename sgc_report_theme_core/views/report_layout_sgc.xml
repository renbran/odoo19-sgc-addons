<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    external_layout_sgc - the additive SGC TECH AI report layout.

    2026-07-23 architecture change: rebuilt as a PRIMARY-MODE inheritance
    of web.external_layout_standard instead of a from-scratch template.

    Building from scratch (the original approach) meant reinventing
    plumbing Odoo's stock layout already gets right - the header/footer/
    article class-marker convention ir.actions.report._prepare_html()
    requires for wkhtmltopdf's repeating-header mechanism, and
    background-color handling - and that reinvention is exactly what
    caused this module's early bugs.

    inherit_id="web.external_layout_standard" + primary="True" gives us
    both properties at once:
    - The stock template is NEVER modified (mode=primary creates a
      genuinely new, independently-callable view starting from a COPY of
      the parent's arch) - untouched reports remain provably unaffected,
      satisfying the same non-destructive guarantee the from-scratch
      approach was trying to achieve (C1).
    - We inherit all of the parent's already-correct, battle-tested
      structure (header/article/footer divs with the right class markers,
      company logo/address/tagline/footer field rendering, page numbers,
      background-image support) instead of re-implementing it and
      introducing new bugs.

    We only XPath-patch in our own "o_sgc_report" scoping class onto the
    three structural divs; sgc_report_tokens.scss / sgc_report_blocks.scss
    style anything carrying that class. No inherit_id/t-call re-point of
    any EXISTING REPORT happens here - only bridge modules do that, by
    changing a report's own template to
    t-call="sgc_report_theme_core.external_layout_sgc" instead of
    "web.external_layout".
-->

    <!--
        2026-07-23 fix: the stock header/article/footer divs use
        t-attf-class (a QWeb directive), not a plain class attribute -
        view-inheritance XPath surgery operates on the RAW arch before
        QWeb directives are evaluated, so hasclass('header') (which
        specifically checks a literal class="..." attribute) matched
        nothing and failed module install with "cannot be located in
        parent view". Match via contains(@t-attf-class, ...) instead, and
        patch t-attf-class itself (not class) with a full replacement
        value - not add/remove, to avoid depending on undocumented
        add/separator semantics for a non-"class" attribute, and to avoid
        repeating the earlier bug where a second class-bearing attribute
        on the same element got silently dropped.
    -->
    <template id="external_layout_sgc" inherit_id="web.external_layout_standard" primary="True">

        <!--
            2026-07-23 second fix: external_layout_standard assumes `o`
            and `company` are ALREADY set - normally true because reports
            t-call the web.external_layout DISPATCHER first, which sets
            them up before delegating to external_layout_standard. Our
            bridges t-call external_layout_sgc directly, bypassing that
            dispatcher entirely, so `company` was undefined - confirmed
            live via KeyError: 'company' in the actual PDF render.
            Reproduces the dispatcher's own setup logic (copied verbatim
            from web.external_layout in report_templates.xml) so this
            template is usable standalone.
        -->
        <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="before">
            <t t-if="not o" t-set="o" t-value="doc"/>
            <t t-if="not company">
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <!-- 2026-07-28 content-aware density: pick a vertical rhythm from the
                 real line count, so a 3-line pro-forma breathes and a 30-line one
                 compresses instead of spilling onto page 2 with two orphan rows.
                 Works for invoices/pro-formas (invoice_line_ids) and quotations
                 (order_line); anything else falls back to the regular rhythm.
                 Section and note rows are excluded so they cannot inflate the
                 count and wrongly tighten a short document. -->
            <t t-set="sgc_lines"
               t-value="(o.invoice_line_ids if o and 'invoice_line_ids' in o
                         else (o.order_line if o and 'order_line' in o else []))"/>
            <t t-set="sgc_lines"
               t-value="sgc_lines.filtered(lambda l: l.display_type not in ('line_section', 'line_note')) if sgc_lines else []"/>
            <t t-set="sgc_count" t-value="len(sgc_lines)"/>

            <!-- 2026-08-02: measure the TEXT, not the row count. Counting rows
                 got this exactly backwards on the documents that need help
                 most: a 3-line quotation carrying 816 characters of product
                 description scored "short" and was handed the airy 10pt/1.6
                 rhythm, which blew it onto a second page holding two orphan
                 lines. Estimate how many rendered lines the table will really
                 occupy - one per row, one per author newline (white-space is
                 pre-line, so those survive), plus the wrap-around from long
                 text at roughly 60 characters per line in a 46% column. -->
            <t t-set="sgc_chars" t-value="sum(len(l.name or '') for l in sgc_lines)"/>
            <t t-set="sgc_breaks" t-value="sum((l.name or '').count('\n') for l in sgc_lines)"/>
            <t t-set="sgc_rows" t-value="sgc_count + sgc_breaks + int(sgc_chars / 60)"/>
            <t t-set="sgc_density"
               t-value="'sgc-airy' if sgc_rows &lt;= 8 else ('sgc-tight' if sgc_rows &gt; 20 else 'sgc-regular')"/>

            <!-- Text-heavy documents also change how page breaks are allowed:
                 see the sgc-flow block in sgc_report.scss. -->
            <t t-set="sgc_flow" t-value="'sgc-flow' if sgc_rows &gt; 20 else ''"/>

            <!-- 2026-08-02 Dubai landmark watermark, picked per document type
                 so a quotation and an invoice are not the same page. The class
                 only selects which artwork sgc_report.scss paints as the
                 article's background; a fourth (o_sgc_wm_burj_al_arab) ships
                 unused and is available to any bridge that wants it. Change
                 the mapping here - nothing else needs to know. -->
            <t t-set="sgc_wm"
               t-value="'o_sgc_wm_burj_khalifa' if o and o._name == 'sale.order'
                        else ('o_sgc_wm_museum' if o and o._name == 'account.move'
                        else 'o_sgc_wm_palm')"/>
        </xpath>

        <!--
            2026-08-02: replace the stock header with a larger logo beside
            company info (name, tagline, address). The stock header has the
            logo and tagline in a flex row, then address in a separate row.
            We combine them into one row: logo on left (capped larger), company
            info on right. This keeps the header compact within 32mm.
        -->
        <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="replace">
            <div t-attf-class="o_sgc_report o_sgc_header #{sgc_density} header o_company_#{company.id}_layout">
                <div class="d-flex align-items-start justify-content-between" style="gap: 20mm;">
                    <!-- Left: Logo - larger, capped at 48px height -->
                    <img t-if="company.logo"
                         class="o_company_logo"
                         t-att-src="image_data_uri(company.logo)"
                         alt="Logo"
                         style="max-height: 48px; width: auto; max-width: 200px; object-fit: contain;"/>
                    
                    <!-- Right: Company info block (name, tagline, address) -->
                    <div class="text-end flex-grow-1" style="min-width: 0;">
                        <div t-if="company.name" t-esc="company.name" class="fw-bold" style="font-size: 14pt; color: #0F213D; line-height: 1.2; margin-bottom: 2px;"/>
                        <div t-if="company.report_header" t-field="company.report_header" class="text-muted" style="font-size: 9pt; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; margin-bottom: 6px;"/>
                        <ul class="list-unstyled" name="company_address_list" style="font-size: 8pt; line-height: 1.3; color: #5F6775; margin: 0; padding: 0;">
                            <li t-if="company.is_company_details_empty">
                                <span t-field="company.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                            </li>
                            <li t-else="">
                                <span t-field="company.company_details"/>
                            </li>
                            <li t-if="not forced_vat">
                                <t t-if="company.vat">
                                    <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                    <span t-esc="company.vat"/>
                                </t>
                            </li>
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                <span t-esc="forced_vat"/>
                            </li>
                        </ul>
                    </div>
                </div>
                <hr class="my-2" style="border-color: rgba(95, 103, 117, 0.3); border-width: 1px;"/>
            </div>
        </xpath>

        <!-- Remove the old header attribute patch since we replaced the whole header -->
        <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="attributes">
            <attribute name="t-attf-class">o_sgc_report o_sgc_header #{sgc_density} header o_company_#{company.id}_layout</attribute>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'article o_report_layout_standard')]" position="attributes">
            <attribute name="t-attf-class">o_sgc_report o_sgc_body #{sgc_density} #{sgc_flow} #{sgc_wm} article o_report_layout_standard o_table_standard o_company_#{company.id}_layout o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}</attribute>
        </xpath>

        <!--
            2026-08-02 page chrome: gold corner brackets (page-1 chrome).
            All elements are position:fixed (sgc_report_signature.scss) and
            z-index:0 keeps them behind the flowing content. Inserted as the
            FIRST child of the article div so they frame the document body
            itself. Opt-in only: these classes change nothing unless a bridge
            report t-calls this template (same additive guarantee as the rest
            of the module).

            Note: this chrome renders on the FIRST PAGE ONLY. wkhtmltopdf does
            not repeat position:fixed elements onto continuation pages - see
            the measurement recorded on .o_sgc_ivory_bleed in
            sgc_report_signature.scss before assuming otherwise.
        -->
        <xpath expr="//div[contains(@t-attf-class, 'article o_report_layout_standard')]/*[1]" position="before">
            <span class="o_sgc_corner o_sgc_corner_tl"><span class="o_sgc_corner_tertiary"></span></span>
            <span class="o_sgc_corner o_sgc_corner_tr"><span class="o_sgc_corner_tertiary"></span></span>
            <span class="o_sgc_corner o_sgc_corner_bl"><span class="o_sgc_corner_tertiary"></span></span>
            <span class="o_sgc_corner o_sgc_corner_br"><span class="o_sgc_corner_tertiary"></span></span>
            <span class="o_sgc_ivory_bleed"></span>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_')]" position="attributes">
            <attribute name="t-attf-class">o_sgc_report o_sgc_footer #{sgc_density} footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}</attribute>
        </xpath>

        <!--
            2026-08-02: replace the stock footer with company footer content
            plus clickable social media icons from company records.
            Social icons link to company's social URLs when in web view.
        -->
        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_')]" position="replace">
            <div t-attf-class="o_sgc_report o_sgc_footer #{sgc_density} footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <div class="d-flex flex-wrap justify-content-between align-items-center" style="gap: 10px;">
                    <!-- Left: Company footer content -->
                    <div class="flex-grow-1 text-start" t-field="company.report_footer" style="font-size: 7.75pt; line-height: 1.35; color: #5F6775; min-width: 0;"/>
                    
                    <!-- Right: Social media icons (clickable in web) + page numbers -->
                    <div class="d-flex align-items-center gap-2 flex-wrap" style="font-size: 7.75pt; color: #5F6775;">
                        <!-- Social media icons -->
                        <div class="d-flex gap-1">
                            <a t-if="company.social_linkedin" t-att-href="company.social_linkedin" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none" style="font-size: 10pt;" aria-label="LinkedIn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                            </a>
                            <a t-if="company.social_twitter" t-att-href="company.social_twitter" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none" style="font-size: 10pt;" aria-label="Twitter / X">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            </a>
                            <a t-if="company.social_facebook" t-att-href="company.social_facebook" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none" style="font-size: 10pt;" aria-label="Facebook">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.046V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                            </a>
                            <a t-if="company.social_instagram" t-att-href="company.social_instagram" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none" style="font-size: 10pt;" aria-label="Instagram">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                            </a>
                            <a t-if="company.social_youtube" t-att-href="company.social_youtube" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none" style="font-size: 10pt;" aria-label="YouTube">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                            </a>
                            <a t-if="company.social_github" t-att-href="company.social_github" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none" style="font-size: 10pt;" aria-label="GitHub">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                            </a>
                        </div>
                        
                        <!-- Page numbers (PDF only) -->
                        <div t-if="report_type == 'pdf'" class="text-nowrap ms-2" style="font-size: 7.75pt; color: #5F6775;">
                            Page <span class="page"/> / <span class="topage"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>

    </template>

</odoo>
