<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sgc_nurture_touch_list" model="ir.ui.view">
        <field name="name">sgc.nurture.touch.list</field>
        <field name="model">sgc.nurture.touch</field>
        <field name="arch" type="xml">
            <list decoration-danger="delivery_status in ('failed','validation_blocked')"
                  decoration-muted="delivery_status=='skipped_dry_run'">
                <field name="lead_id"/>
                <field name="sequence_id"/>
                <field name="touch_number"/>
                <field name="channel"/>
                <field name="intent"/>
                <field name="delivery_status"/>
                <field name="engagement_status"/>
                <field name="drafted_at"/>
                <field name="generation_model" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_sgc_nurture_touch" model="ir.actions.act_window">
        <field name="name">Nurture Touches</field>
        <field name="res_model">sgc.nurture.touch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
