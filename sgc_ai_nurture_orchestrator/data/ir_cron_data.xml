<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deliberately the ONLY cron in this module. Enrollment, drafting,
         and sending are all manual-trigger-only (see the module docstring
         on sgc.nurture.sequence): there is no cron sweeping leads or
         sequences, on purpose. This one is pure housekeeping: it only ever
         touches sequences that are already in a terminal state
         (exhausted/stopped/opted_out/handed_off), archiving them from
         default list views. It never drafts or sends anything. -->
    <record id="cron_nurture_gc" model="ir.cron">
        <field name="name">SGC AI Nurture: archive stale sequences</field>
        <field name="model_id" ref="model_sgc_nurture_sequence"/>
        <field name="state">code</field>
        <field name="code">model._cron_gc_stale()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
