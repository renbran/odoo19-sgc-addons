<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Re-points 9 financial report templates onto
    sgc_report_theme_core.external_layout_sgc. These templates currently
    t-call web.internal_layout (not web.external_layout like the other
    bridges) - the xpath target is the same pattern, just matching the
    layout each template actually calls today.
-->

    <template id="report_agedpartnerbalance_sgc"
              inherit_id="accounting_pdf_reports.report_agedpartnerbalance">
        <xpath expr="//t[@t-call='web.internal_layout']" position="attributes">
            <attribute name="t-call">sgc_report_theme_core.external_layout_sgc</attribute>
        </xpath>
    </template>

    <template id="report_financial_sgc"
              inherit_id="accounting_pdf_reports.report_financial">
        <xpath expr="//t[@t-call='web.internal_layout']" position="attributes">
