<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sgc_booking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sgc.booking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Online Session Booking" id="sgc_website_booking_settings">
                    <setting string="Public Booking Type"
                             help="Booking type offered on the /book-session page.">
                        <field name="sgc_website_booking_type_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
