<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate=0: templates are module-managed so fixes deploy on upgrade. -->
    <data noupdate="0">

        <!-- Success: booking confirmed -->
        <record id="mail_template_booking_confirmed" model="mail.template">
            <field name="name">Online Session: Booking Confirmed</field>
            <field name="model_id" ref="resource_booking.model_resource_booking"/>
            <field name="subject">{{ object.type_id.name or 'Your Online Session' }} — Confirmed</field>
            <field name="email_from">{{ (object.type_id.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object._sgc_requester_email() }}</field>
            <field name="partner_to">{{ object.partner_id.id or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="font-family:Arial,Helvetica,sans-serif;color:#1a2b3c;font-size:14px;">
                    <p>Hi <t t-out="object.partner_id.name or 'there'"/>,</p>
                    <p>Your online session is <strong>confirmed</strong>. Here are the details:</p>
                    <t t-set="vc" t-value="object.meeting_id.videocall_location or object.videocall_location"/>
                    <table style="margin:16px 0;border-collapse:collapse;">
                        <tr>
                            <td style="padding:6px 12px;color:#6b7c8f;">When</td>
                            <td style="padding:6px 12px;font-weight:bold;">
                                <t t-out="format_datetime(object.start, tz=object.type_id.resource_calendar_id.tz, dt_format='EEEE d MMMM y, HH:mm')"/>
                                (<t t-out="object.type_id.resource_calendar_id.tz or 'UTC'"/>)
                            </td>
                        </tr>
                        <tr t-if="vc">
                            <td style="padding:6px 12px;color:#6b7c8f;">Meeting link</td>
                            <td style="padding:6px 12px;">
                                <a t-att-href="vc" t-out="vc"/>
                            </td>
                        </tr>
                    </table>
                    <p>
                        Need to reschedule or cancel? Manage your booking here:<br/>
                        <a t-att-href="'%s%s' % (object.get_base_url(), object.get_portal_url())"
                           style="display:inline-block;margin-top:8px;padding:10px 18px;background:#00a3cc;color:#fff;text-decoration:none;border-radius:6px;">
                            Manage my booking
                        </a>
                    </p>
                    <p style="margin-top:24px;color:#6b7c8f;">We look forward to speaking with you.</p>
                </div>
            </field>
        </record>

        <!-- Failure / cancellation notice -->
        <record id="mail_template_booking_failed" model="mail.template">
            <field name="name">Online Session: Booking Issue</field>
            <field name="model_id" ref="resource_booking.model_resource_booking"/>
            <field name="subject">{{ object.type_id.name or 'Your Online Session' }} — Action needed</field>
            <field name="email_from">{{ (object.type_id.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object._sgc_requester_email() }}</field>
            <field name="partner_to">{{ object.partner_id.id or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="font-family:Arial,Helvetica,sans-serif;color:#1a2b3c;font-size:14px;">
                    <p>Hi <t t-out="object.partner_id.name or 'there'"/>,</p>
                    <p>
                        Unfortunately we were unable to keep your requested online session.
                        This can happen if the slot became unavailable or the session could
                        not be set up.
                    </p>
                    <p>
                        Please pick a new time that works for you:<br/>
                        <a t-att-href="'%s/book-session' % object.get_base_url()"
                           style="display:inline-block;margin-top:8px;padding:10px 18px;background:#00a3cc;color:#fff;text-decoration:none;border-radius:6px;">
                            Book another session
                        </a>
                    </p>
                    <p style="margin-top:24px;color:#6b7c8f;">Sorry for the inconvenience.</p>
                </div>
            </field>
        </record>

    </data>
</odoo>
