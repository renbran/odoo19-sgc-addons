<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_warning_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.employee_id.company_id or res_company"/>
                <t t-set="doc_date" t-value="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                <t t-call="sgc_report_theme_core.external_layout_sgc">
                    <div class="page sgc-warning-letter-report">
                        <style>
                            .sgc-warning-letter-report {
                                font-family: 'IBM Plex Sans', Arial, sans-serif;
                                color: #1C2430;
                                font-size: 9pt !important;
                                line-height: 1.45;
                            }
                            .sgc-warning-letter-report h1.sgc-doc-title {
                                font-size: 14pt !important;
                                font-weight: 600;
                                letter-spacing: .01em;
                                color: #0F213D;
                                margin: 0 0 10px 0;
                                padding-bottom: 6px;
                                border-bottom: 1px solid rgba(95, 103, 117, 0.3);
                                page-break-after: avoid;
                            }
                            .sgc-warning-letter-report table.sgc-meta {
                                width: 100%;
                                table-layout: fixed;
                                border-collapse: collapse;
                                margin: 10px 0 14px 0;
                            }
                            .sgc-warning-letter-report table.sgc-meta td {
                                border: none;
                                padding: 3px 10px 3px 0;
                                vertical-align: top;
                                width: 33.33%;
                            }
                            .sgc-warning-letter-report .sgc-label {
                                display: block;
                                font-size: 7pt !important;
                                color: #5F6775;
                                text-transform: uppercase;
                                letter-spacing: .07em;
                                font-weight: 600;
                            }
                            .sgc-warning-letter-report .sgc-value {
                                font-size: 9pt !important;
                                color: #1C2430;
                            }
                            .sgc-warning-letter-report p {
                                font-size: 9pt !important;
                                margin: 0 0 8px 0;
                            }
                            .sgc-warning-letter-report strong {
                                font-weight: 600;
                            }
                            .sgc-warning-letter-report .sgc-reason-body {
                                white-space: pre-line;
                                padding: 6px 0 4px 0;
                            }
                            .sgc-warning-letter-report ul {
                                font-size: 9pt !important;
                                margin: 0 0 8px 0;
                                padding-left: 16px;
                            }
                            .sgc-warning-letter-report li {
                                font-size: 9pt !important;
                                margin-bottom: 3px;
                            }
                            .sgc-warning-letter-report table.sgc-sign {
                                width: 100%;
                                table-layout: fixed;
                                border: none;
                                border-collapse: collapse;
                                page-break-inside: avoid;
                                margin-top: 16px;
                            }
                            .sgc-warning-letter-report table.sgc-sign td {
                                border: none;
                                padding: 4px 12px 4px 0;
                                vertical-align: top;
                            }
                            .sgc-warning-letter-report .sgc-sign-title {
                                font-size: 9pt !important;
                                font-weight: 600;
                                color: #0F213D;
                                margin-bottom: 4px;
                            }
                            .sgc-warning-letter-report .sgc-sign-text {
                                font-size: 9pt !important;
                                color: #1C2430;
                            }
                            .sgc-warning-letter-report .sgc-rule-line {
                                border-bottom: 1px solid #1C2430;
                                width: 100%;
                                margin: 12px 0 3px 0;
                                height: 14px;
                            }
                            .sgc-warning-letter-report .sgc-rule-caption {
                                font-size: 7pt !important;
                                color: #5F6775;
                                text-transform: uppercase;
                                letter-spacing: .07em;
                                font-weight: 600;
                            }
                        </style>

                        <h1 class="sgc-doc-title">WARNING LETTER</h1>

                        <table class="sgc-meta">
                            <tr>
                                <td><span class="sgc-label">Date</span><span class="sgc-value" t-esc="doc_date"/></td>
                                <td><span class="sgc-label">To</span><span class="sgc-value" t-esc="o.employee_name"/></td>
                                <td><span class="sgc-label">Position</span><span class="sgc-value" t-esc="o.job_title or '-'"/></td>
                            </tr>
                            <tr>
                                <td><span class="sgc-label">Document Reference</span><span class="sgc-value" t-esc="o.name"/></td>
                                <td><span class="sgc-label">Type</span><span class="sgc-value">
                                    <t t-if="o.warning_letter_type" t-esc="dict(o._fields['warning_letter_type'].selection).get(o.warning_letter_type, o.warning_letter_type)"/><t t-else="">-</t>
                                </span></td>
                                <td><span class="sgc-label">Department</span><span class="sgc-value">
                                    <t t-if="o.department_id" t-esc="o.department_id.name"/><t t-else="">-</t>
                                </span></td>
                            </tr>
                        </table>

                        <div>
                            <p>This letter serves as a formal warning regarding your recent performance, which has been identified as below the expected standards for your position at <t t-esc="company.name"/>.</p>

                            <t t-if="o.warning_letter_reason">
                                <p>The specific issues observed are as follows:</p>
                                <div class="sgc-reason-body" t-esc="o.warning_letter_reason"/>
                            </t>
                            <t t-else="">
                                <p>Despite previous discussions and guidance, the following performance issues have been observed:</p>
                                <ul>
                                    <li>Consistently failing to meet deadlines and performance targets</li>
                                    <li>Lack of improvement despite feedback and coaching</li>
                                    <li>Quality of work below acceptable standards</li>
                                    <li>Inadequate communication and collaboration with team members</li>
                                </ul>
                            </t>

                            <p>You are hereby given a period of <span t-esc="o.warning_letter_improvement_period or 30"/> days to demonstrate significant improvement in your performance. Failure to improve within this period may result in further disciplinary action, up to and including termination of employment.</p>

                            <p>Please schedule a meeting with your immediate supervisor to discuss a performance improvement plan.</p>

                            <p>We believe in your potential to succeed and are committed to supporting your development. However, we must ensure that all employees meet the performance standards required for our organization's success.</p>
                        </div>

                        <table class="sgc-sign">
                            <tbody>
                                <tr>
                                    <td style="width: 50%;">
                                        <p class="sgc-sign-text">Sincerely,</p>
                                        <p class="sgc-sign-text"><strong t-esc="(o.warning_letter_supervisor_id.name if o.warning_letter_supervisor_id else 'Manager')"/><br/><t t-esc="(o.warning_letter_supervisor_id.job_id.name if o.warning_letter_supervisor_id and o.warning_letter_supervisor_id.job_id else 'Manager')"/><br/><t t-esc="company.name"/></p>
                                        <div class="sgc-rule-line"/>
                                        <span class="sgc-rule-caption">Signature</span>
                                    </td>
                                    <td style="width: 50%;">
                                        <p class="sgc-sign-title">Employee Acknowledgement</p>
                                        <p class="sgc-sign-text">I have received and reviewed this warning letter.</p>
                                        <div class="sgc-rule-line"/>
                                        <span class="sgc-rule-caption">Signature</span>
                                        <div class="sgc-rule-line"/>
                                        <span class="sgc-rule-caption">Date</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
