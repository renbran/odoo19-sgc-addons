<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_company_asset_handover">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.employee_id.company_id or res_company"/>
                <t t-set="doc_date" t-value="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                <t t-call="web.external_layout">
                    <div class="page sgc-asset-handover-report">
                        <style>
                            .sgc-asset-handover-report {
                                font-family: 'IBM Plex Sans', Arial, sans-serif;
                                color: #1C2430;
                                font-size: 9pt !important;
                                line-height: 1.45;
                            }
                            .sgc-asset-handover-report h1.sgc-doc-title {
                                font-size: 14pt !important;
                                font-weight: 600;
                                letter-spacing: .01em;
                                color: #0F213D;
                                margin: 0 0 10px 0;
                                padding-bottom: 6px;
                                border-bottom: 1px solid rgba(95, 103, 117, 0.3);
                                page-break-after: avoid;
                            }
                            .sgc-asset-handover-report table.sgc-meta {
                                width: 100%;
                                table-layout: fixed;
                                border-collapse: collapse;
                                margin: 10px 0 14px 0;
                            }
                            .sgc-asset-handover-report table.sgc-meta td {
                                border: none;
                                padding: 3px 10px 3px 0;
                                vertical-align: top;
                                width: 33.33%;
                            }
                            .sgc-asset-handover-report .sgc-label {
                                display: block;
                                font-size: 7pt !important;
                                color: #5F6775;
                                text-transform: uppercase;
                                letter-spacing: .07em;
                                font-weight: 600;
                            }
                            .sgc-asset-handover-report .sgc-value {
                                font-size: 9pt !important;
                                color: #1C2430;
                            }
                            .sgc-asset-handover-report p {
                                font-size: 9pt !important;
                                margin: 0 0 8px 0;
                            }
                            .sgc-asset-handover-report strong {
                                font-weight: 600;
                            }
                            .sgc-asset-handover-report table.sgc-data {
                                width: 100%;
                                table-layout: fixed;
                                border-collapse: collapse;
                                border: 1px solid rgba(95, 103, 117, 0.3);
                                margin: 10px 0 16px 0;
                            }
                            .sgc-asset-handover-report table.sgc-data thead {
                                display: table-header-group;
                            }
                            .sgc-asset-handover-report table.sgc-data th {
                                background: #0F213D;
                                color: #F7F4EE;
                                font-size: 7pt !important;
                                font-weight: 600;
                                text-transform: uppercase;
                                letter-spacing: .07em;
                                padding: 5px 6px;
                                border: 1px solid #0F213D;
                                border-right: 1px solid rgba(247, 244, 238, 0.28);
                                word-wrap: break-word;
                                vertical-align: bottom;
                            }
                            .sgc-asset-handover-report table.sgc-data th:last-child {
                                border-right: 1px solid #0F213D;
                            }
                            .sgc-asset-handover-report table.sgc-data td {
                                border: 1px solid rgba(95, 103, 117, 0.3);
                                padding: 4px 6px;
                                vertical-align: top;
                                font-size: 9pt !important;
                                word-wrap: break-word;
                            }
                            .sgc-asset-handover-report table.sgc-data tr {
                                page-break-inside: avoid;
                            }
                            .sgc-asset-handover-report table.sgc-data tr.sgc-section td {
                                background: #ECE7DF;
                                font-weight: 600;
                            }
                            .sgc-asset-handover-report table.sgc-sign {
                                width: 100%;
                                table-layout: fixed;
                                border: none;
                                border-collapse: collapse;
                                page-break-inside: avoid;
                                margin-top: 16px;
                            }
                            .sgc-asset-handover-report table.sgc-sign td {
                                border: none;
                                padding: 4px 12px 4px 0;
                                vertical-align: top;
                            }
                            .sgc-asset-handover-report .sgc-sign-title {
                                font-size: 9pt !important;
                                font-weight: 600;
                                color: #0F213D;
                                margin-bottom: 4px;
                            }
                            .sgc-asset-handover-report .sgc-sign-text {
                                font-size: 9pt !important;
                                color: #1C2430;
                            }
                            .sgc-asset-handover-report .sgc-rule-line {
                                border-bottom: 1px solid #1C2430;
                                width: 70%;
                                margin: 12px 0 3px 0;
                            }
                            .sgc-asset-handover-report .sgc-rule-caption {
                                font-size: 7pt !important;
                                color: #5F6775;
                                text-transform: uppercase;
                                letter-spacing: .07em;
                                font-weight: 600;
                            }
                        </style>

                        <h1 class="sgc-doc-title">COMPANY ASSET HANDOVER FORM</h1>

                        <table class="sgc-meta">
                            <tr>
                                <td><span class="sgc-label">Date</span><span class="sgc-value" t-esc="doc_date"/></td>
                                <td><span class="sgc-label">Employee</span><span class="sgc-value" t-esc="o.employee_name"/></td>
                                <td><span class="sgc-label">Position</span><span class="sgc-value" t-esc="o.job_title or '-'"/></td>
                            </tr>
                            <tr>
                                <td><span class="sgc-label">Employee ID</span><span class="sgc-value" t-esc="o.employee_id.id"/></td>
                                <td><span class="sgc-label">Department</span><span class="sgc-value"><t t-if="o.department_id" t-esc="o.department_id.name"/><t t-else="">N/A</t></span></td>
                                <td><span class="sgc-label">Last Working Day</span><span class="sgc-value"><t t-if="o.last_working_day" t-esc="o.last_working_day"/><t t-else="">-</t></span></td>
                            </tr>
                        </table>

                        <div>
                            <p>This document serves to record the return of company property and assets by the employee upon termination of employment, transfer, or leave of absence.</p>
                        </div>

                        <table class="sgc-data">
                            <thead>
                                <tr>
                                    <th style="width: 26%;">Item Description</th>
                                    <th style="width: 17%;">Asset ID/Serial No.</th>
                                    <th style="width: 14%;">Condition</th>
                                    <th style="width: 13%;">Issued Date</th>
                                    <th style="width: 13%;">Returned Date</th>
                                    <th style="width: 17%;">Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="sgc-section">
                                    <td colspan="6"><strong>ELECTRONIC DEVICES</strong></td>
                                </tr>
                                <tr>
                                    <td>Laptop Computer</td>
                                    <td><span t-esc="o.laptop_id or '-'"/></td>
                                    <td><t t-if="o.laptop_condition" t-esc="dict(o._fields['laptop_condition'].selection).get(o.laptop_condition, o.laptop_condition)"/><t t-else="">-</t></td>
                                    <td><t t-if="o.laptop_issued_date" t-esc="o.laptop_issued_date"/><t t-else="">-</t></td>
                                    <td><t t-if="o.laptop_returned_date" t-esc="o.laptop_returned_date"/><t t-else="">-</t></td>
                                    <td><span t-esc="o.laptop_remarks or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Mobile Phone</td>
                                    <td><span t-esc="o.mobile_id or '-'"/></td>
                                    <td><t t-if="o.mobile_condition" t-esc="dict(o._fields['mobile_condition'].selection).get(o.mobile_condition, o.mobile_condition)"/><t t-else="">-</t></td>
                                    <td><t t-if="o.mobile_issued_date" t-esc="o.mobile_issued_date"/><t t-else="">-</t></td>
                                    <td><t t-if="o.mobile_returned_date" t-esc="o.mobile_returned_date"/><t t-else="">-</t></td>
                                    <td><span t-esc="o.mobile_remarks or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Tablet/iPad</td>
                                    <td><span t-esc="o.tablet_id or '-'"/></td>
                                    <td><t t-if="o.tablet_condition" t-esc="dict(o._fields['tablet_condition'].selection).get(o.tablet_condition, o.tablet_condition)"/><t t-else="">-</t></td>
                                    <td><t t-if="o.tablet_issued_date" t-esc="o.tablet_issued_date"/><t t-else="">-</t></td>
                                    <td><t t-if="o.tablet_returned_date" t-esc="o.tablet_returned_date"/><t t-else="">-</t></td>
                                    <td><span t-esc="o.tablet_remarks or '-'"/></td>
                                </tr>
                                <tr class="sgc-section">
                                    <td colspan="6"><strong>ACCESS DEVICES</strong></td>
                                </tr>
                                <tr>
                                    <td>Access Card/Badge</td>
                                    <td><span t-esc="o.access_card_id or '-'"/></td>
                                    <td><t t-if="o.access_card_condition" t-esc="dict(o._fields['access_card_condition'].selection).get(o.access_card_condition, o.access_card_condition)"/><t t-else="">-</t></td>
                                    <td><t t-if="o.access_card_issued_date" t-esc="o.access_card_issued_date"/><t t-else="">-</t></td>
                                    <td><t t-if="o.access_card_returned_date" t-esc="o.access_card_returned_date"/><t t-else="">-</t></td>
                                    <td><span t-esc="o.access_card_remarks or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Key (Office/Building)</td>
                                    <td><span t-esc="o.key_id or '-'"/></td>
                                    <td><t t-if="o.key_condition" t-esc="dict(o._fields['key_condition'].selection).get(o.key_condition, o.key_condition)"/><t t-else="">-</t></td>
                                    <td><t t-if="o.key_issued_date" t-esc="o.key_issued_date"/><t t-else="">-</t></td>
                                    <td><t t-if="o.key_returned_date" t-esc="o.key_returned_date"/><t t-else="">-</t></td>
                                    <td><span t-esc="o.key_remarks or '-'"/></td>
                                </tr>
                                <tr class="sgc-section">
                                    <td colspan="6"><strong>OTHER EQUIPMENT</strong></td>
                                </tr>
                                <tr>
                                    <td>Monitor</td>
                                    <td><span t-esc="o.monitor_id or '-'"/></td>
                                    <td><t t-if="o.monitor_condition" t-esc="dict(o._fields['monitor_condition'].selection).get(o.monitor_condition, o.monitor_condition)"/><t t-else="">-</t></td>
                                    <td><t t-if="o.monitor_issued_date" t-esc="o.monitor_issued_date"/><t t-else="">-</t></td>
                                    <td><t t-if="o.monitor_returned_date" t-esc="o.monitor_returned_date"/><t t-else="">-</t></td>
                                    <td><span t-esc="o.monitor_remarks or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Printer/Scanner</td>
                                    <td><span t-esc="o.printer_id or '-'"/></td>
                                    <td><t t-if="o.printer_condition" t-esc="dict(o._fields['printer_condition'].selection).get(o.printer_condition, o.printer_condition)"/><t t-else="">-</t></td>
                                    <td><t t-if="o.printer_issued_date" t-esc="o.printer_issued_date"/><t t-else="">-</t></td>
                                    <td><t t-if="o.printer_returned_date" t-esc="o.printer_returned_date"/><t t-else="">-</t></td>
                                    <td><span t-esc="o.printer_remarks or '-'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="sgc-sign">
                            <tbody>
                                <tr>
                                    <td style="width: 50%;">
                                        <p class="sgc-sign-title">Received by (Employee)</p>
                                        <div class="sgc-rule-line"></div>
                                        <span class="sgc-rule-caption">Signature</span>
                                        <p class="sgc-sign-text">Name: <span t-esc="o.employee_name"/></p>
                                        <div class="sgc-rule-line"></div>
                                        <span class="sgc-rule-caption">Date</span>
                                    </td>
                                    <td style="width: 50%;">
                                        <p class="sgc-sign-title">Received by (Company Representative)</p>
                                        <div class="sgc-rule-line"></div>
                                        <span class="sgc-rule-caption">Signature</span>
                                        <p class="sgc-sign-text">Name:</p>
                                        <p class="sgc-sign-text">Position:</p>
                                        <div class="sgc-rule-line"></div>
                                        <span class="sgc-rule-caption">Date</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
