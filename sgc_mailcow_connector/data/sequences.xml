<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sgc_employee_document_nda" model="ir.sequence">
            <field name="name">Employee NDA Document</field>
            <field name="code">sgc.employee.document.nda</field>
            <field name="prefix">NDA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_sgc_employee_document_warning" model="ir.sequence">
            <field name="name">Employee Warning Letter Document</field>
            <field name="code">sgc.employee.document.warning_letter</field>
            <field name="prefix">WL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_sgc_employee_document_handover" model="ir.sequence">
            <field name="name">Employee Asset Handover Document</field>
            <field name="code">sgc.employee.document.asset_handover</field>
            <field name="prefix">AH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
