<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_mailcow" model="ir.ui.view">
        <field name="name">hr.employee.form.mailcow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_mailcow_mailboxes" type="object"
                        class="oe_stat_button" icon="fa-envelope"
                        groups="base.group_system">
                    <field name="mailcow_mailbox_count" widget="statinfo" string="Mailbox"/>
                </button>
                <button name="%(action_report_warning_letter)d" type="action"
                        class="oe_stat_button" icon="fa-warning"
                        groups="hr.group_hr_manager"
                        attrs="{'invisible': [('state', '=', 'draft')]}">
                    <field name="id" widget="statinfo" string="Warning Letter"/>
                </button>
                <button name="%(action_report_nda)d" type="action"
                        class="oe_stat_button" icon="fa-file-contract"
                        groups="hr.group_hr_manager"
                        attrs="{'invisible': [('state', '=', 'draft')]}">
                    <field name="id" widget="statinfo" string="NDA"/>
                </button>
                <button name="%(action_report_company_asset_handover)d" type="action"
                        class="oe_stat_button" icon="fa-truck"
                        groups="hr.group_hr_manager"
                        attrs="{'invisible': [('state', '=', 'draft')]}">
                    <field name="id" widget="statinfo" string="Asset Handover"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
