<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="hr_employee_view_form_mailcow" model="ir.ui.view">
        <field name="name">hr.employee.form.mailcow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_mailcow_mailboxes" type="object"
                        class="oe_stat_button" icon="fa-envelope"
                        groups="base.group_system">
                    <field name="mailcow_mailbox_count" widget="statinfo" string="Mailbox"/>
                </button>
                <button name="action_open_employee_documents" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        groups="hr.group_hr_user">
                    <field name="sgc_employee_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
            <!-- Generate actions live in the form header as a single dropdown
                 (next to Print/Send), keeping the employee form clean and minimal. -->
            <xpath expr="//form/header" position="inside">
                <div class="o_dropdown_buttons" groups="hr.group_hr_user">
                    <button name="action_new_document_nda" type="object"
                            string="Generate NDA" class="btn-primary"/>
                    <button name="action_new_document_warning_letter" type="object"
                            string="Warning Letter"/>
                    <button name="action_new_document_asset_handover" type="object"
                            string="Asset Handover"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Documents" name="sgc_documents" groups="hr.group_hr_user">
                    <field name="sgc_employee_document_ids"
                            context="{'default_employee_id': id}">
                        <list string="Documents">
                            <field name="name"/>
                            <field name="doc_type"/>
                            <field name="state" widget="badge"
                                    decoration-info="state == 'draft'"
                                    decoration-warning="state == 'sent'"
                                    decoration-success="state == 'signed'"/>
                            <field name="date"/>
                        </list>
                    </field>
                </page>
                <page string="Warnings" name="sgc_warnings" groups="hr.group_hr_user">
                    <group>
                        <group string="Warning Letter">
                            <field name="warning_letter_date"/>
                            <field name="warning_letter_type"/>
                            <field name="warning_letter_supervisor"/>
                            <field name="warning_letter_improvement_period"/>
                            <field name="warning_letter_reason" nolabel="1" placeholder="Free-text reason for the warning; rendered in place of hardcoded bullets on the PDF"/>
                            <field name="warning_letter_acknowledged"/>
                            <field name="warning_letter_acknowledged_date"
                                   invisible="not warning_letter_acknowledged"/>
                        </group>
                    </group>
                </page>
                <page string="Assets" name="sgc_assets" groups="hr.group_hr_user">
                    <group>
                        <group string="Laptop">
                            <field name="laptop_id"/>
                            <field name="laptop_model"/>
                            <field name="laptop_condition"/>
                            <field name="laptop_issued_date"/>
                            <field name="laptop_returned_date"/>
                            <field name="laptop_estimated_value"/>
                            <field name="laptop_remarks"/>
                        </group>
                        <group string="Mobile Phone">
                            <field name="mobile_id"/>
                            <field name="mobile_model"/>
                            <field name="mobile_condition"/>
                            <field name="mobile_issued_date"/>
                            <field name="mobile_returned_date"/>
                            <field name="mobile_estimated_value"/>
                            <field name="mobile_remarks"/>
                        </group>
                        <group string="Tablet/iPad">
                            <field name="tablet_id"/>
                            <field name="tablet_model"/>
                            <field name="tablet_condition"/>
                            <field name="tablet_issued_date"/>
                            <field name="tablet_returned_date"/>
                            <field name="tablet_estimated_value"/>
                            <field name="tablet_remarks"/>
                        </group>
                        <group string="Access Card">
                            <field name="access_card_id"/>
                            <field name="access_card_model"/>
                            <field name="access_card_condition"/>
                            <field name="access_card_issued_date"/>
                            <field name="access_card_returned_date"/>
                            <field name="access_card_estimated_value"/>
                            <field name="access_card_remarks"/>
                        </group>
                        <group string="Key">
                            <field name="key_id"/>
                            <field name="key_model"/>
                            <field name="key_condition"/>
                            <field name="key_issued_date"/>
                            <field name="key_returned_date"/>
                            <field name="key_estimated_value"/>
                            <field name="key_remarks"/>
                        </group>
                        <group string="Monitor">
                            <field name="monitor_id"/>
                            <field name="monitor_model"/>
                            <field name="monitor_condition"/>
                            <field name="monitor_issued_date"/>
                            <field name="monitor_returned_date"/>
                            <field name="monitor_estimated_value"/>
                            <field name="monitor_remarks"/>
                        </group>
                        <group string="Printer/Scanner">
                            <field name="printer_id"/>
                            <field name="printer_model"/>
                            <field name="printer_condition"/>
                            <field name="printer_issued_date"/>
                            <field name="printer_returned_date"/>
                            <field name="printer_estimated_value"/>
                            <field name="printer_remarks"/>
                        </group>
                    </group>
                </page>
<!-- Removed the redundant Documents &amp; Assets notebook page – all fields live on the document model –
         this declutters the employee form for managers. -->
            </xpath>
        </field>
    </record>

</odoo>