<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mailcow_mailbox_view_list" model="ir.ui.view">
        <field name="name">mailcow.mailbox.list</field>
        <field name="model">mailcow.mailbox</field>
        <field name="arch" type="xml">
            <list string="Mailboxes" decoration-muted="not mailbox_active" decoration-warning="state == 'missing'" decoration-info="state == 'draft'">
                <field name="email"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="quota_used_mb" string="Used (MB)"/>
                <field name="quota_mb" string="Quota (MB)"/>
                <field name="mailbox_active" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'synced'"
                       decoration-warning="state == 'missing'"
                       decoration-info="state == 'draft'"/>
                <field name="last_sync" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mailcow_mailbox_view_form" model="ir.ui.view">
        <field name="name">mailcow.mailbox.form</field>
        <field name="model">mailcow.mailbox</field>
        <field name="arch" type="xml">
            <form string="Mailbox">
                <header>
                    <button name="action_create_in_mailcow" type="object"
                            string="Create in Mailcow" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_push_settings" type="object"
                            string="Push Settings"
                            invisible="state != 'synced'"/>
                    <button name="action_disable_mailbox" type="object"
                            string="Disable Mailbox" class="btn-warning"
                            confirm="Disable this mailbox? Mail is preserved but the employee can no longer log in, send or receive."
                            invisible="state != 'synced' or not mailbox_active"/>
                    <button name="action_enable_mailbox" type="object"
                            string="Enable Mailbox" class="btn-success"
                            invisible="state != 'synced' or mailbox_active"/>
                    <button name="action_sync_now" type="object"
                            string="Sync from Mailcow"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger"
                            invisible="mailbox_active or state == 'draft'"/>
                    <group>
                        <group string="Address">
                            <label for="local_part" string="Email"/>
                            <div class="o_row">
                                <field name="local_part" placeholder="j.doe" readonly="state != 'draft'"/>
                                <span>@</span>
                                <field name="domain" readonly="state != 'draft'"/>
                            </div>
                            <field name="name" placeholder="John Doe"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Mailbox">
                            <field name="password" password="True"
                                   invisible="state != 'draft'"
                                   help="Initial password; cleared after creation."/>
                            <field name="force_pw_update" invisible="state != 'draft'"/>
                            <field name="quota_mb"/>
                            <field name="quota_used_mb" invisible="state == 'draft'"/>
                            <field name="tls_enforce_in"/>
                            <field name="tls_enforce_out"/>
                            <field name="tags" placeholder="sales,dubai"/>
                        </group>
                    </group>
                    <group>
                        <group string="Odoo Provisioning">
                            <field name="provision_smtp" readonly="state != 'draft'"/>
                            <field name="provision_fetchmail" readonly="state != 'draft'"/>
                            <field name="smtp_server_id" invisible="not smtp_server_id"/>
                            <field name="fetchmail_server_id" invisible="not fetchmail_server_id"/>
                        </group>
                        <group string="Sync">
                            <field name="mailbox_active" readonly="1"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mailcow_mailbox_view_search" model="ir.ui.view">
        <field name="name">mailcow.mailbox.search</field>
        <field name="model">mailcow.mailbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="email"/>
                <field name="name"/>
                <field name="employee_id"/>
                <filter string="Enabled" name="enabled" domain="[('mailbox_active', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('mailbox_active', '=', False)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Mailcow" name="synced" domain="[('state', '=', 'synced')]"/>
                <filter string="Missing in Mailcow" name="missing" domain="[('state', '=', 'missing')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mailcow_mailbox" model="ir.actions.act_window">
        <field name="name">Mailcow Mailboxes</field>
        <field name="res_model">mailcow.mailbox</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_synced': 1, 'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first mailbox</p>
            <p>Mailboxes created here are pushed to the Mailcow mail server.
               Run "Sync from Mailcow" to import existing mailboxes.</p>
        </field>
    </record>

    <menuitem id="menu_mailcow_root"
              name="Mailcow"
              parent="base.menu_custom"
              sequence="20"/>
    <menuitem id="menu_mailcow_mailbox"
              name="Mailboxes"
              action="action_mailcow_mailbox"
              parent="menu_mailcow_root"
              sequence="10"/>

</odoo>
