<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="sgc_banne_popup.banner" name="SGC Gamification Banner">
        <t t-call="web.layout">
            <t t-set="head">
                <link rel="stylesheet" href="/sgc_banne_popup/static/src/scss/banner.css"/>
            </t>
            <div class="o_action_manager">
                <div class="sgc-banner-page">
                    <div class="sgc-banner-page__inner">
                        <div class="sgc-banner-page__pool" t-if="price_pool and float(price_pool) > 0">
                            <t t-esc="price_pool"/> AED prize pool
                        </div>
                        <div class="sgc-banner-page__text" t-esc="banner_text or 'Welcome to SGC Gamification! Participate to earn rewards.'"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
