<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sgc_banne_popup.Banner">
        <div class="o_sgc_popup_overlay" t-if="state.visible" role="dialog" aria-modal="true">
            <div class="o_sgc_popup_card">
                <button class="o_sgc_popup_close" t-on-click="close" aria-label="Close">×</button>
                <div class="o_sgc_popup_brand">
                    <span class="o_sgc_popup_brand_mark">SGC</span>
                    <span class="o_sgc_popup_brand_full">GAMIFICATION</span>
                </div>
                <div class="o_sgc_popup_pool" t-if="state.pricePool > 0">
                    <t t-esc="state.pricePool"/> AED prize pool
                </div>
                <div class="o_sgc_popup_text" t-esc="state.bannerText"/>
                <button class="o_sgc_popup_confirm" t-on-click="close">Got it</button>
            </div>
        </div>
    </t>
</templates>
