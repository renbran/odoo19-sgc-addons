<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kartatap_entitlement_event_list" model="ir.ui.view">
        <field name="name">kartatap.entitlement.event.list</field>
        <field name="model">kartatap.entitlement.event</field>
        <field name="arch" type="xml">
            <list create="false" delete="false"
                  decoration-success="state == 'sent'"
                  decoration-warning="state == 'pending' and attempts &gt; 0"
                  decoration-danger="state in ('rejected', 'dead')">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="kartatap_company_id"/>
                <field name="order_id"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="last_error"/>
                <field name="next_attempt_at"/>
                <field name="sent_at"/>
            </list>
        </field>
    </record>

    <record id="view_kartatap_entitlement_event_form" model="ir.ui.view">
        <field name="name">kartatap.entitlement.event.form</field>
        <field name="model">kartatap.entitlement.event</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_retry" type="object" string="Re-queue"
                            invisible="state not in ('rejected', 'dead')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="event_id"/>
                        <field name="event_type"/>
                        <field name="kartatap_company_id"/>
                        <field name="order_id"/>
                        <field name="attempts"/>
                        <field name="last_status_code"/>
                        <field name="last_error"/>
                        <field name="next_attempt_at"/>
                        <field name="sent_at"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kartatap_entitlement_event" model="ir.actions.act_window">
        <field name="name">KartaTap entitlement events</field>
        <field name="res_model">kartatap.entitlement.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kartatap_entitlement_event"
              name="KartaTap Entitlement Events"
              parent="base.menu_custom"
              action="action_kartatap_entitlement_event"
              groups="base.group_system"
              sequence="90"/>

</odoo>
