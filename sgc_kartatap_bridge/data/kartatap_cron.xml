<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo -> KartaTap entitlement feed: reconcile KartaTap orders into signed
             events, then deliver what is due. A no-op unless
             sgc_kartatap_bridge.entitlement_push_enabled is True and a signing secret
             is configured. -->
        <record id="cron_kartatap_entitlement_push" model="ir.cron">
            <field name="name">KartaTap: push entitlement events</field>
            <field name="model_id" ref="model_kartatap_entitlement_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
