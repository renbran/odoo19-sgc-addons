<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_weekly_gate_review" model="ir.cron">
            <field name="name">SGC Sales Playbook: Weekly Pipeline Gate Review</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_weekly_gate_review()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Defaults to dry-run/log-only via the
             sgc_sales_playbook.dead_lead_cleanup_mode config parameter (see
             crm_lead.py::_cron_dead_lead_cleanup). Safe to leave active. -->
        <record id="ir_cron_dead_lead_cleanup" model="ir.cron">
            <field name="name">SGC Sales Playbook: Dead-Lead Cleanup (dry-run by default)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_dead_lead_cleanup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
