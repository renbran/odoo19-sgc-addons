<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        SGC TECH AI — Premium Cream / Navy / Gold Sale Order, Quotation
        and Pro-Forma Invoice Report
        ================================================================
        ARCHITECTURE: INHERITS the standard Odoo template using targeted
        xpath operations. Does NOT replace the full template, so that
        standard modules (sale_stock, sale_margin, etc.) can still locate
        their named elements via xpath.

        Priority 99 ensures this renders AFTER all standard inheritors.

        Palette (standardized on the sgc_report_theme_core token values):
            ivory      #FAF7F0   page background
            navy       #0B1F3A   headings / table header / footer band
            gold       #B8912F   hairlines / dividers / badge accents
            charcoal   #22262B   body text
            slate      #4B5563   muted / secondary text
            champagne  #E8DCC4   subtle row dividers
            parchment  #F1EADD   terms box / badge fill
    -->
    <template id="report_saleorder_professional"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <!-- ═══════════════════════════════════════════════
             1. INJECT SGC STYLES into <div class="page">
             ═══════════════════════════════════════════════ -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <style type="text/css">
                /* ============================================================
                   SGC TECH AI — Premium Report Styles v6.0 (cream/navy/gold)
                   wkhtmltopdf-safe: NO gradients, NO flexbox
                   ============================================================ */
                .page { font-family: 'Lato', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important; color: #22262B; font-size: 10px; line-height: 1.55; background-color: #FAF7F0; }

                /* ── Letterhead ── */
                .sgc-letterhead { padding-bottom: 10px; page-break-inside: avoid; }
                .sgc-letterhead table { width: 100%; border: none; border-collapse: collapse; }
                .sgc-letterhead table td { padding: 0; border: none; vertical-align: top; }
                .sgc-brand-name { font-family: 'Georgia', 'Times New Roman', serif; font-size: 22px; font-weight: 700; letter-spacing: 0.5px; color: #0B1F3A; margin: 0; }
                .sgc-brand-tagline { font-size: 8.5px; color: #B8912F; letter-spacing: 2px; text-transform: uppercase; margin-top: 2px; font-weight: 700; }
                .sgc-logo-img { max-height: 50px; max-width: 130px; margin-right: 10px; }
                .sgc-company-contact { text-align: right; font-size: 9px; color: #4B5563; line-height: 1.7; }
                .sgc-company-contact .line1 { font-weight: 700; color: #0B1F3A; font-size: 10px; margin-bottom: 2px; }

                /* ── Hairline ── */
                .sgc-hairline { border-bottom: 1.5px solid #B8912F; margin-bottom: 16px; }

                /* ── Document title ── */
                .sgc-doc-title-wrap { text-align: center; margin-bottom: 16px; page-break-inside: avoid; }
                .sgc-doc-title { font-family: 'Georgia', 'Times New Roman', serif; font-size: 24px; font-weight: 700; color: #0B1F3A; letter-spacing: 1px; text-transform: uppercase; margin: 0; }
                .sgc-doc-rule { text-align: center; margin: 8px 0; }
                .sgc-doc-rule .l { display: inline-block; vertical-align: middle; width: 70px; height: 1px; background-color: #B8912F; }
                .sgc-doc-rule .d { display: inline-block; vertical-align: middle; width: 5px; height: 5px; margin: 0 8px; background-color: #B8912F; }
                .sgc-doc-number { font-size: 11px; color: #4B5563; font-weight: 600; letter-spacing: 0.5px; }

                /* ── Meta grid (replaces standard #informations styling) ── */
                #informations { margin-bottom: 16px; page-break-inside: avoid; }
                #informations > div.col { background-color: #F1EADD; border: 1px solid #B8912F; border-radius: 3px; padding: 6px 10px !important; margin: 0 3px; }
                #informations > div.col > strong { font-size: 7px !important; text-transform: uppercase; letter-spacing: 1.2px; color: #B8912F !important; font-weight: 700; display: block; margin-bottom: 1px; }
                #informations > div.col > div { font-size: 10px; font-weight: 600; color: #0B1F3A; }

                /* ── Bill To (plain, no card) ── */
                .sgc-bill-to { margin-bottom: 16px; page-break-inside: avoid; }
                .sgc-bill-to-label { font-size: 8px; text-transform: uppercase; letter-spacing: 1.5px; color: #B8912F; font-weight: 700; margin-bottom: 4px; }
                .sgc-bill-to-name { font-size: 12px; font-weight: 700; color: #0B1F3A; margin-bottom: 2px; }
                .sgc-bill-to-details { font-size: 10px; color: #22262B; line-height: 1.5; }
                .sgc-bill-to-vat { font-size: 9px; color: #4B5563; margin-top: 3px; }
                .sgc-bill-to table { width: 100%; border: none; border-collapse: collapse; }
                .sgc-bill-to table td { border: none; padding: 0; vertical-align: top; }

                /* ── Main Table ── */
                .o_main_table { font-size: 10px !important; border-collapse: collapse !important; }
                .o_main_table thead tr th { background-color: #0B1F3A !important; color: #FAF7F0 !important; padding: 8px 8px !important; font-size: 8px !important; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; border: none !important; }
                .o_main_table tbody td { font-size: 10px; padding: 6px 8px !important; border-bottom: 1px solid #E8DCC4; vertical-align: top; line-height: 1.4; }

                /* ── Sections ── */
                tr.fw-bolder.o_line_section td { background-color: #0B1F3A !important; color: #FAF7F0 !important; font-weight: 700; font-size: 10.5px; padding: 7px 8px !important; border: none !important; border-top: 2px solid #B8912F !important; }
                tr.fw-bold.o_line_subsection td { background-color: #F1EADD !important; color: #0B1F3A; font-weight: 600; font-size: 10px; padding: 6px 8px !important; border: none !important; border-left: 3px solid #B8912F !important; }
                tr.o_line_note td { font-style: italic; color: #4B5563; padding: 3px 8px 3px 16px !important; font-size: 9px; border-bottom: 1px solid #F1EADD !important; }
                .sgc-no-charge { display: inline-block; background-color: #0B1F3A; color: #FAF7F0; font-size: 7px; font-weight: 700; padding: 1px 5px; border-radius: 3px; letter-spacing: 0.5px; text-transform: uppercase; }
                .sgc-discount-badge { display: inline-block; background-color: #B8912F; color: #FAF7F0; font-size: 7px; font-weight: 700; padding: 1px 4px; border-radius: 3px; }
                .sgc-subtotal-col { font-weight: 700; color: #0B1F3A; }

                /* ── Striped table override ── */
                .o_table_striped .o_main_table tbody tr:nth-child(odd) td,
                .o_table_striped .o_main_table tbody tr:nth-child(even) td { background-color: transparent !important; }
                .o_table_striped .o_main_table tbody tr.fw-bolder.o_line_section td { background-color: #0B1F3A !important; color: #FAF7F0 !important; border-top: 2px solid #B8912F !important; }
                .o_table_striped .o_main_table tbody tr.fw-bold.o_line_subsection td { background-color: #F1EADD !important; border-left: 3px solid #B8912F !important; }

                /* ── Totals ── */
                div[name="so_total_summary"] { page-break-inside: avoid; margin-top: 4px; }
                .o_total_table { font-size: 10px; }
                .o_total_table td { padding: 3px 8px !important; }
                .o_total_table tr:last-child td { font-weight: 800; font-size: 13px; border-top: 2px solid #B8912F !important; color: #0B1F3A; padding-top: 6px !important; }

                /* ── Signature ── */
                div[name="signature"] { page-break-inside: avoid; }
                .sgc-sig-label { font-size: 7.5px; text-transform: uppercase; letter-spacing: 1px; color: #B8912F; font-weight: 700; margin-bottom: 5px; }
                .sgc-sig-name  { font-weight: 600; color: #0B1F3A; font-size: 10px; }
                .sgc-sig-company { font-size: 8.5px; color: #4B5563; margin-top: 1px; }

                /* ── Terms ── */
                .sgc-terms-box { background-color: #F1EADD; border: 1px solid #B8912F; border-radius: 4px; padding: 10px 14px; margin-top: 12px; font-size: 9px; color: #4B5563; line-height: 1.45; page-break-inside: avoid; }
                .sgc-terms-label { color: #0B1F3A; font-size: 7.5px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; }

                /* ── Footer band ── */
                .sgc-footer-band { text-align: center; margin-top: 16px; padding-top: 10px; border-top: 1.5px solid #B8912F; page-break-inside: avoid; }
                .sgc-footer-company { font-size: 9px; font-weight: 700; color: #0B1F3A; letter-spacing: 0.3px; }
                .sgc-footer-address { font-size: 8px; color: #4B5563; margin-top: 2px; }
                .sgc-footer-tagline { font-size: 7px; letter-spacing: 3px; text-transform: uppercase; color: #B8912F; font-weight: 700; margin-top: 5px; }

                /* ── Page-break control ── */
                tr.fw-bolder.o_line_section { page-break-after: avoid !important; }
                tr.fw-bolder.o_line_section + tr { page-break-before: avoid !important; }
                tr.fw-bold.o_line_subsection { page-break-after: avoid !important; }
                tr.fw-bold.o_line_subsection + tr { page-break-before: avoid !important; }
            </style>
        </xpath>

        <!-- ═══════════════════════════════════════════════
             2. SUPPRESS the standard layout_document_title
                (rendered inside our own doc-title block instead)
             ═══════════════════════════════════════════════ -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title" t-value="''"/>
        </xpath>

        <!-- ═══════════════════════════════════════════════
             3. SUPPRESS the standard address block
                (rendered inside our own Bill To block instead)
             ═══════════════════════════════════════════════ -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address" t-value="''"/>
        </xpath>

        <!-- ═══════════════════════════════════════════════
             4. INJECT LETTERHEAD + TITLE + BILL TO
                before #informations
             ═══════════════════════════════════════════════ -->
        <xpath expr="//div[@id='informations']" position="before">
            <!-- ═══════ LETTERHEAD ═══════ -->
            <div class="sgc-letterhead">
                <table><tr>
                    <td style="width:55%;">
                        <table><tr>
                            <td style="width:auto; padding-right:0;">
                                <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" class="sgc-logo-img" alt="Company Logo"/>
                            </td>
                            <td>
                                <div class="sgc-brand-name"><span t-field="doc.company_id.name"/></div>
                                <div class="sgc-brand-tagline">Finance &#183; System &#183; Technology</div>
                            </td>
                        </tr></table>
                    </td>
                    <td style="width:45%;" class="sgc-company-contact">
                        <div class="line1"><span t-field="doc.company_id.name"/></div>
                        <div t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        <div>
                            <t t-if="doc.company_id.phone">T: <span t-field="doc.company_id.phone"/></t>
                            <t t-if="doc.company_id.phone and doc.company_id.email"> &#183; </t>
                            <t t-if="doc.company_id.email">E: <span t-field="doc.company_id.email"/></t>
                        </div>
                        <div t-if="doc.company_id.website">W: <span t-field="doc.company_id.website"/></div>
                    </td>
                </tr></table>
            </div>
            <!-- ═══════ HAIRLINE ═══════ -->
            <div class="sgc-hairline"/>
            <!-- ═══════ DOCUMENT TITLE ═══════ -->
            <div class="sgc-doc-title-wrap">
                <div class="sgc-doc-title">
                    <t t-if="is_proforma">Pro-Forma Invoice</t>
                    <t t-elif="doc.state in ['draft','sent']">Quotation</t>
                    <t t-else="">Sales Order</t>
                </div>
                <div class="sgc-doc-rule"><span class="l"/><span class="d"/><span class="l"/></div>
                <div class="sgc-doc-number"><span t-field="doc.name"/></div>
            </div>
            <!-- ═══════ BILL TO ═══════ -->
            <div class="sgc-bill-to">
                <table><tr>
                    <td style="width:50%; padding-right:12px;">
                        <div class="sgc-bill-to-label">Bill To</div>
                        <div class="sgc-bill-to-name" t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'/>
                        <div class="sgc-bill-to-details" t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        <div t-if="doc.partner_id.vat" class="sgc-bill-to-vat">
                            <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                            <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
                        </div>
                    </td>
                    <t t-if="doc.partner_shipping_id != doc.partner_id">
                        <td style="width:50%; padding-left:12px; border-left:1px solid #E8DCC4;">
                            <div class="sgc-bill-to-label">
                                <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">Invoicing / Shipping</t>
                                <t t-else="">Shipping To</t>
                            </div>
                            <div class="sgc-bill-to-name" t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'/>
                            <div class="sgc-bill-to-details" t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
                        </td>
                    </t>
                </tr></table>
            </div>
        </xpath>

        <!-- ═══════════════════════════════════════════════
             5. REPLACE the standard signature block
             ═══════════════════════════════════════════════ -->
        <xpath expr="//div[@name='signature']" position="replace">
            <div t-if="doc.signature" class="mt-3" name="signature" style="page-break-inside:avoid;">
                <table style="width:100%; border:none; border-collapse:collapse;"><tr>
                    <td style="width:50%; border:none; padding:0;"/>
                    <td style="width:50%; border:none; padding:0; text-align:center;">
                        <div class="sgc-sig-label">Authorized Signature</div>
                        <div style="border-bottom:1px solid #B8912F; padding-bottom:5px; margin-bottom:5px; display:inline-block;">
                            <img t-att-src="image_data_uri(doc.signature)" style="max-height:3cm; max-width:7cm;"/>
                        </div>
                        <div class="sgc-sig-name"><span t-field="doc.signed_by"/></div>
                        <div class="sgc-sig-company"><span t-field="doc.partner_id.name"/></div>
                    </td>
                </tr></table>
            </div>
        </xpath>

        <!-- ═══════════════════════════════════════════════
             6. REPLACE order_note with SGC hardcoded T&C
             ═══════════════════════════════════════════════ -->
        <xpath expr="//span[@name='order_note']" position="replace">
            <span name="order_note">
                <div class="sgc-terms-box">
                    <div class="sgc-terms-label" style="margin-bottom:6px;">Terms &amp; Conditions — SGC TECH AI</div>
                    <div style="font-size:9px; color:#22262B; line-height:1.55; text-align:justify; text-justify:inter-word;">
                        <strong>1. Support &amp; Maintenance</strong><br/>
                        All services include <strong>two (2) months</strong> of complimentary technical support and free bug-fixing from the date of delivery or activation, whichever is earlier. Support covers troubleshooting, configuration adjustments, and resolution of defects directly related to the delivered scope of work.
                        <br/><br/>
                        <strong>2. Training &amp; Documentation</strong><br/>
                        The client shall receive access to <strong>training videos</strong> and documentation relevant to the delivered solution. Videos are provided digitally and remain accessible for the duration of the active service period.
                        <br/><br/>
                        <strong>3. Cancellation Policy</strong><br/>
                        Either party may terminate the service by providing <strong>thirty (30) calendar days</strong> written notice prior to the intended cancellation date. Cancellation requests must be submitted in writing via email to the designated account representative. Services rendered up to the cancellation effective date shall be billed in full.
                        <br/><br/>
                        <strong>4. General</strong><br/>
                        All amounts are due as per the payment terms stated on this document. Late payments may be subject to applicable interest charges under the governing jurisdiction. This document constitutes a binding agreement upon acceptance or payment.
                    </div>
                </div>
            </span>
        </xpath>

        <!-- ═══════════════════════════════════════════════
             7. ADD SGC FOOTER BAND at the end of page
             ═══════════════════════════════════════════════ -->
        <xpath expr="//div[hasclass('page')]/div[hasclass('oe_structure')][last()]" position="after">
            <div class="sgc-footer-band">
                <div class="sgc-footer-company"><span t-field="doc.company_id.name"/></div>
                <div class="sgc-footer-address" t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                <div class="sgc-footer-tagline">Powered by Artificial Intelligence</div>
            </div>
        </xpath>

    </template>
</odoo>
