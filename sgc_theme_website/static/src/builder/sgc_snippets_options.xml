<!--
    Builder-option panels for the SGC snippets (Odoo 19 html_builder OWL
    components). Only built-in actions are used: classAction, dataAttributeAction
    and styleAction. Builder components (BuilderRow/BuilderSelect/... ) are
    globally available inside option templates, so no XML imports are required.
-->
<templates xml:space="preserve">

    <!-- 1. Hero -->
    <t t-name="sgc_theme_website.SgcHeroOption">
        <BuilderRow label.translate="Background">
            <BuilderSelect>
                <BuilderSelectItem classAction="''">Cream</BuilderSelectItem>
                <BuilderSelectItem classAction="'sgc-hero--navy'">Navy</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
        <BuilderRow label.translate="Text alignment">
            <BuilderSelect>
                <BuilderSelectItem classAction="'text-start'">Left</BuilderSelectItem>
                <BuilderSelectItem classAction="'text-center'">Center</BuilderSelectItem>
                <BuilderSelectItem classAction="'text-end'">Right</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </t>

    <!-- 2. Gold-hexagon feature grid -->
    <t t-name="sgc_theme_website.SgcFeatureHexOption">
        <BuilderRow label.translate="Columns">
            <BuilderSelect applyTo="'.s_sgc_feature_grid'">
                <BuilderSelectItem classAction="'row-cols-1 row-cols-md-2'">2</BuilderSelectItem>
                <BuilderSelectItem classAction="'row-cols-1 row-cols-md-3'">3</BuilderSelectItem>
                <BuilderSelectItem classAction="'row-cols-1 row-cols-md-4'">4</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
        <BuilderRow label.translate="Hover lift">
            <BuilderCheckbox classAction="'sgc-hex-hover'"/>
        </BuilderRow>
    </t>

    <!-- 3. KPI / stat counters -->
    <t t-name="sgc_theme_website.SgcStatsOption">
        <BuilderRow label.translate="Animate count-up">
            <BuilderCheckbox dataAttributeAction="'sgcAnimate'" dataAttributeActionValue="'true'"/>
        </BuilderRow>
    </t>

    <!-- 4. Testimonial -->
    <t t-name="sgc_theme_website.SgcTestimonialOption">
        <BuilderRow label.translate="Layout">
            <BuilderSelect>
                <BuilderSelectItem classAction="''">Single</BuilderSelectItem>
                <BuilderSelectItem classAction="'sgc-testimonial--grid'">Grid</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </t>

    <!-- 5. CTA band -->
    <t t-name="sgc_theme_website.SgcCtaOption">
        <BuilderRow label.translate="Background">
            <BuilderSelect>
                <BuilderSelectItem classAction="''">Navy</BuilderSelectItem>
                <BuilderSelectItem classAction="'sgc-cta--gold'">Gold</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </t>

    <!-- 6. Image / mockup showcase -->
    <t t-name="sgc_theme_website.SgcShowcaseOption">
        <BuilderRow label.translate="Media side">
            <BuilderSelect applyTo="'.row'">
                <BuilderSelectItem classAction="''">Left</BuilderSelectItem>
                <BuilderSelectItem classAction="'flex-row-reverse'">Right</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
        <BuilderRow label.translate="3D tilt">
            <BuilderCheckbox classAction="'s_sgc_tilt'" applyTo="'.s_sgc_showcase_media'"/>
        </BuilderRow>
    </t>

    <!-- 7. Footer -->
    <t t-name="sgc_theme_website.SgcFooterOption">
        <BuilderRow label.translate="Show contact column">
            <BuilderCheckbox classAction="'sgc-footer--contact'"/>
        </BuilderRow>
    </t>

