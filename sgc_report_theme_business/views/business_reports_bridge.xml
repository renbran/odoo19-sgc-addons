<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Wave 2 bridge: re-points 9 stock-external_layout business report
    templates onto sgc_report_theme_core.external_layout_sgc.

    Each patch changes ONLY the t-call target attribute - no t-esc/
    t-field value expression is touched anywhere, preserving numeric
    fidelity. t-call is a plain XML attribute (unlike t-attf-class).

    The XPath matches the layout call by NAME PATTERN, not by the exact
    literal "web.external_layout". Another module may inherit the same
    report template and rewrite that call first - account_edi_ubl_cii
    (core Odoo 19, UAE e-invoicing) does exactly that on
    account.report_invoice_document with primary="True", so it is applied
    before this extension view and the literal value is already gone.
    Matching the literal made this module fail with "Element '<xpath
    expr=...>' cannot be located in parent view", which aborts the whole
    registry load and takes the database down. The pattern matches
    exactly one element per template ("web.html_container" does not
    contain "layout", so it is never caught).
-->

    <template id="report_sale_agreement_sgc"
              inherit_id="sale_agreement_report.report_sale_agreement"
              priority="99">
        <xpath expr="//t[contains(@t-call,'external_layout') or contains(@t-call,'internal_layout')]" position="attributes">
            <attribute name="t-call">sgc_report_theme_core.external_layout_sgc</attribute>
        </xpath>
    </template>

