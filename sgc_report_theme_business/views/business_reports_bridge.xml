<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Wave 2 bridge: re-points 9 stock-external_layout business report
    templates onto sgc_report_theme_core.external_layout_sgc.

    Each patch changes ONLY the t-call target attribute - no t-esc/
    t-field value expression is touched anywhere, preserving numeric
    fidelity. t-call is a plain XML attribute (unlike t-attf-class).

    Every template here also keeps a HIDDEN ANCHOR: a web.external_layout
    call inside a t-if="False" holder. It renders nothing and exists only
    so that a module which rewrites the same layout call with a LITERAL
    XPath still finds its target - account_edi_ubl_cii (core Odoo 19, UAE
    e-invoicing) does exactly that on account.report_invoice_document.
    Odoo combines extensions before primaries, so without the anchor the
    core module's literal XPath can no longer be satisfied and the whole
    registry load fails, taking the database down.
-->

    <template id="report_sale_agreement_sgc"
              inherit_id="sale_agreement_report.report_sale_agreement"
              priority="99">
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">sgc_report_theme_core.external_layout_sgc</attribute>
        </xpath>

        <xpath expr="//t[@t-call='sgc_report_theme_core.external_layout_sgc']" position="after">
            <t t-if="False"><t t-call="web.external_layout"/></t>
        </xpath>
    </template>

