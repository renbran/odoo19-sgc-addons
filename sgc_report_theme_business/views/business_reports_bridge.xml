<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Wave 2 bridge: re-points 9 stock-external_layout business report
    templates onto sgc_report_theme_core.external_layout_sgc.

    Each patch changes ONLY the t-call target attribute - no t-esc/
    t-field value expression is touched anywhere, preserving numeric
    fidelity. t-call is a plain XML attribute (unlike t-attf-class), so
    a direct exact-match XPath is correct here (same pattern proven
    working on the statement_report bridge).
-->

    <template id="report_sale_agreement_sgc"
              inherit_id="sale_agreement_report.report_sale_agreement">
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">sgc_report_theme_core.external_layout_sgc</attribute>
        </xpath>
    </template>

    <template id="report_sale_agreement_yearly_sgc"
              inherit_id="sale_agreement_report.report_sale_agreement_yearly">
