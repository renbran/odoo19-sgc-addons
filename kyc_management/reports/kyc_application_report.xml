<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="kyc_application_report_template" model="ir.actions.report">
            <field name="name">KYC Application Report</field>
            <field name="model">kyc.application</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">kyc_management.report_kyc_application</field>
            <field name="report_file">kyc_management.report_kyc_application</field>
            <field name="print_report_name">'KYC_Application_%s' % object.kyc_id</field>
        </record>

        <!--
            KYC Application PDF.
            - Layout: web.external_layout (company logo, address, footer with page numbers).
            - All visible strings are translatable.
            - No hardcoded company name, status badges, or warning text — pulled from
              company record, selection fields, or translation terms.
        -->
        <template id="report_kyc_application">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="company" t-value="request.env.company"/>

                    <t t-call="web.external_layout">
                        <div class="page kyc_report_page">

                            <!-- Status + ID header (rendered inside the global layout body) -->
                            <div class="kyc_status_bar clearfix mb-3">
                                <div class="float-start">
                                    <strong t-esc="o.kyc_id"/>
                                </div>
                                <div class="float-end">
                                    <span t-attf-class="kyc_status_badge kyc_status_#{o.state}">
                                        <t t-esc="dict(o._fields['state'].selection).get(o.state, '').upper()"/>
                                    </span>
                                </div>
                            </div>

                            <!-- Personal & Identification -->
                            <h4 class="kyc_section_title">Personal &amp; Identification</h4>
                            <table class="table table-sm kyc_info_table">
                                <tbody>
                                    <tr>
                                        <td class="kyc_label">Full Name</td>
                                        <td class="kyc_value">
                                            <t t-esc="o.first_name or ''"/> <t t-esc="o.last_name or ''"/>
                                        </td>
                                        <td class="kyc_label">Date of Birth</td>
                                        <td class="kyc_value">
                                            <t t-esc="o.date_of_birth and o.date_of_birth.strftime('%B %d, %Y') or ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_label">Email</td>
                                        <td class="kyc_value"><t t-esc="o.email or ''"/></td>
                                        <td class="kyc_label">Phone</td>
                                        <td class="kyc_value"><t t-esc="o.phone or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_label">Gender</td>
                                        <td class="kyc_value">
                                            <t t-esc="dict(o._fields['gender'].selection or []).get(o.gender, '')"/>
                                        </td>
                                        <td class="kyc_label">Nationality</td>
                                        <td class="kyc_value">
                                            <t t-esc="o.nationality_id.name if o.nationality_id else ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_label">Passport No</td>
                                        <td class="kyc_value"><t t-esc="o.passport_number or ''"/></td>
                                        <td class="kyc_label">Passport Validity</td>
                                        <td class="kyc_value">
                                            <span t-if="o.is_passport_valid" class="text-success">Valid</span>
                                            <span t-else="" class="text-danger">Expired</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_label">Emirates ID</td>
                                        <td class="kyc_value"><t t-esc="o.emirates_id or ''"/></td>
                                        <td class="kyc_label">Passport Issue / Expiry</td>
                                        <td class="kyc_value">
                                            <t t-esc="o.passport_issue_date and o.passport_issue_date.strftime('%b %d, %Y') or ''"/>
                                            <t t-if="o.passport_issue_date and o.passport_expiry_date"> &#8594; </t>
                                            <t t-esc="o.passport_expiry_date and o.passport_expiry_date.strftime('%b %d, %Y') or ''"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Residential Address -->
                            <h4 class="kyc_section_title">Residential Address</h4>
                            <table class="table table-sm kyc_info_table">
                                <tbody>
                                    <tr>
                                        <td class="kyc_label">Address</td>
                                        <td colspan="3" class="kyc_value">
                                            <t t-out="o.residential_address or ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_label">City</td>
                                        <td class="kyc_value"><t t-out="o.residential_city or ''"/></td>
                                        <td class="kyc_label">State / Emirate</td>
                                        <td class="kyc_value"><t t-out="o.residential_state or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_label">Country</td>
                                        <td class="kyc_value">
                                            <t t-esc="o.residential_country_id.name if o.residential_country_id else ''"/>
                                        </td>
                                        <td class="kyc_label">Postal Code</td>
                                        <td class="kyc_value"><t t-out="o.residential_postal_code or ''"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Employment -->
                            <h4 class="kyc_section_title">Employment Details</h4>
                            <table class="table table-sm kyc_info_table">
                                <tbody>
                                    <tr>
                                        <td class="kyc_label">Employment Status</td>
                                        <td class="kyc_value">
                                            <t t-esc="dict(o._fields['employment_status'].selection or []).get(o.employment_status, '')"/>
                                        </td>
                                        <td class="kyc_label">Occupation</td>
                                        <td class="kyc_value"><t t-esc="o.occupation or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_label">Employer</td>
                                        <td class="kyc_value"><t t-esc="o.employer_name or ''"/></td>
                                        <td class="kyc_label">Years in Role</td>
                                        <td class="kyc_value">
                                            <t t-esc="o.years_in_role"/> <span t-if="o.years_in_role">years</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Financial -->
                            <h4 class="kyc_section_title">Financial Information</h4>
                            <table class="table table-sm kyc_info_table">
                                <tbody>
                                    <tr>
                                        <td class="kyc_label">Annual Income</td>
                                        <td class="kyc_value">
                                            <t t-esc="'{:,.2f}'.format(o.annual_income or 0)"/>
                                            <t t-esc=" ' ' + (o.currency_id.name if o.currency_id else '')"/>
                                        </td>
                                        <td class="kyc_label">Purpose</td>
                                        <td class="kyc_value">
                                            <t t-esc="dict(o._fields['purpose_of_transaction'].selection or []).get(o.purpose_of_transaction, '')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_label">Payment Method</td>
                                        <td class="kyc_value">
                                            <t t-esc="dict(o._fields['payment_method'].selection or []).get(o.payment_method, '')"/>
                                        </td>
                                        <td class="kyc_label">Source of Funds</td>
                                        <td class="kyc_value">
                                            <t t-esc="', '.join(o.source_of_funds_ids.mapped('name')) if o.source_of_funds_ids else ''"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Risk Assessment -->
                            <h4 class="kyc_section_title">Risk Assessment</h4>
                            <div t-if="o.politically_exposed_person == 'yes'" class="alert alert-warning kyc_alert" role="alert">
                                <strong>Politically Exposed Person (PEP)</strong>
                                <div t-if="o.pep_details" class="mt-2">
                                    <t t-esc="o.pep_details"/>
                                </div>
                            </div>
                            <div t-else="" class="text-success kyc_ok">
                                Not a Politically Exposed Person
                            </div>

                            <!-- Consents -->
                            <h4 class="kyc_section_title">Consents &amp; Agreements</h4>
                            <table class="table table-sm kyc_consent_table">
                                <tbody>
                                    <tr>
                                        <td class="kyc_consent_cell">
                                            <span t-if="o.consent_terms_conditions" class="text-success">Yes</span>
                                            <span t-else="" class="text-danger">No</span>
                                            Terms and Conditions
                                        </td>
                                        <td class="kyc_consent_cell">
                                            <span t-if="o.consent_privacy_policy" class="text-success">Yes</span>
                                            <span t-else="" class="text-danger">No</span>
                                            Privacy Policy
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="kyc_consent_cell">
                                            <span t-if="o.consent_data_processing" class="text-success">Yes</span>
                                            <span t-else="" class="text-danger">No</span>
                                            Data Processing
                                        </td>
                                        <td class="kyc_consent_cell">
                                            <span t-if="o.consent_aml_kyc" class="text-success">Yes</span>
                                            <span t-else="" class="text-danger">No</span>
                                            AML / KYC Verification
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Applicant Signature -->
                            <h4 class="kyc_section_title">Applicant Signature and Declaration</h4>
                            <p class="kyc_declaration">I hereby certify that the information provided is true and complete. False information may result in legal consequences.</p>
                            <div class="kyc_signature_box">
                                <img t-if="o.signature_image" t-att-src="image_data_uri(o.signature_image)" alt="Applicant Signature"/>
                                <p t-else="" class="text-muted small m-0">Signature not captured</p>
                            </div>
                            <table class="table table-sm kyc_sig_meta">
                                <tbody>
                                    <tr>
                                        <td class="kyc_label">Signed By</td>
                                        <td class="kyc_value"><t t-esc="(o.first_name or '') + ' ' + (o.last_name or '')"/></td>
                                        <td class="kyc_label">Date</td>
                                        <td class="kyc_value"><t t-esc="o.signature_timestamp and o.signature_timestamp.strftime('%B %d, %Y') or ''"/></td>
                                        <td class="kyc_label">Location</td>
                                        <td class="kyc_value"><t t-esc="o.signature_location or ''"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Approval -->
                            <div t-if="o.state == 'approved'">
                                <h4 class="kyc_section_title">Approval Authorization</h4>
                                <p class="kyc_declaration">Approved by an authorized representative of <t t-esc="company.name"/>.</p>
                                <div class="kyc_signature_box">
                                    <img t-if="o.approver_signature" t-att-src="image_data_uri(o.approver_signature)" alt="Approver Signature"/>
                                    <p t-else="" class="text-muted small m-0">Signature not captured</p>
                                </div>
                                <table class="table table-sm kyc_sig_meta">
                                    <tbody>
                                        <tr>
                                            <td class="kyc_label">Approved By</td>
                                            <td class="kyc_value"><t t-esc="o.approver_id.name if o.approver_id else ''"/></td>
                                            <td class="kyc_label">Date</td>
                                            <td class="kyc_value"><t t-esc="o.approval_date and o.approval_date.strftime('%B %d, %Y') or ''"/></td>
                                            <td class="kyc_label">Status</td>
                                            <td class="kyc_value">Approved</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Rejection -->
                            <div t-if="o.state == 'rejected'" class="kyc_rejection_block">
                                <h4 class="kyc_section_title">Rejection Details</h4>
                                <table class="table table-sm kyc_info_table">
                                    <tbody>
                                        <tr>
                                            <td class="kyc_label">Reason</td>
                                            <td colspan="3" class="kyc_value"><t t-esc="o.rejection_reason or ''"/></td>
                                        </tr>
                                        <tr>
                                            <td class="kyc_label">Recommendations</td>
                                            <td colspan="3" class="kyc_value"><t t-esc="o.rejection_suggestions or ''"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
