<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_outreach" model="ir.ui.view">
        <field name="name">crm.lead.form.outreach</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="js_class">crm_lead_form</attribute>
            </xpath>
            <xpath expr="//header" position="replace">
                <header>
                    <button name="%(sgc_crm_outreach_popup.action_crm_outreach_wizard)d"
                            string="Send Outreach Email"
                            type="action"
                            class="btn-primary"
                            invisible="stage_id != 10"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>