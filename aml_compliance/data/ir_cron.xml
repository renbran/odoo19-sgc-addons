<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Daily OpenSanctions Sync (4 AM UTC) -->
        <record id="ir_cron_opensanctions_sync_daily" model="ir.cron">
            <field name="name">AML: Sync OpenSanctions Daily</field>
            <field name="model_id" ref="aml_compliance.model_aml_opensanctions_config"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">
# Sync OpenSanctions full dataset
config = env['aml.opensanctions.config'].get_config()
if config and config.mode == 'cloud' and config.active:
    result = config.action_sync_dataset()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.datetime.utcnow() + datetime.timedelta(days=1, hours=4)).replace(hour=4, minute=0, second=0, microsecond=0)"/>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Weekly Full Refresh (Sunday 3 AM UTC) -->
        <record id="ir_cron_opensanctions_full_sync" model="ir.cron">
            <field name="name">AML: Full OpenSanctions Refresh (Weekly)</field>
            <field name="model_id" ref="aml_compliance.model_aml_opensanctions_config"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">
# Full dataset sync weekly (clear + reimport)
config = env['aml.opensanctions.config'].get_config()
if config and config.mode == 'cloud' and config.active:
    # Clear old entries older than 30 days
    cutoff = (datetime.datetime.utcnow() - datetime.timedelta(days=30)).date()
    old_entries = env['aml.sanctions.list'].search([
        ('last_sync_at', '&lt;', cutoff),
        ('list_source', '=', 'opensanctions'),
    ])
    old_entries.unlink()
    # Re-sync full dataset
    config.action_sync_dataset()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(datetime.datetime.utcnow() + datetime.timedelta(days=(6 - datetime.datetime.utcnow().weekday()))).replace(hour=3, minute=0, second=0, microsecond=0)"/>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
