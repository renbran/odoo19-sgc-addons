<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice/Bill Form View - Add Approval State Field -->
    <record id="view_move_form_enhanced" model="ir.ui.view">
        <field name="name">account.move.form.enhanced</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add hidden fields and workflow buttons -->
            <xpath expr="//header" position="inside">
                <field name="approval_state" invisible="1"/>
                <field name="can_submit_for_review" invisible="1"/>
                <field name="can_review" invisible="1"/>
                <field name="can_approve" invisible="1"/>
                <field name="can_post_manual" invisible="1"/>
                <button name="action_submit_for_review" string="Submit for Review" type="object" class="btn-primary" invisible="not can_submit_for_review"/>
                <button name="action_review_approve" string="Review &amp; Approve" type="object" class="btn-success" invisible="not can_review"/>
                <button name="action_final_approve" string="Final Approve" type="object" class="btn-success" invisible="not can_approve"/>
                <button name="action_reject_invoice_bill" string="Reject" type="object" class="btn-danger" invisible="not can_review and not can_approve" confirm="Are you sure you want to reject this document?"/>
            </xpath>

        </field>
    </record>

    <!-- Invoice/Bill Tree View (Odoo 19 uses <list>) -->
    <record id="view_invoice_tree_enhanced" model="ir.ui.view">
        <field name="name">account.move.tree.enhanced</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">

            <!-- This view used to set the list's js_class to
                 "osus_bulk_print_list", but no JS in this codebase ever
                 registered that view type; it came from an OSUS project whose
                 asset was never ported. Odoo resolves js_class through the
                 client side "views" registry, so an unregistered name is not
                 ignored: it raises KeyNotFoundError inside the Owl lifecycle
                 and the list never renders, taking Journal Entries and the
                 invoice lists down with it. Do not re-add it without also
                 shipping the JS that registers the view. -->

            <!-- Declare required fields -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="move_type" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>