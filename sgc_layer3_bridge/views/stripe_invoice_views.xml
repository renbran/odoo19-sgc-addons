<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stripe_invoice_list" model="ir.ui.view">
        <field name="name">sgc.stripe.invoice.list</field>
        <field name="model">sgc.stripe.invoice</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="create_date"/>
                <field name="order_id"/>
                <field name="stripe_invoice_id"/>
                <field name="move_id"/>
                <field name="amount_paid"/>
                <field name="currency_id" optional="hide"/>
                <field name="paid_at"/>
                <field name="billing_reason"/>
            </list>
        </field>
    </record>

    <record id="view_stripe_invoice_form" model="ir.ui.view">
        <field name="name">sgc.stripe.invoice.form</field>
        <field name="model">sgc.stripe.invoice</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <field name="order_id"/>
                        <field name="stripe_invoice_id"/>
                        <field name="move_id"/>
                        <field name="amount_paid"/>
                        <field name="currency_id" optional="hide"/>
                        <field name="paid_at"/>
                        <field name="billing_reason"/>
                        <field name="event_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stripe_invoice" model="ir.actions.act_window">
        <field name="name">Layer 3 Stripe invoices</field>
        <field name="res_model">sgc.stripe.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stripe_invoice" name="Layer 3 Stripe Invoices" parent="base.menu_custom"
              action="action_stripe_invoice" groups="base.group_system,account.group_account_user"
              sequence="92"/>
</odoo>
