                  <a t-att-href="object.l3_tenant_url" style="display:inline-block; padding:13px 26px; color:#ffffff; font-size:14px; font-weight:700; text-decoration:none; letter-spacing:0.4px;">Open your workspace</a>
                </td></tr>
