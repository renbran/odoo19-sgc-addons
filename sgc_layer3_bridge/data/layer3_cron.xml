<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Account states, document expiry, invoice mailing, then delivery to the tenant
             receiver (delivery only when sgc_layer3_bridge.push_enabled is True). -->
        <record id="cron_layer3_process" model="ir.cron">
            <field name="name">Layer 3: account states and tenant sync</field>
            <field name="model_id" ref="model_layer3_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Trial T-3 day reminder (idempotent via l3_trial_reminder_sent). The day-14
             charge itself is Stripe's job; the webhook handles success/lockout transitions
             and the T-0 emails. -->
        <record id="cron_layer3_trial_ends" model="ir.cron">
            <field name="name">Layer 3: trial T-3 reminder</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._l3_process_trial_ends()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
