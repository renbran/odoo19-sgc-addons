<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Kill switch: the signup API refuses every request until this is True. -->
        <record id="param_checkout_enabled" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.checkout_enabled</field>
            <field name="value">False</field>
        </record>
        <!-- Company that sells Layer 3. Empty = the main company. -->
        <record id="param_company_id" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.company_id</field>
            <field name="value"></field>
        </record>
        <!-- Public Odoo URL for Sign &amp; Pay and billing links (production: https://app.sgctech.ai). -->
        <record id="param_public_base_url" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.public_base_url</field>
            <field name="value"></field>
        </record>
        <record id="param_terms_url" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.terms_url</field>
            <field name="value">https://sgctech.ai/legal/subscription</field>
        </record>
        <!-- Prices (AED, ex-VAT) - PR-03 Rev 4 and SGC-MEMO-2026-OIC-01. -->
        <record id="param_base_monthly" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.base_monthly</field>
            <field name="value">875</field>
        </record>
        <record id="param_user_monthly_founding" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.user_monthly_founding</field>
            <field name="value">50</field>
        </record>
        <record id="param_user_monthly_standard" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.user_monthly_standard</field>
            <field name="value">75</field>
        </record>
        <record id="param_rebate_quarterly" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.rebate_quarterly</field>
            <field name="value">0</field>
        </record>
        <record id="param_rebate_half_yearly" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.rebate_half_yearly</field>
            <field name="value">2.5</field>
        </record>
        <record id="param_rebate_annual" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.rebate_annual</field>
            <field name="value">5</field>
        </record>
        <!-- Capacity: founding cohort (onboarding fee waived) and the tenant cap until load testing. -->
        <record id="param_founding_cohort_size" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.founding_cohort_size</field>
            <field name="value">10</field>
        </record>
        <record id="param_max_active_tenants" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.max_active_tenants</field>
            <field name="value">10</field>
        </record>
        <!-- Days in Archive before deletion (plan decision 6, proposed). -->
        <record id="param_archive_days" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.archive_days</field>
            <field name="value">90</field>
        </record>
        <!-- Push to the tenant receiver. Off until the receiver is live and
             sgc_layer3_bridge.signing_secret (>= 32 characters) is set by hand; the secret is
             never shipped in module data. -->
        <record id="param_push_enabled" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.push_enabled</field>
            <field name="value">False</field>
        </record>
        <record id="param_receiver_endpoint" model="ir.config_parameter">
            <field name="key">sgc_layer3_bridge.receiver_endpoint</field>
            <field name="value"></field>
        </record>
    </data>
</odoo>
