<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="period_l3_quarterly" model="product.subscription.period">
            <field name="name">Layer 3 - Quarterly</field>
            <field name="unit">month</field>
            <field name="duration">3</field>
        </record>
        <record id="period_l3_half_yearly" model="product.subscription.period">
            <field name="name">Layer 3 - Half-yearly</field>
            <field name="unit">month</field>
            <field name="duration">6</field>
        </record>
        <record id="period_l3_annual" model="product.subscription.period">
            <field name="name">Layer 3 - Annual</field>
            <field name="unit">year</field>
            <field name="duration">1</field>
        </record>

        <!-- Prices come from the sgc_layer3_bridge.* parameters, not these list prices. -->
        <record id="product_l3_base" model="product.product">
            <field name="name">SGC Real Estate OS - Layer 3 subscription (5 users)</field>
            <field name="default_code">L3-BASE</field>
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="is_recurring" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">875</field>
        </record>
        <record id="product_l3_user_founding" model="product.product">
            <field name="name">Layer 3 - additional user (founding rate)</field>
            <field name="default_code">L3-USER-F</field>
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="is_recurring" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">50</field>
        </record>
        <record id="product_l3_user_standard" model="product.product">
            <field name="name">Layer 3 - additional user (standard rate)</field>
            <field name="default_code">L3-USER-S</field>
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="is_recurring" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">75</field>
        </record>
    </data>
</odoo>
