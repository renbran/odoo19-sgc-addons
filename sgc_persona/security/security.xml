<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="privilege_sgc_persona" model="res.groups.privilege">
            <field name="name">SGC Persona</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_sgc_persona_admin" model="res.groups">
            <field name="name">SGC Persona Admin</field>
            <field name="privilege_id" ref="privilege_sgc_persona"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sgc_persona_tool_manager" model="res.groups">
            <field name="name">SGC Persona Tool Manager</field>
            <field name="privilege_id" ref="privilege_sgc_persona"/>
            <field name="implied_ids" eval="[(4, ref('sgc_persona.group_sgc_persona_admin'))]"/>
        </record>
    </data>
</odoo>
