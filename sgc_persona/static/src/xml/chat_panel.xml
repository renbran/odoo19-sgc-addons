<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="sgc_persona.SgcChatPanel">
        <div class="o_sgc_chat_panel">
            <div class="o_sgc_chat_header">
                <h3 class="o_sgc_chat_title">SGC AI Assistant</h3>
                <select class="o_sgc_persona_select o_input"
                        t-att-value="state.selectedPersona ? state.selectedPersona.id : ''"
                        t-on-change="selectPersona">
                    <option value="">
                        Select a persona…
                    </option>
                    <t t-foreach="state.personas" t-as="persona" t-key="persona.id">
                        <option t-att-value="persona.id">
                            <t t-esc="persona.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="o_sgc_chat_messages" t-ref="messageContainer">
                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                    <div t-att-class="'o_sgc_message o_sgc_message_' + msg.role">
                        <div class="o_sgc_message_bubble"
                             t-out="formatContent(msg.content)"/>
                    </div>
                </t>
                <t t-if="state.streaming">
                    <div class="o_sgc_chat_typing">
                        <span class="o_sgc_typing_dot"></span>
                        <span class="o_sgc_typing_dot"></span>
                        <span class="o_sgc_typing_dot"></span>
                    </div>
                </t>
                <t t-if="!state.messages.length">
                    <t t-if="!state.streaming">
                        <div class="o_sgc_chat_empty">
                            Select a persona and start chatting.
                        </div>
                    </t>
                </t>
            </div>

            <div class="o_sgc_chat_footer">
                <input type="text"
                       class="o_sgc_chat_input o_input"
                       placeholder="Type your message…"
                       t-att-disabled="!state.selectedPersona || state.streaming"
                       t-model="state.inputValue"
                        t-on-keyup="onInputKeyup"/>
                <button class="o_sgc_chat_send btn btn-primary"
                        t-att-disabled="!state.selectedPersona || state.streaming || !state.inputValue.trim()"
                        t-on-click="sendMessage">
                    Send
                </button>
            </div>

            <t t-if="state.error">
                <div class="o_sgc_chat_error">
                    <t t-esc="state.error"/>
                </div>
            </t>
        </div>
    </t>
</templates>
