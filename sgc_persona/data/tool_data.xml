        <field name="decorator_method">sgc_fetch_hr_data</field>
        <field name="description">Fetch HR data including headcount by department, leave requests (if hr_holidays installed), and payroll summary (if hr_payroll installed). Degrades gracefully when optional modules are absent.</field>
        <field name="active" eval="True"/>
        <field name="read_only_hint" eval="True"/>
        <field name="idempotent_hint" eval="True"/>
    </record>

