<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

  <!--
    SECURITY: Block portal and public users from accessing digital_file
    attachments directly via /web/content URLs.

    The only legitimate access path is through the token-authenticated
    controller at /shop/digital/download.

    Domain logic:
      portal/public users may read an ir.attachment ONLY when it is NOT
      the digital_file field of a product.template record.
      i.e.  res_model != 'product.template'  OR  res_field != 'digital_file'
  -->

  <!-- Block portal users -->
  <record id="rule_digital_file_attachment_portal" model="ir.rule">
    <field name="name">Digital File Attachment: deny portal direct access</field>
    <field name="model_id" ref="base.model_ir_attachment"/>
    <field name="domain_force">[
      '|',
        ('res_model', '!=', 'product.template'),
        ('res_field', '!=', 'digital_file')
    ]</field>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read">True</field>
    <field name="perm_write">False</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">False</field>
  </record>

  <!-- Block public (unauthenticated website visitors) -->
  <record id="rule_digital_file_attachment_public" model="ir.rule">
    <field name="name">Digital File Attachment: deny public direct access</field>
    <field name="model_id" ref="base.model_ir_attachment"/>
    <field name="domain_force">[
      '|',
        ('res_model', '!=', 'product.template'),
        ('res_field', '!=', 'digital_file')
    ]</field>
    <field name="groups" eval="[(4, ref('base.group_public'))]"/>
    <field name="perm_read">True</field>
    <field name="perm_write">False</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">False</field>
  </record>

</data>
</odoo>
