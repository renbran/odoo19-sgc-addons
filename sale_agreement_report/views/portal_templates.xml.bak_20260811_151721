<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_agreements" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Agreements</t>
                <t t-set="url">/my/agreements</t>
                <t t-set="count" t-value="agreement_count"/>
            </t>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_agreements" inherit_id="portal.portal_breadcrumbs" priority="50">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'agreements'" class="breadcrumb-item active">Agreements</li>
            <li t-if="page_name == 'agreement_detail'" class="breadcrumb-item">
                <a href="/my/agreements">Agreements</a>
            </li>
            <li t-if="page_name == 'agreement_detail'" class="breadcrumb-item active">
                <t t-esc="agreement.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_agreements" name="My Agreements">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Agreements</t>
            </t>
            <div class="o_portal_wrap">
                <t t-if="not agreements">
                    <div class="alert alert-info" role="alert">No yearly agreements found.</div>
                </t>
                <t t-if="agreements" t-foreach="agreements" t-as="agreement">
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-1"><t t-esc="agreement.name"/></h5>
                                    <div class="text-muted">Year: <t t-esc="agreement.agreement_year"/></div>
                                </div>
                                <div>
                                    <a t-attf-href="/my/agreements/#{agreement.id}" class="btn btn-outline-primary btn-sm">Open</a>
                                    <a t-attf-href="/my/agreements/#{agreement.id}/download" class="btn btn-primary btn-sm ms-2">Download</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <template id="portal_agreement_detail" name="Agreement Detail">
        <t t-call="portal.portal_layout">
            <div class="o_portal_wrap">
                <h2 class="mb-3"><t t-esc="agreement.name"/></h2>

                <t t-if="request.params.get('success')">
                    <div class="alert alert-success">Document uploaded successfully.</div>
                </t>
                <t t-if="request.params.get('error')">
                    <div class="alert alert-danger">
                        <t t-if="request.params.get('error') == 'no_file'">Please choose a file before submitting.</t>
                        <t t-elif="request.params.get('error') == 'bad_doc_type'">Invalid upload type selected.</t>
                        <t t-elif="request.params.get('error') == 'invalid_file_type'">Only PDF, JPG, and PNG files are allowed.</t>
                        <t t-elif="request.params.get('error') == 'file_too_large'">File size must be 10 MB or less.</t>
                        <t t-else="">Upload failed. Please try again.</t>
                    </div>
                </t>

                <div class="card mb-3">
                    <div class="card-body">
                        <p class="mb-1"><strong>Agreement year:</strong> <t t-esc="agreement.agreement_year"/></p>
                        <p class="mb-1"><strong>Customer:</strong> <t t-esc="agreement.partner_id.name"/></p>
                        <a t-attf-href="/my/agreements/#{agreement.id}/download" class="btn btn-primary">Download Agreement</a>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5>Trade/Business License</h5>
                                <p class="text-muted small">Optional. Allowed: PDF/JPG/PNG up to 10 MB.</p>
                                <p t-if="agreement.license_uploaded_on" class="small">Uploaded: <t t-esc="agreement.license_uploaded_on"/></p>
                                <form t-attf-action="/my/agreements/#{agreement.id}/upload" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="doc_type" value="license"/>
                                    <input type="file" name="document" class="form-control mb-2" required="required"/>
                                    <button type="submit" class="btn btn-outline-primary">Upload / Replace</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5>Owner Document</h5>
                                <p class="text-muted small">Optional. Allowed: PDF/JPG/PNG up to 10 MB.</p>
                                <p t-if="agreement.owner_document_uploaded_on" class="small">Uploaded: <t t-esc="agreement.owner_document_uploaded_on"/></p>
                                <form t-attf-action="/my/agreements/#{agreement.id}/upload" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="doc_type" value="owner"/>
                                    <input type="file" name="document" class="form-control mb-2" required="required"/>
                                    <button type="submit" class="btn btn-outline-primary">Upload / Replace</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
