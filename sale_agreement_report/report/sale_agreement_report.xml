<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Updated Agreement Report Action - Uses external layout for header/footer -->
    <record id="action_report_sale_agreement" model="ir.actions.report">
        <field name="name">Implementation Agreement</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_agreement_report.report_sale_agreement</field>
        <field name="report_file">sale_agreement_report.report_sale_agreement</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <!-- Removed custom paperformat to use company's default external layout format -->
    </record>

    <record id="action_report_yearly_sale_agreement" model="ir.actions.report">
        <field name="name">Yearly Implementation Agreement</field>
        <field name="model">sale.agreement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_agreement_report.report_sale_agreement_yearly</field>
        <field name="report_file">sale_agreement_report.report_sale_agreement_yearly</field>
        <field name="binding_model_id" ref="model_sale_agreement"/>
        <field name="binding_type">report</field>
    </record>

</odoo>