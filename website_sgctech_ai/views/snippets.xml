                            <div class="sgc-testi-avatar">AB</div>
                            <div>
                                <div class="sgc-testi-name">Client Name</div>
                                <div class="sgc-testi-role">Role · Company Name</div>
                            </div>
                        </div>
                    </div>
                    <div class="sgc-testi-card">
                        <div class="sgc-testi-quote-icon">"</div>
                        <div class="sgc-testi-stars">★★★★★</div>
                        <p class="sgc-testi-text">Third testimonial here. Three testimonials creates strong social proof without overwhelming the reader.</p>
                        <div class="sgc-testi-author">
                            <div class="sgc-testi-avatar">CD</div>
                            <div>
                                <div class="sgc-testi-name">Client Name</div>
                                <div class="sgc-testi-role">Role · Company Name</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
