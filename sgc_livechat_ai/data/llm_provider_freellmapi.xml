<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: so the API key you set in the UI is never overwritten on upgrade -->
    <data noupdate="1">
        <record id="provider_freellmapi" model="llm.provider">
            <field name="name">FreeLLMAPI (Auto Router)</field>
            <field name="service">openai</field>
            <field name="api_base">http://freellmapi-prod:3001/v1</field>
            <!-- Paste your freellmapi key in Settings after install. -->
            <field name="api_key"></field>
        </record>

        <record id="model_freellmapi_auto" model="llm.model">
            <field name="name">auto</field>
            <field name="provider_id" ref="provider_freellmapi"/>
            <field name="model_use">chat</field>
        </record>
    </data>
</odoo>
