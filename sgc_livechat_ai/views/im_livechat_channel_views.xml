<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_livechat_channel_view_form_sgc_ai" model="ir.ui.view">
        <field name="name">im_livechat.channel.form.sgc.ai</field>
        <field name="model">im_livechat.channel</field>
        <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='options']" position="after">
                <page string="AI Assistant" name="sgc_ai">
                    <group>
                        <group string="AI Auto-Reply">
                            <field name="sgc_ai_enabled"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                When enabled, visitor messages on this channel are answered
                                by the AI assistant (freellmapi). Configure the endpoint,
                                model, API key and system prompt in
                                <b>Settings &gt; Technical &gt; System Parameters</b>
                                (keys starting with <code>sgc_livechat_ai.</code>).
                                Also add the <b>SGC Assistant</b> bot user as an Operator
                                on this channel so replies post under it.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
