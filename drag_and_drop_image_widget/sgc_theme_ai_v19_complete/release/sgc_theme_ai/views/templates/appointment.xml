<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="sgc_appointment" name="SGC Appointment Booking">
    <t t-call="website.layout">
      <t t-set="additional_title">Book Free Consultation | SGC TECH AI | 14-Day ERP UAE</t>
      <t t-set="meta_description">Book a free 30-minute strategy consultation with SGC TECH AI. Get a personalised ROI projection and implementation roadmap for your UAE business. No commitment required.</t>

      <div id="wrap">

        <section class="sgc-section sgc-bg-hero" style="padding-top:140px;padding-bottom:60px;">
          <div class="sgc-container">
            <div id="sgc-appointment-layout" style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start;">

              <div>
                <span class="sgc-label">Free Consultation</span>
                <h1 style="font-size:clamp(2rem,4vw,3.2rem);margin-bottom:1rem;">
                  Let's Map Your <span class="sgc-highlight">14-Day Roadmap</span>
                </h1>
                <p style="color:rgba(255,255,255,0.65);line-height:1.7;margin-bottom:2rem;font-size:1rem;">
                  A 30-minute call with a senior SGC engineer. We will assess your business, calculate your exact ROI projection, and show you precisely how we deliver results in 14 days.
                </p>

                <div style="display:flex;flex-direction:column;gap:1.25rem;margin-bottom:2.5rem;">
                  <t t-foreach="[
                    ('Business needs assessment', 'We map your current processes and identify the highest-impact automation opportunities.'),
                    ('Personalised ROI calculation', 'We calculate your projected savings based on your specific team size and costs.'),
                    ('Implementation roadmap', 'You leave with a clear 14-day plan, not a vague proposal.'),
                    ('No obligation, no pressure', 'Our job is to show you the value. Your job is to decide.'),
                  ]" t-as="item">
                    <div style="display:flex;gap:1rem;align-items:flex-start;">
                      <div style="width:36px;height:36px;background:rgba(0,255,136,0.12);border:1px solid rgba(0,255,136,0.3);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--sgc-neon-green)" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                      </div>
                      <div>
                        <p style="font-weight:600;color:white;margin-bottom:0.2rem;font-size:0.9rem;"><t t-esc="item[0]"/></p>
                        <p style="color:rgba(255,255,255,0.55);font-size:0.8rem;line-height:1.5;"><t t-esc="item[1]"/></p>
                      </div>
                    </div>
                  </t>
                </div>

                <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:1rem;padding:1.5rem;">
                  <p style="font-size:0.8rem;font-weight:600;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:1rem;">Prefer to reach out directly?</p>
                  <div style="display:flex;flex-direction:column;gap:0.875rem;">
                    <a href="https://wa.me/971521985231" target="_blank" rel="noopener noreferrer"
                       style="display:flex;align-items:center;gap:0.75rem;color:white;text-decoration:none;font-size:0.875rem;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                      +971 52 198 5231 | WhatsApp available
                    </a>
                    <a href="mailto:hello@sgctech.ai"
                       style="display:flex;align-items:center;gap:0.75rem;color:white;text-decoration:none;font-size:0.875rem;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sgc-electric-cyan)" stroke-width="1.8" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                      hello@sgctech.ai | Responds within 2 hours
                    </a>
                  </div>
                  <p style="font-size:0.75rem;color:rgba(255,255,255,0.35);margin-top:1rem;">
                    Available Saturday to Thursday, 9AM to 6PM GST (Dubai time)
                  </p>
                </div>

                <div style="margin-top:1.5rem;border-radius:1.5rem;overflow:hidden;border:1px solid rgba(0,255,240,0.15);box-shadow:0 8px 32px rgba(0,0,0,0.4);">
                  <img src="/sgc_theme_ai/static/src/img/tech_office.png"
                       alt="ERP consultation session with implementation specialists" loading="lazy"
                       style="width:100%;height:auto;max-height:200px;object-fit:cover;display:block;"/>
                </div>
              </div>

              <div>
                <div class="sgc-card" style="padding:2.5rem;">
                  <h3 style="font-size:1.2rem;margin-bottom:0.5rem;">Book Your Free Session</h3>
                  <p style="color:rgba(255,255,255,0.55);font-size:0.875rem;margin-bottom:2rem;">Takes 2 minutes. No spam. No obligation.</p>

                  <form id="sgc-booking-form" novalidate="">
                    <div id="booking-progress" style="display:flex;gap:0.5rem;align-items:center;margin-bottom:1rem;">
                      <span id="booking-step-pill-1" style="display:inline-flex;align-items:center;justify-content:center;min-width:86px;height:28px;border-radius:999px;background:rgba(0,255,240,0.12);border:1px solid rgba(0,255,240,0.35);font-size:0.75rem;font-weight:700;color:var(--sgc-electric-cyan);">Step 1 of 2</span>
                      <span id="booking-step-pill-2" style="display:inline-flex;align-items:center;justify-content:center;min-width:86px;height:28px;border-radius:999px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);font-size:0.75rem;font-weight:600;color:rgba(255,255,255,0.55);">Step 2</span>
                      <span id="booking-step-note" style="font-size:0.78rem;color:rgba(255,255,255,0.45);margin-left:0.5rem;">Start with your contact details</span>
                    </div>

                    <input type="hidden" id="booking-solution" name="solution" t-att-value="request.params.get('solution', '')"/>

                    <div id="booking-step-1">
                      <div style="margin-bottom:1rem;">
                        <label class="sgc-label-text" for="booking-name">Full Name *</label>
                        <input class="sgc-input" type="text" id="booking-name" name="name"
                               placeholder="Ahmed Al-Rashid" required="" autocomplete="name"/>
                      </div>

                      <div style="margin-bottom:1rem;">
                        <label class="sgc-label-text" for="booking-email">Work Email *</label>
                        <input class="sgc-input" type="email" id="booking-email" name="email"
                               placeholder="ahmed@company.ae" required="" autocomplete="email"/>
                      </div>

                      <div style="margin-bottom:1.25rem;">
                        <label class="sgc-label-text" for="booking-phone">WhatsApp / Phone *</label>
                        <input class="sgc-input" type="tel" id="booking-phone" name="phone"
                               placeholder="+971 50 XXX XXXX" required="" autocomplete="tel"/>
                      </div>

                      <button type="button" class="sgc-btn sgc-btn-primary" id="booking-next"
                              style="width:100%;justify-content:center;">
                        Continue to Business Details
                      </button>
                    </div>

                    <div id="booking-step-2" style="display:none;">
                      <div class="sgc-booking-step2-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
                        <div>
                          <label class="sgc-label-text" for="booking-company">Company Name</label>
                          <input class="sgc-input" type="text" id="booking-company" name="company"
                                 placeholder="Your Company LLC" autocomplete="organization"/>
                        </div>
                        <div>
                          <label class="sgc-label-text" for="booking-industry">Industry</label>
                          <select class="sgc-input sgc-select" id="booking-industry" name="industry">
                            <option value="">Select industry</option>
                            <option value="real_estate">Real Estate</option>
                            <option value="trading">Trading &amp; Distribution</option>
                            <option value="manufacturing">Manufacturing</option>
                            <option value="professional_services">Professional Services</option>
                            <option value="hospitality">Hospitality</option>
                            <option value="other">Other</option>
                          </select>
                        </div>
                      </div>

                      <div style="margin-bottom:1rem;">
                        <label class="sgc-label-text" for="booking-employees">Team Size</label>
                        <select class="sgc-input sgc-select" id="booking-employees" name="employees">
                          <option value="">Select size</option>
                          <option value="10">1 to 15 employees</option>
                          <option value="30">16 to 50 employees</option>
                          <option value="100">51 to 200 employees</option>
                          <option value="250">200+ employees</option>
                        </select>
                      </div>

                      <div style="margin-bottom:1.5rem;">
                        <label class="sgc-label-text" for="booking-challenge">Biggest challenge right now?</label>
                        <textarea class="sgc-input" id="booking-challenge" name="message" rows="3"
                                  placeholder="e.g. Manual processes taking too long, no visibility into financials, payroll errors..."
                                  style="min-height:90px;resize:vertical;"></textarea>
                      </div>

                      <div class="sgc-booking-actions" style="display:grid;grid-template-columns:1fr 1.5fr;gap:0.75rem;">
                        <button type="button" class="sgc-btn sgc-btn-secondary" id="booking-back" style="justify-content:center;">
                          Back
                        </button>
                        <button type="submit" class="sgc-btn sgc-btn-primary" id="booking-submit"
                                style="justify-content:center;">
                          <span id="booking-btn-text">Book Free Consultation</span>
                          <span id="booking-spinner" style="display:none;align-items:center;gap:0.5rem;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="animation:sgc-rotate 0.8s linear infinite;"><circle cx="12" cy="12" r="10" stroke-opacity="0.3"/><path d="M12 2a10 10 0 0110 10"/></svg>
                            Booking...
                          </span>
                        </button>
                      </div>
                    </div>

                    <p style="font-size:0.75rem;color:rgba(255,255,255,0.35);text-align:center;margin-top:1rem;">
                      We respond within 2 hours | Saturday to Thursday, 9AM to 6PM GST
                    </p>

                    <div id="booking-success"
                         style="display:none;text-align:center;padding:2rem;background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.3);border-radius:1rem;margin-top:1rem;">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--sgc-neon-green)" stroke-width="2" aria-hidden="true" style="margin:0 auto 1rem;display:block;"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                      <h4 style="color:var(--sgc-neon-green);margin-bottom:0.5rem;">Booking Confirmed!</h4>
                      <p style="color:rgba(255,255,255,0.7);font-size:0.875rem;">We will contact you within 2 hours to confirm your consultation time. Check your WhatsApp or email.</p>
                    </div>
                  </form>
                </div>
              </div>

            </div>
          </div>
        </section>

        <script type="text/javascript">
          document.addEventListener('DOMContentLoaded', function() {
            var form = document.getElementById('sgc-booking-form');
            var submit = document.getElementById('booking-submit');
            var nextBtn = document.getElementById('booking-next');
            var backBtn = document.getElementById('booking-back');
            var btnTxt = document.getElementById('booking-btn-text');
            var spinner = document.getElementById('booking-spinner');
            var success = document.getElementById('booking-success');
            var step1 = document.getElementById('booking-step-1');
            var step2 = document.getElementById('booking-step-2');
            var pill1 = document.getElementById('booking-step-pill-1');
            var pill2 = document.getElementById('booking-step-pill-2');
            var stepNote = document.getElementById('booking-step-note');

            if (!form) return;

            function activateStep(stepNumber) {
              var isStep1 = stepNumber === 1;
              step1.style.display = isStep1 ? 'block' : 'none';
              step2.style.display = isStep1 ? 'none' : 'block';

              if (isStep1) {
                pill1.style.background = 'rgba(0,255,240,0.12)';
                pill1.style.borderColor = 'rgba(0,255,240,0.35)';
                pill1.style.color = 'var(--sgc-electric-cyan)';
                pill1.textContent = 'Step 1 of 2';

                pill2.style.background = 'rgba(255,255,255,0.04)';
                pill2.style.borderColor = 'rgba(255,255,255,0.1)';
                pill2.style.color = 'rgba(255,255,255,0.55)';
                pill2.textContent = 'Step 2';
                stepNote.textContent = 'Start with your contact details';
              } else {
                pill1.style.background = 'rgba(0,255,136,0.12)';
                pill1.style.borderColor = 'rgba(0,255,136,0.35)';
                pill1.style.color = 'var(--sgc-neon-green)';
                pill1.textContent = 'Step 1 complete';

                pill2.style.background = 'rgba(0,255,240,0.12)';
                pill2.style.borderColor = 'rgba(0,255,240,0.35)';
                pill2.style.color = 'var(--sgc-electric-cyan)';
                pill2.textContent = 'Step 2 of 2';
                stepNote.textContent = 'Tell us your business context';
              }
            }

            function validStep1() {
              var name = document.getElementById('booking-name');
              var email = document.getElementById('booking-email');
              var phone = document.getElementById('booking-phone');
              return name.reportValidity() &amp;&amp; email.reportValidity() &amp;&amp; phone.reportValidity();
            }

            nextBtn.addEventListener('click', function() {
              if (validStep1()) {
                activateStep(2);
                document.getElementById('booking-company').focus();
              }
            });

            backBtn.addEventListener('click', function() {
              activateStep(1);
              document.getElementById('booking-name').focus();
            });

            form.addEventListener('submit', async function(e) {
              e.preventDefault();

              if (!validStep1()) {
                activateStep(1);
                return;
              }

              btnTxt.style.display = 'none';
              spinner.style.display = 'flex';
              submit.disabled = true;

              var csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
              var solution = document.getElementById('booking-solution').value;
              var baseMessage = document.getElementById('booking-challenge').value;
              var data = {
                name: document.getElementById('booking-name').value,
                email: document.getElementById('booking-email').value,
                phone: document.getElementById('booking-phone').value,
                company: document.getElementById('booking-company').value,
                industry: document.getElementById('booking-industry').value,
                employees: document.getElementById('booking-employees').value,
                message: baseMessage + (solution ? ('\n\nSolution Interest: ' + solution) : ''),
              };

              try {
                var resp = await fetch('/sgc/lead', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                  body: JSON.stringify({ jsonrpc: '2.0', method: 'call', id: 1, params: data }),
                });
                var payload = await resp.json();
                var result = payload.result || payload;
                if (resp.ok &amp;&amp; result.success) {
                  form.style.display = 'none';
                  success.style.display = 'block';
                } else {
                  throw new Error((result &amp;&amp; result.error) || 'Submission failed');
                }
              } catch (err) {
                btnTxt.style.display = 'inline';
                spinner.style.display = 'none';
                submit.disabled = false;
                alert('Submission failed. Please try WhatsApp at +971 52 198 5231');
              }
            });

            activateStep(1);
          });
        </script>

      </div>
    </t>
  </template>

</odoo>
