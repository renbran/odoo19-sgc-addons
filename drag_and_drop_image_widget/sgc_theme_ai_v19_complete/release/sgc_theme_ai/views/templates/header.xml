<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="sgc_header" name="SGC TECH AI Navigation" inherit_id="website.layout">

    <xpath expr="//header" position="replace">
      <header id="sgc-header" role="banner">
        <nav class="sgc-nav" aria-label="Main navigation">

          <a t-attf-href="#{website.get_base_url()}" class="sgc-nav-logo" aria-label="SGC TECH AI Homepage">
            <div class="logo-mark" aria-hidden="true">SG</div>
            <div class="logo-text">
              <span class="logo-primary">SGC TECH AI</span>
              <span class="logo-tagline">Intelligent Infrastructure</span>
            </div>
          </a>

          <ul class="sgc-nav-links" role="list">

            <li>
              <a href="/" t-attf-class="#{request.httprequest.path == '/' and 'active' or ''}">
                <span>Home</span>
              </a>
            </li>

            <li class="sgc-nav-dropdown">
              <a href="/solutions" aria-haspopup="true" aria-expanded="false">
                <span>Solutions</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none"/>
                </svg>
              </a>
              <div class="sgc-mega-menu" role="menu">
                <a href="/solutions/real-estate" class="sgc-mega-item" role="menuitem">
                  <div class="mega-icon">RE</div>
                  <div>
                    <div class="mega-title">Real Estate ERP</div>
                    <div class="mega-desc">Rental management &amp; CEO dashboards</div>
                  </div>
                </a>
                <a href="/solutions/trading" class="sgc-mega-item" role="menuitem">
                  <div class="mega-icon">TD</div>
                  <div>
                    <div class="mega-title">Trading &amp; Distribution</div>
                    <div class="mega-desc">Inventory, POS &amp; supply chain</div>
                  </div>
                </a>
                <a href="/solutions/manufacturing" class="sgc-mega-item" role="menuitem">
                  <div class="mega-icon">MF</div>
                  <div>
                    <div class="mega-title">Manufacturing</div>
                    <div class="mega-desc">MRP, quality &amp; production planning</div>
                  </div>
                </a>
                <a href="/solutions/professional-services" class="sgc-mega-item" role="menuitem">
                  <div class="mega-icon">PS</div>
                  <div>
                    <div class="mega-title">Professional Services</div>
                    <div class="mega-desc">Project management &amp; billing</div>
                  </div>
                </a>
                <a href="/solutions/hr-payroll" class="sgc-mega-item" role="menuitem">
                  <div class="mega-icon">HR</div>
                  <div>
                    <div class="mega-title">HR &amp; Payroll</div>
                    <div class="mega-desc">UAE-compliant payroll processing</div>
                  </div>
                </a>
                <a href="/solutions/ai-analytics" class="sgc-mega-item" role="menuitem">
                  <div class="mega-icon">AI</div>
                  <div>
                    <div class="mega-title">AI Analytics</div>
                    <div class="mega-desc">Business intelligence &amp; forecasting</div>
                  </div>
                </a>
              </div>
            </li>

            <li>
              <a href="/pricing" t-attf-class="#{'/pricing' in request.httprequest.path and 'active' or ''}">
                <span>Pricing</span>
              </a>
            </li>

            <li>
              <a href="/success-stories" t-attf-class="#{'/success' in request.httprequest.path and 'active' or ''}">
                <span>Case Studies</span>
              </a>
            </li>

            <li>
              <a href="/blog" t-attf-class="#{'/blog' in request.httprequest.path and 'active' or ''}">
                <span>Insights</span>
              </a>
            </li>

            <li>
              <a href="/about" t-attf-class="#{'/about' in request.httprequest.path and 'active' or ''}">
                <span>About</span>
              </a>
            </li>

            <li>
              <a href="/shop" t-attf-class="#{'/shop' in request.httprequest.path and 'active' or ''}">
                <span>Store</span>
              </a>
            </li>

          </ul>

          <div class="sgc-nav-actions">

            <t t-if="website.shop_ppg">
              <a href="/shop/cart" class="sgc-cart-icon" aria-label="Shopping cart">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                </svg>
                <span class="sgc-cart-count" t-if="cart_quantity" t-esc="cart_quantity"/>
              </a>
            </t>

            <t t-if="not request.session.uid">
              <a href="/web/login" class="sgc-btn sgc-btn-ghost sgc-btn-sm">Login</a>
            </t>
            <t t-else="">
              <a href="/odoo" class="sgc-btn sgc-btn-ghost sgc-btn-sm">Dashboard</a>
            </t>

            <a href="/appointment" class="sgc-btn sgc-btn-primary sgc-btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              Book Consultation
            </a>
          </div>

          <button class="sgc-hamburger" id="sgc-hamburger"
                  aria-label="Toggle navigation" aria-expanded="false" aria-controls="sgc-mobile-menu">
            <span></span>
            <span></span>
            <span></span>
          </button>

        </nav>

        <nav class="sgc-mobile-menu" id="sgc-mobile-menu" aria-label="Mobile navigation">
          <div style="margin-bottom:2rem;">
            <a href="/" class="sgc-nav-logo">
              <div class="logo-mark">SG</div>
              <div class="logo-text">
                <span class="logo-primary">SGC TECH AI</span>
                <span class="logo-tagline">Intelligent Infrastructure</span>
              </div>
            </a>
          </div>

          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem;">
            <li><a href="/" style="display:block;padding:14px 0;color:rgba(255,255,255,0.8);font-size:1.1rem;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.08);">Home</a></li>
            <li><a href="/solutions" style="display:block;padding:14px 0;color:rgba(255,255,255,0.8);font-size:1.1rem;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.08);">Solutions</a></li>
            <li><a href="/pricing" style="display:block;padding:14px 0;color:rgba(255,255,255,0.8);font-size:1.1rem;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.08);">Pricing</a></li>
            <li><a href="/success-stories" style="display:block;padding:14px 0;color:rgba(255,255,255,0.8);font-size:1.1rem;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.08);">Case Studies</a></li>
            <li><a href="/about" style="display:block;padding:14px 0;color:rgba(255,255,255,0.8);font-size:1.1rem;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.08);">About</a></li>
            <li><a href="/shop" style="display:block;padding:14px 0;color:rgba(255,255,255,0.8);font-size:1.1rem;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.08);">Store</a></li>
          </ul>

          <div style="margin-top:2rem;display:flex;flex-direction:column;gap:1rem;">
            <a href="/appointment" class="sgc-btn sgc-btn-primary" style="justify-content:center;">
              Book Free Consultation
            </a>
            <a href="https://wa.me/971521985231" class="sgc-btn sgc-btn-whatsapp" target="_blank" style="justify-content:center;">
              WhatsApp Us
            </a>
          </div>

          <div style="margin-top:2rem;padding-top:2rem;border-top:1px solid rgba(255,255,255,0.08);">
            <p style="color:rgba(255,255,255,0.4);font-size:0.8rem;">Dubai, UAE | hello@sgctech.ai | +971 52 198 5231</p>
          </div>
        </nav>

      </header>
    </xpath>

  </template>

</odoo>
