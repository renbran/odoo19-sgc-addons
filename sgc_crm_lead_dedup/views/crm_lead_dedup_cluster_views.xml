<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_dedup_cluster_list" model="ir.ui.view">
        <field name="name">crm.lead.dedup.cluster.list</field>
        <field name="model">crm.lead.dedup.cluster</field>
        <field name="arch" type="xml">
            <list decoration-danger="quarantined" decoration-muted="state in ('merged','rejected')">
                <field name="name"/>
                <field name="strategy"/>
                <field name="tier"/>
                <field name="member_count"/>
                <field name="quarantined"/>
                <field name="state"/>
                <field name="master_lead_id"/>
            </list>
        </field>
    </record>

    <record id="view_crm_lead_dedup_cluster_form" model="ir.ui.view">
        <field name="name">crm.lead.dedup.cluster.form</field>
        <field name="model">crm.lead.dedup.cluster</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve for Merge"
                            invisible="state != 'pending_review' or quarantined"/>
                    <button name="action_reject" type="object" string="Reject (Not a Duplicate)"
                            invisible="state not in ('pending_review','approved')"/>
                    <button name="action_reset_to_pending" type="object" string="Reset to Pending"
                            invisible="state == 'pending_review'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="strategy"/>
                            <field name="tier"/>
                            <field name="member_count"/>
                        </group>
                        <group>
                            <field name="quarantined"/>
                            <field name="master_lead_id"/>
                            <field name="master_rule_note"/>
                            <field name="merged_on"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Reviewer notes..."/>
                    <notebook>
                        <page string="Members">
                            <field name="line_ids">
                                <list editable="bottom" create="false">
                                    <field name="lead_id"/>
                                    <field name="stage_id"/>
                                    <field name="type"/>
                                    <field name="lead_create_date"/>
                                    <field name="lead_active"/>
                                    <field name="is_master"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_dedup_cluster_tier1" model="ir.actions.act_window">
        <field name="name">Tier 1 — Auto-Merge Eligible</field>
        <field name="res_model">crm.lead.dedup.cluster</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tier','=','1')]</field>
    </record>

    <record id="action_crm_lead_dedup_cluster_tier2" model="ir.actions.act_window">
        <field name="name">Tier 2 — Human Review Backlog</field>
        <field name="res_model">crm.lead.dedup.cluster</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tier','=','2')]</field>
    </record>

    <record id="action_crm_lead_dedup_cluster_tier3" model="ir.actions.act_window">
        <field name="name">Tier 3 — Manual Only</field>
        <field name="res_model">crm.lead.dedup.cluster</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tier','=','3')]</field>
    </record>

    <record id="action_crm_lead_dedup_cluster_quarantine" model="ir.actions.act_window">
        <field name="name">Quarantined (10+ members)</field>
        <field name="res_model">crm.lead.dedup.cluster</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('quarantined','=',True)]</field>
    </record>
</odoo>
