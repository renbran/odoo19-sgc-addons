<odoo>
    <record id="view_calendar_event_form_inherit_sgc" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.sgc.meeting.ai</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <field name="videocall_location" position="after">
                <field name="sgc_provider_id" />
                <field name="sgc_bot_enabled" />
                <field name="sgc_booking_id" invisible="not sgc_booking_id" groups="base.group_user" />
                <field name="sgc_session_id" invisible="not sgc_session_id" />
            </field>
            <div name="button_box" position="inside">
                <button
                    name="action_create_resource_booking"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar-check-o"
                    invisible="sgc_booking_id"
                    groups="base.group_user"
                    string="Create Booking"
                />
                <button
                    name="action_open_sgc_session"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-magic"
                    invisible="not sgc_session_id"
                >
                    <field name="sgc_notes_count" widget="statinfo" string="AI Notes" />
                </button>
            </div>
        </field>
    </record>

    <record id="view_calendar_event_tree_inherit_sgc" model="ir.ui.view">
        <field name="name">calendar.event.list.inherit.sgc.meeting.ai</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sgc_bot_enabled" optional="hide" />
                <field name="sgc_notes_count" string="AI Notes" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_calendar_event_form_restrict_booking" model="ir.ui.view">
        <field name="name">calendar.event.form.restrict.booking.portal</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="resource_booking.view_calendar_event_form" />
        <field name="arch" type="xml">
            <field name="resource_booking_ids" position="attributes">
                <attribute name="groups">base.group_user</attribute>
            </field>
        </field>
    </record>
</odoo>