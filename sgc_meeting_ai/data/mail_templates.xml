<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="email_template_meeting_notes" model="mail.template">
        <field name="name">SGC Meeting AI - Notes Summary</field>
        <field name="model_id" ref="model_sgc_meeting_notes" />
        <field name="subject">{{ object.session_id.meeting_id.name or 'Meeting' }} — AI Notes</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; max-width: 720px; margin: 0 auto;">
    <h2 style="color: #875A7B;">AI Meeting Notes</h2>
    <p>Hi {{ object.session_id.meeting_id.partner_ids and object.session_id.meeting_id.partner_ids[0].name or 'there' }},</p>
    <p>Your meeting "<strong>{{ object.session_id.meeting_id.name or 'Untitled' }}</strong>" on <strong>{{ object.session_id.meeting_id.start.strftime('%Y-%m-%d %H:%M') if object.session_id.meeting_id.start else 'unknown date' }}</strong> has been processed by SGC Meeting AI.</p>

    <h3>📝 Summary</h3>
    <div>{{ object.summary or '' }}</div>

    <h3>🔑 Key Discussion Points</h3>
    <div>{{ object.key_points or '' }}</div>

    <h3>✅ Decisions Made</h3>
    <div>{{ object.decisions or '' }}</div>

    <h3>🎯 Action Items</h3>
    <div>{{ object.action_items or '' }}</div>

    <h3>⚠️ Risks &amp; Blockers</h3>
    <div>{{ object.risks or '' }}</div>

    <hr style="margin: 24px 0; border: none; border-top: 1px solid #ddd;"/>
    <p style="color: #888; font-size: 12px;">
        Generated by SGC Tech AI · model: {{ object.model or 'unknown' }} · tokens: {{ object.tokens_used or 0 }}<br/>
        <t t-if="object.session_id.meeting_id">
            <a t-attf-href="{{ object.session_id.meeting_id.get_base_url() }}/web#id={{ object.session_id.meeting_id.id }}&amp;model=calendar.event&amp;view_type=form">
                View full meeting in Odoo →
            </a>
        </t>
    </p>
</div>
        </field>
        <field name="lang">{{ object.partner_id.lang or 'en_US' }}</field>
        <field name="auto_delete" eval="False" />
    </record>
</odoo>
