<odoo>
    <!-- Form View -->
    <record id="resource_booking_type_view_form" model="ir.ui.view">
        <field name="name">Resource booking type form</field>
        <field name="model">resource.booking.type</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" invisible="1" />
                        <widget
                            name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            invisible="active"
                        />
                        <button
                            name="action_open_bookings"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                        >
                            <field name="booking_count" widget="statinfo" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Booking Type Name" />
                        </h1>
                    </div>
                    <notebook>
                        <page name="settings" string="Configuration">
                            <group name="main">
                                <group name="settings" string="Settings">
                                    <field
                                        name="company_id"
                                        options="{'no_create': True}"
                                        groups="base.group_multi_company"
                                    />
                                    <field name="duration" widget="float_time" />
                                    <field name="slot_duration" widget="float_time" />
                                    <field name="modifications_deadline" widget="float_time" />
                                    <field name="resource_calendar_id" />
                                </group>
                                <group name="event_defaults" string="Meeting Defaults">
                                    <field name="location" placeholder="Meeting room or address" />
                                    <field name="videocall_location" placeholder="https://meeting.example.com/..." />
                                    <field name="alarm_ids" widget="many2many_tags" />
                                    <field
                                        name="categ_ids"
                                        widget="many2many_tags"
                                        options="{'no_create_edit': True}"
                                    />
                                    <field name="requester_advice" placeholder="Advice shown to requesters in the portal..." />
                                </group>
                            </group>
                        </page>
                        <page name="combinations" string="Resource Combinations">
                            <group name="combinations">
                                <field name="combination_assignment" />
                                <field name="combination_rel_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle" />
                                        <field name="combination_id" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page name="ai_config" string="AI Settings" groups="resource_booking.group_manager">
                            <group name="ai_settings" string="Smart Scheduling">
                                <field name="ai_scheduling_enabled" />
                                <field name="ai_auto_assign" invisible="not ai_scheduling_enabled" />
                                <field name="color" widget="color_picker" invisible="not ai_scheduling_enabled" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <!-- List View -->
    <record id="resource_booking_type_view_tree" model="ir.ui.view">
        <field name="name">Resource booking type list</field>
        <field name="model">resource.booking.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="resource_calendar_id" />
                <field name="duration" widget="float_time" />
                <field name="booking_count" />
                <field name="ai_scheduling_enabled" string="AI" />
                <field name="color" widget="color_picker" optional="hide" />
            </list>
        </field>
    </record>
    <!-- Search View -->
    <record id="resource_booking_type_view_search" model="ir.ui.view">
        <field name="name">resource.booking.type.view.search</field>
        <field name="model">resource.booking.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    name="ai_enabled"
                    string="AI Scheduling Enabled"
                    domain="[('ai_scheduling_enabled', '=', True)]"
                />
                <group name="groupby">
                    <filter
                        string="Company"
                        name="groupby_company_id"
                        context="{'group_by':'company_id'}"
                        groups="base.group_multi_company"
                    />
                    <filter
                        string="AI Scheduling"
                        name="groupby_ai"
                        context="{'group_by':'ai_scheduling_enabled'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <!-- Action -->
    <record id="resource_booking_type_action" model="ir.actions.act_window">
        <field name="name">Booking Types</field>
        <field name="res_model">resource.booking.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define resource booking types.</p>
            <p>These records categorize resource bookings and apply restrictions to them, such as available resource combinations, availability schedules and interval duration. Enable AI Scheduling to get smart suggestions.</p>
        </field>
    </record>
</odoo>