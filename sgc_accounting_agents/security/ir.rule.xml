<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Intake may create contacts (new vendors and customers from uploads),
         only inside its own companies; it never edits or deletes contacts. -->
    <record id="rule_sgc_agent_intake_partner_create" model="ir.rule">
        <field name="name">SGC agent intake: new top-level contacts in own companies only</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <!-- Top-level only: never an address or person under an existing contact. -->
        <field name="domain_force">[('company_id', 'in', company_ids), ('parent_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_intake'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Intake applies Chart of Accounts changes the portal owner approved:
         it creates and updates (archives) accounts that belong only to its own
         companies; it never deletes an account. -->
    <record id="rule_sgc_agent_intake_account_own" model="ir.rule">
        <field name="name">SGC agent intake: accounts of own companies only</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="domain_force">[('company_ids', 'not any', [('id', 'not in', company_ids)])]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_intake'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Intake may only touch draft entries of its own companies. -->
    <record id="rule_sgc_agent_intake_move_draft" model="ir.rule">
        <field name="name">SGC agent intake: draft entries only</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('state', 'in', ('draft', 'sent'))]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_intake'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sgc_agent_intake_move_line_draft" model="ir.rule">
        <field name="name">SGC agent intake: draft lines only</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('parent_state', 'in', ('draft', 'sent'))]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_intake'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Posting may only change draft entries of its own companies. -->
    <record id="rule_sgc_agent_posting_move_draft" model="ir.rule">
        <field name="name">SGC agent posting: draft entries only</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_posting'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sgc_agent_posting_move_line_draft" model="ir.rule">
        <field name="name">SGC agent posting: draft lines only</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('parent_state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_posting'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Reconciliation stays inside its own companies. -->
    <record id="rule_sgc_agent_recon_statement" model="ir.rule">
        <field name="name">SGC agent reconciliation: own companies</field>
        <field name="model_id" ref="account.model_account_bank_statement_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_reconciliation'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sgc_agent_recon_partial" model="ir.rule">
        <field name="name">SGC agent reconciliation: own companies</field>
        <field name="model_id" ref="account.model_account_partial_reconcile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_reconciliation'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Intake may only create and edit draft payments of its own companies. -->
    <record id="rule_sgc_agent_intake_payment_draft" model="ir.rule">
        <field name="name">SGC agent intake: draft payments only</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_agents.group_sgc_agent_intake'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
