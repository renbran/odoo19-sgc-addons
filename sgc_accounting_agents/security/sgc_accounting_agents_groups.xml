<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sgc_agency_manager" model="res.groups">
        <field name="name">SGC Agency Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="api_key_duration">30</field>
        <field name="comment">Manages agent roles, credentials and posting approvals.</field>
    </record>

    <record id="group_sgc_agent_gatekeeper" model="res.groups">
        <field name="name">SGC Agent 00 - Gatekeeper</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="api_key_duration">90</field>
        <field name="comment">Reads documents, validates them and requests approvals. Read only on the ledger.</field>
    </record>

    <record id="group_sgc_agent_intake" model="res.groups">
        <field name="name">SGC Agent 01 - Document Intake</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="api_key_duration">90</field>
        <field name="comment">Creates draft invoices and bills from extracted documents. Never posts.</field>
    </record>

    <record id="group_sgc_agent_posting" model="res.groups">
        <field name="name">SGC Agent 02 - GL Mapping and Posting</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="api_key_duration">30</field>
        <field name="comment">Maps accounts and posts entries that carry an approved posting request.</field>
    </record>

    <record id="group_sgc_agent_reconciliation" model="res.groups">
        <field name="name">SGC Agent 03 - Bank Reconciliation</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="api_key_duration">60</field>
        <field name="comment">Reconciles bank statement lines. No invoice creation, no posting.</field>
    </record>

    <record id="group_sgc_agent_tax_audit" model="res.groups">
        <field name="name">SGC Agent 04 - UAE VAT and CT Audit</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="api_key_duration">90</field>
        <field name="comment">Audits VAT and corporate tax. Read only on the ledger.</field>
    </record>

    <record id="group_sgc_agent_reporting" model="res.groups">
        <field name="name">SGC Agent 05 - CFO Reporting</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="api_key_duration">90</field>
        <field name="comment">Builds management reports. Read only on the ledger.</field>
    </record>
</odoo>
