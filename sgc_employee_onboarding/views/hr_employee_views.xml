<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add onboarding fields and buttons to employee form -->
    <record id="hr_employee_view_form_onboarding" model="ir.ui.view">
        <field name="name">hr.employee.form.onboarding</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_generate_onboarding_survey" type="object"
                        string="Generate Onboarding Survey"
                        class="btn-primary"
                        groups="base.group_user"
                        attrs="{'invisible': [('onboarding_state', '!=', 'not_started')]}"
                        title="Create a new onboarding survey for this employee"/>
                <button name="action_send_onboarding_survey" type="object"
                        string="Send Onboarding Survey"
                        class="btn-secondary"
                        groups="base.group_user"
                        attrs="{'invisible': [('onboarding_state', '=', 'not_started')]}"
                        title="Send the onboarding survey link to the employee"/>
            </xpath>
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Onboarding"
                      name="onboarding_page"
                      groups="base.group_user">
                    <group>
                        <group>
                            <field name="onboarding_survey_link" readonly="1"
                                   widget="url" string="Onboarding Survey Link"
                                   help="Public link for the employee to complete their onboarding survey"/>
                            <field name="onboarding_survey_deadline"
                                   string="Survey Deadline"/>
                        </group>
                        <group>
                            <field name="onboarding_last_submitted"
                                   string="Last Submitted"
                                   readonly="1"/>
                            <field name="onboarding_state"
                                   string="Onboarding Status"
                                   readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
