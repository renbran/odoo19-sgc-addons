<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject the file_upload question rendering into the stock question container -->
    <template id="question_container_add_file_upload" inherit_id="survey.question_container">
        <xpath expr="//t[@t-if=&quot;question.question_type == 'matrix'&quot;]" position="after">
            <t t-if="question.question_type == 'file_upload'"
               t-call="sgc_employee_onboarding.question_file_upload"/>
        </xpath>
    </template>

    <template id="question_file_upload" name="Question: file upload">
        <t t-set="file_answer"
           t-value="answer_lines and answer_lines[0].answer_attachment_ids[:1]"/>
        <div class="o_survey_answer_wrapper p-1 rounded">
            <t t-if="survey_form_readonly">
                <div t-if="file_answer" class="d-flex align-items-center text-break">
                    <i class="fa fa-file-o me-2"/>
                    <span t-out="file_answer.name"/>
                </div>
                <span t-else="" class="text-muted">No file uploaded.</span>
            </t>
            <t t-else="">
                <div class="o_sgc_survey_file_box">
                    <input type="file"
                           class="form-control o_sgc_survey_file_input bg-transparent rounded-0 p-0"
                           t-att-data-question-id="question.id"
                           t-att-data-answer-token="answer.access_token"/>
                    <input type="hidden"
                           class="o_sgc_survey_file_value"
                           t-att-name="question.id"
                           data-question-type="char_box"
                           t-att-value="file_answer and file_answer.id or ''"/>
                    <div class="text-muted small mt-1 o_sgc_survey_file_status">
                        <span t-if="file_answer">Uploaded: <span t-out="file_answer.name"/></span>
                        <span t-else="">No file uploaded yet.</span>
                    </div>
                </div>
            </t>
        </div>
    </template>
</odoo>