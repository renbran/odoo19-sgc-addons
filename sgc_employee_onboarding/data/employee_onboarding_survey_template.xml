<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Default Onboarding Survey Template (Odoo 19 schema)
         Pages and questions are both survey.question records:
         pages have is_page=True, questions are ordered by sequence.
         ============================================================ -->
    <record id="survey_employee_onboarding_template" model="survey.survey">
        <field name="title">SGC Employee Onboarding Survey</field>
        <field name="scoring_type">no_scoring</field>
        <field name="users_login_required">False</field>
        <field name="access_mode">public</field>
    </record>

    <!-- Page 1: Contact &amp; Personal -->
    <record id="sgc_employee_onboarding.page_contact_personal" model="survey.question">
        <field name="is_page">True</field>
        <field name="title">Contact &amp; Personal</field>
        <field name="sequence">10</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_work_email" model="survey.question">
        <field name="title">Work Email</field>
        <field name="question_type">char_box</field>
        <field name="validation_required">True</field>
        <field name="sequence">101</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_personal_email" model="survey.question">
        <field name="title">Personal Email</field>
        <field name="question_type">char_box</field>
        <field name="sequence">102</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_work_phone" model="survey.question">
        <field name="title">Work Phone</field>
        <field name="question_type">char_box</field>
        <field name="sequence">103</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_mobile_phone" model="survey.question">
        <field name="title">Mobile Phone</field>
        <field name="question_type">char_box</field>
        <field name="sequence">104</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_home_phone" model="survey.question">
        <field name="title">Home Phone</field>
        <field name="question_type">char_box</field>
        <field name="sequence">105</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_emergency_contact" model="survey.question">
        <field name="title">Emergency Contact</field>
        <field name="question_type">char_box</field>
        <field name="validation_required">True</field>
        <field name="sequence">106</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_emergency_phone" model="survey.question">
        <field name="title">Emergency Phone</field>
        <field name="question_type">char_box</field>
        <field name="sequence">107</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_date_of_birth" model="survey.question">
        <field name="title">Date of Birth</field>
        <field name="question_type">date</field>
        <field name="sequence">108</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_marital_status" model="survey.question">
        <field name="title">Marital Status</field>
        <field name="question_type">simple_choice</field>
        <field name="sequence">109</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_number_of_children" model="survey.question">
        <field name="title">Number of Dependent Children</field>
        <field name="question_type">numerical_box</field>
        <field name="sequence">110</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_nationality" model="survey.question">
        <field name="title">Nationality</field>
        <field name="question_type">char_box</field>
        <field name="sequence">111</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <!-- Page 2: Work Information -->
    <record id="sgc_employee_onboarding.page_work_information" model="survey.question">
        <field name="is_page">True</field>
        <field name="title">Work Information</field>
        <field name="sequence">20</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_department" model="survey.question">
        <field name="title">Department</field>
        <field name="question_type">char_box</field>
        <field name="sequence">201</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_job_position" model="survey.question">
        <field name="title">Job Position</field>
        <field name="question_type">char_box</field>
        <field name="sequence">202</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_work_location" model="survey.question">
        <field name="title">Work Location</field>
        <field name="question_type">char_box</field>
        <field name="sequence">203</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_manager" model="survey.question">
        <field name="title">Manager</field>
        <field name="question_type">char_box</field>
        <field name="sequence">204</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_employee_type" model="survey.question">
        <field name="title">Employee Type</field>
        <field name="question_type">simple_choice</field>
        <field name="sequence">205</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_bank_account" model="survey.question">
        <field name="title">Bank Account (IBAN)</field>
        <field name="question_type">char_box</field>
        <field name="sequence">206</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <!-- Page 3: Documents &amp; Skills -->
    <record id="sgc_employee_onboarding.page_documents_skills" model="survey.question">
        <field name="is_page">True</field>
        <field name="title">Documents &amp; Skills</field>
        <field name="sequence">30</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_passport_number" model="survey.question">
        <field name="title">Passport Number</field>
        <field name="question_type">char_box</field>
        <field name="sequence">301</field>
        <field name="survey_id" ref="survey_employee_onboarding_template"/>
    </record>

    <record id="sgc_employee_onboarding.question_visa_number" model="survey.question">
        <field name="title">Visa Number</field>
        <field name="question_type">char_box</field>
        <field name="sequence">302</field>
