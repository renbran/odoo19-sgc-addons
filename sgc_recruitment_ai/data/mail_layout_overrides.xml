<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="override_mail_notification_layout_powered_by"
                  inherit_id="mail.mail_notification_layout">
            <xpath expr="//a[contains(@href, 'www.odoo.com')][contains(text(), 'Odoo')]"
                   position="replace">
                <a target="_blank" href="https://sgctech.ai"
                   t-att-style="'color: ' + (company.email_secondary_color or '#B89968') + ';'">SGC Tech AI</a>
            </xpath>
        </template>

        <template id="override_mail_notification_light_powered_by"
                  inherit_id="mail.mail_notification_light">
            <xpath expr="//a[contains(@href, 'www.odoo.com')][contains(text(), 'Odoo')]"
                   position="replace">
                <a target="_blank" href="https://sgctech.ai"
                   t-att-style="'color: ' + (company.email_secondary_color or '#B89968') + ';'">SGC Tech AI</a>
            </xpath>
        </template>
    </data>
</odoo>
