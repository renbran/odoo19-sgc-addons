<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Wave 1 bridge: re-points statement_report's single template onto
    external_layout_sgc, and applies the o_sgc_table styling class to its
    two data tables.

    C4/F4 (numeric fidelity): every t-esc value expression below is
    IDENTICAL, character-for-character, to the original template in
    statement_report/report/res_partner_templates.xml. Only the t-call
    target and table class attributes change.
-->

    <template id="res_partner_statement_report_template_sgc"
              inherit_id="statement_report.res_partner_statement_report_template">

        <!-- Re-point the layout: stock -> additive SGC layout -->
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">sgc_report_theme_core.external_layout_sgc</attribute>
        </xpath>

        <!-- Style the line-items table (has the thead) -->
        <xpath expr="//table[2]" position="attributes">
            <attribute name="class">o_sgc_table</attribute>
        </xpath>

        <!-- Style the totals table (the only table nested in a div) -->
        <xpath expr="//div/table" position="attributes">
            <attribute name="class">o_sgc_table o_sgc_table_total_row</attribute>
        </xpath>

        <!-- Restyle the heading using SGC typography tokens only (no value change) -->
        <xpath expr="//h3" position="attributes">
            <attribute name="style">font-family:'IBM Plex Serif';color:#0B1F3A;font-weight:600;</attribute>
        </xpath>

        <!--
            2026-07-23 (user-requested data fix, not pure re-theming):
            add a Payment column, and switch the Balance column from each
            invoice's own residual to the cumulative running_balance
            models/res_partner.py now computes. Both new fields come from
            our own main_query() override - no existing value expression
            is silently changed, this is the explicitly requested new
            content.
        -->
        <xpath expr="//table[2]/thead/tr/th[4]" position="after">
            <th>Payment</th>
        </xpath>
        <!--
            The tbody's <tr> is nested inside the t-foreach's <t> element
            (tbody > t > tr, not tbody > tr directly) - the raw pre-render
            arch that XPath surgery operates on still has that <t>
            wrapper present, confirmed via the actual ParseError ("cannot
            be located") the shorter path produced.

            2026-07-23 second fix: these two ops must run in THIS order.
            XPath inheritance specs apply sequentially against the
            accumulating tree - replacing td[5] FIRST (while it is still
            the original balance cell) then inserting a new cell after
            td[4] pushes the just-replaced running_balance cell to
            position 6, giving the correct final order (Invoices/Debit,
            Payment, Balance). Doing the insert first shifts td[5] to mean
            the NEWLY inserted node by the time the replace runs,
            corrupting the Payment cell instead - confirmed live: a
            rendered PDF showed the running balance under "Payment" and
            the untouched original per-row amount under "Balance".
        -->
        <xpath expr="//table[2]/tbody/t/tr/td[5]" position="replace">
            <td><t t-esc="currency"/><t t-esc="line.get('running_balance', '0.00')"/></td>
        </xpath>
        <xpath expr="//table[2]/tbody/t/tr/td[4]" position="after">
            <td><t t-esc="currency"/><t t-esc="line.get('amount_paid', '0.00')"/></td>
        </xpath>

        <!--
            Mini summary (top): reuses the already-proven block_summary_card
            component from sgc_report_theme_core, showing the SAME total/
            balance context variables the original template already prints
            at the bottom - no new computation, just an at-a-glance repeat
            near the top of the statement.
        -->
        <xpath expr="//table[2]" position="before">
            <table style="width:100%;margin-bottom:16px;">
                <tr>
                    <td style="width:50%;padding-right:8px;">
                        <t t-call="sgc_report_theme_core.block_summary_card">
                            <t t-set="summary_label" t-value="'Total Invoiced'"/>
                            <t t-set="summary_value" t-value="'%s%s' % (currency, total)"/>
                        </t>
                    </td>
                    <td style="width:50%;padding-left:8px;">
                        <t t-call="sgc_report_theme_core.block_summary_card">
                            <t t-set="summary_label" t-value="'Outstanding Balance'"/>
                            <t t-set="summary_value" t-value="'%s%s' % (currency, balance)"/>
                        </t>
                    </td>
                </tr>
            </table>
        </xpath>

    </template>

</odoo>
