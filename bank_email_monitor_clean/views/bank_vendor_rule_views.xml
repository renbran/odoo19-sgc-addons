<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_vendor_rule_list" model="ir.ui.view">
        <field name="name">bank.vendor.rule.list</field>
        <field name="model">bank.vendor.rule</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="sequence"/>
                <field name="name"/>
                <field name="is_learning_draft" optional="show"/>
                <field name="pattern"/>
                <field name="sender_pattern" optional="show"/>
                <field name="transaction_type" optional="show"/>
                <field name="payment_method" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="bank_journal_id" optional="show"/>
                <field name="source_transaction_id" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bank_vendor_rule_form" model="ir.ui.view">
        <field name="name">bank.vendor.rule.form</field>
        <field name="model">bank.vendor.rule</field>
        <field name="arch" type="xml">
            <form string="Vendor Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="is_learning_draft"/>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="source_transaction_id" readonly="1"/>
                            <field name="learning_confidence" readonly="1"/>
                        </group>
                        <group>
                            <field name="pattern"/>
                            <field name="sender_pattern"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="transaction_type"/>
                            <field name="payment_method"/>
                            <field name="expense_category"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="bank_journal_id"/>
                            <field name="suggested_account_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_vendor_rule" model="ir.actions.act_window">
        <field name="name">Vendor Rules</field>
        <field name="res_model">bank.vendor.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
