<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bank_email_transaction_rule_account_user_company" model="ir.rule">
        <field name="name">Bank Email Transaction multi-company access</field>
        <field name="model_id" ref="model_bank_email_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="bank_vendor_rule_account_user_company" model="ir.rule">
        <field name="name">Bank Vendor Rule multi-company access</field>
        <field name="model_id" ref="model_bank_vendor_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
