<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_quotation_proposal" model="report.paperformat">
        <field name="name">SGC Proposal A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_quotation_proposal" model="ir.actions.report">
        <field name="name">Commercial Proposal</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sgc_quotation_proposal.report_quotation_proposal</field>
        <field name="report_file">sgc_quotation_proposal.report_quotation_proposal</field>
        <field name="print_report_name">'Proposal - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="sgc_quotation_proposal.paperformat_quotation_proposal"/>
    </record>

</odoo>
