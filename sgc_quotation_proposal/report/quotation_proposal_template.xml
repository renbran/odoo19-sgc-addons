<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ====================================================================
        ENHANCEMENT LOG  ·  SGC TECH AI  ·  Quotation Proposal Template
        ====================================================================
        Version : 19.0.1.1.0  (2026-07-04)
        Scope   : This template only. All sections, fonts, paper format,
                  and existing copy preserved 1:1.

        What changed
        ====================================================================
        * Brand identity: faint composite UAE-landmarks watermark rendered
          as a centered page backdrop on every .sgc-page.
            · Burj Khalifa (tall tapering spire on the left)
            · Burj Al Arab (sail silhouette in the centre)
            · Sheikh Zayed Grand Mosque (three domes + four minarets, right)
          Stroke-only line art in navy #152947 at 6% opacity. Reads as a
          quiet national identity backdrop, never competes with content.

        * Content layering: page content now wrapped in <div class="sgc-content">
          so it always paints above the watermark (z-index 1 > 0).
          The watermark itself is non-interactive (pointer-events: none).

        * Palette discipline: no change to navy #152947 / gold #C5A059 /
          cream #FBFAF5. Existing brand language reinforced, not replaced.

        Why
        ====================================================================
        Connects the SGC TECH AI quotation proposal to its UAE home without
        adding any new colour, image asset, or paper-format dependency.
        Pure inline SVG keeps the watermark self-contained inside the
        module - no static file to ship, no print engine change required.

        Out of scope (unchanged)
        ====================================================================
        * paperformat_quotation_proposal (A4, zero margin, 90 dpi)
        * action_report_quotation_proposal binding
        * Fonts (Inter, Cormorant Garamond, Georgia)
        * Cover-page sections, scope table, totals, signature block, contact strip
        * Any other Odoo module
        ====================================================================
    -->
    <template id="report_quotation_proposal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="company" t-value="o.company_id"/>
                <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">

                    <style>
                        html, body { margin: 0; padding: 0; background-color: #FBFAF5; }
                        .sgc-proposal { font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
                                        color: #1a1f2e; font-size: 10.5pt; line-height: 1.5;
                                        -webkit-print-color-adjust: exact; }
                        .sgc-proposal .sgc-page { page-break-after: always; position: relative;
                                                  min-height: 283mm; padding: 16mm 16mm 18mm;
                                                  background-color: #FBFAF5; }
                        .sgc-proposal .sgc-page.last { page-break-after: avoid; }
                        .sgc-proposal .goldbar { position: absolute; top: 0; left: 0; right: 0;
                                                 height: 6px; background-color: #C5A059; }
                        .sgc-proposal h1, .sgc-proposal h2, .sgc-proposal h3, .sgc-proposal h4 {
                            font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
                            color: #152947; margin: 0; font-weight: 600; }
                        .sgc-proposal .eyebrow { font-size: 8.5pt; letter-spacing: 4px; text-transform: uppercase;
                                                 color: #B8934A; font-weight: bold; }
                        .sgc-proposal .muted { color: #5A6273; }
                        .sgc-proposal .topbar { width: 100%; border-collapse: collapse;
                                                border-bottom: 1px solid #E5DFCE; margin-bottom: 20px; }
                        .sgc-proposal .topbar td { border: none; padding: 4mm 0 8px; }
                        .sgc-proposal .topbar td { font-size: 8.5pt; letter-spacing: 2.5px;
                                                   text-transform: uppercase; }
                        .sgc-proposal .topbar .l { color: #B8934A; font-weight: bold; text-align: left; }
                        .sgc-proposal .topbar .r { color: #5A6273; text-align: right; }
                        .sgc-proposal .rule { text-align: center; margin: 14px 0; }
                        .sgc-proposal .rule .line { display: inline-block; vertical-align: middle;
                                                    width: 140px; height: 1px; background-color: #C5A059; }
                        .sgc-proposal .rule .diamond { display: inline-block; vertical-align: middle;
                                                       width: 8px; height: 8px; margin: 0 12px;
                                                       background-color: #C5A059; }
                        .sgc-proposal .cover-title { text-align: center; margin-top: 34mm; }
                        .sgc-proposal .cover-title h1 { font-size: 40pt; line-height: 1.05; }
                        .sgc-proposal .cover-title .accent { color: #B8934A; font-style: italic; }
                        .sgc-proposal .cover-sub { margin-top: 16px; font-size: 13pt; color: #1E3A5F;
                                                   font-family: Georgia, serif; font-style: italic; }
                        .sgc-proposal .meta-table { width: 100%; border-top: 1px solid #E5DFCE;
                                                    margin-top: 40mm; }
                        .sgc-proposal .meta-table td { width: 33%; padding: 14px 16px;
                                                       border-right: 1px solid #E5DFCE; vertical-align: top; }
                        .sgc-proposal .meta-table td.last { border-right: none; }
                        .sgc-proposal .meta-lb { font-size: 7.5pt; letter-spacing: 2.5px; text-transform: uppercase;
                                                 color: #5A6273; font-weight: bold; margin-bottom: 4px; }
                        .sgc-proposal .meta-val { font-family: Georgia, serif; font-size: 14pt;
                                                  font-weight: bold; color: #152947; }
                        .sgc-proposal .sec { background-color: #ffffff; border: 1px solid #E9D9AE;
                                             border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; }
                        .sgc-proposal .sec-head { margin-bottom: 10px; }
                        .sgc-proposal .sec-num { display: inline-block; width: 26px; height: 26px;
                                                 border-radius: 13px; background-color: #152947; color: #ffffff;
                                                 text-align: center; line-height: 26px; font-family: Georgia, serif;
                                                 font-weight: bold; font-size: 11pt; margin-right: 10px; }
                        .sgc-proposal .sec-t { font-family: Georgia, serif; font-size: 14pt; font-weight: bold;
                                               color: #152947; vertical-align: middle; }
                        .sgc-proposal table.lines { width: 100%; border-collapse: collapse; }
                        .sgc-proposal table.lines th { background-color: #152947; color: #ffffff;
                                                       font-size: 8pt; letter-spacing: 2px; text-transform: uppercase;
                                                       padding: 8px 10px; text-align: left; }
                        .sgc-proposal table.lines th.num, .sgc-proposal table.lines td.num { text-align: right; }
                        .sgc-proposal table.lines td { padding: 8px 10px; border: none;
                                                       border-bottom: 1px solid #E5DFCE;
                                                       font-size: 9.5pt; vertical-align: top; }
                        .sgc-proposal table.lines tr.section td { background-color: #F5EEDB; color: #152947;
                                                                  font-weight: bold; font-family: Georgia, serif;
                                                                  font-size: 11pt; border-bottom: 1px solid #C5A059; }
                        .sgc-proposal table.lines tr.note td { color: #5A6273; font-style: italic; font-size: 8.5pt; }
                        .sgc-proposal .totals-wrap { width: 100%; margin-top: 14px; }
                        .sgc-proposal .totals { width: 45%; float: right; border-collapse: collapse; }
                        .sgc-proposal .totals td { padding: 5px 10px; font-size: 10pt; border: none; }
                        .sgc-proposal .totals .lbl { color: #5A6273; text-transform: uppercase;
                                                     font-size: 8pt; letter-spacing: 2px; font-weight: bold; }
                        .sgc-proposal .totals .val { text-align: right; color: #152947; }
                        .sgc-proposal .clear { clear: both; }
                        .sgc-proposal .summary-card { margin-top: 12px; background-color: #FAF7EF;
                                                      border: 2px solid #C5A059; border-radius: 12px;
                                                      padding: 16px 20px; }
                        .sgc-proposal .summary-card .lbl { font-size: 8pt; letter-spacing: 3px;
                                                           text-transform: uppercase; color: #5A6273;
                                                           font-weight: bold; }
                        .sgc-proposal .summary-card .big { font-family: Georgia, serif; font-size: 30pt;
                                                           color: #152947; font-weight: bold; line-height: 1.1; }
                        .sgc-proposal .terms { font-size: 9.5pt; color: #1a1f2e; }
                        .sgc-proposal .sign-table { width: 100%; margin-top: 26px; border-top: 1px dashed #E9D9AE; }
                        .sgc-proposal .sign-table td { width: 50%; padding: 16px 20px 0; vertical-align: top; }
                        .sgc-proposal .sign-lb { font-size: 8pt; letter-spacing: 2.5px; font-weight: bold;
                                                 color: #B8934A; text-transform: uppercase; margin-bottom: 6px; }
                        .sgc-proposal .sign-line { height: 1px; background-color: #152947; opacity: 0.4;
                                                   margin-top: 34px; margin-bottom: 6px; }
                        .sgc-proposal .contact-strip { width: 100%; margin-top: 24px; background-color: #152947;
                                                       border-radius: 10px; }
                        .sgc-proposal .contact-strip td { padding: 12px 18px; width: 33%; }
                        .sgc-proposal .contact-strip .l { font-size: 7pt; letter-spacing: 2.5px; color: #E9D9AE;
                                                          font-weight: bold; text-transform: uppercase; }
                        .sgc-proposal .contact-strip .v { font-family: Georgia, serif; font-size: 11pt;
                                                          color: #ffffff; }
                        .sgc-proposal .conf { position: absolute; bottom: 8mm; left: 16mm;
                                              font-family: Georgia, serif; color: #152947; font-size: 8pt;
                                              letter-spacing: 4px; text-transform: uppercase; }
                        .sgc-proposal .pnum { position: absolute; bottom: 8mm; right: 16mm;
                                              font-family: Georgia, serif; color: #152947; font-size: 11pt;
                                              font-weight: bold; }
                        .sgc-proposal .sgc-watermark { position: absolute; top: 50%; left: 50%;
                                                        transform: translate(-50%, -50%); width: 140mm;
                                                        opacity: 0.06; pointer-events: none; z-index: 0; }
                        .sgc-proposal .sgc-content { position: relative; z-index: 1; }
                    </style>

                    <div class="sgc-proposal">

                        <!-- ============ PAGE 1 : COVER ============ -->
                        <div class="sgc-page">
                            <div class="goldbar"/>
                            <svg class="sgc-watermark" viewBox="0 0 800 300" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
                                <g fill="none" stroke="#152947" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                                    <!-- Burj Khalifa -->
                                    <path d="M 165 282 L 172 60 L 168 60 L 180 50 L 192 60 L 188 60 L 195 282 Z"/>
                                    <line x1="168" y1="100" x2="192" y2="100"/>
                                    <line x1="170" y1="140" x2="190" y2="140"/>
                                    <line x1="172" y1="180" x2="188" y2="180"/>
                                    <line x1="174" y1="220" x2="186" y2="220"/>
                                    <!-- Burj Al Arab -->
                                    <path d="M 380 282 C 380 230 420 180 470 100 C 490 80 500 80 500 80 C 500 80 490 100 480 140 C 470 200 460 250 460 282 Z"/>
                                    <path d="M 400 230 C 430 220 460 215 490 220"/>
                                    <path d="M 410 200 C 440 195 465 195 485 200"/>
                                    <!-- Sheikh Zayed Grand Mosque -->
                                    <path d="M 595 282 L 595 200 Q 605 175 625 175 Q 645 175 655 200 L 655 282"/>
                                    <line x1="625" y1="175" x2="625" y2="160"/>
                                    <circle cx="625" cy="158" r="2"/>
                                    <path d="M 555 282 L 555 215 Q 565 195 580 195 Q 595 195 600 215 L 600 282"/>
                                    <path d="M 670 282 L 670 218 Q 680 200 695 200 Q 710 200 718 218 L 718 282"/>
                                    <line x1="565" y1="282" x2="565" y2="120"/>
                                    <path d="M 560 120 L 565 105 L 570 120"/>
                                    <circle cx="565" cy="103" r="2"/>
                                    <line x1="615" y1="282" x2="615" y2="80"/>
                                    <path d="M 610 80 L 615 60 L 620 80"/>
                                    <circle cx="615" cy="58" r="2"/>
                                    <line x1="660" y1="282" x2="660" y2="110"/>
                                    <path d="M 655 110 L 660 95 L 665 110"/>
                                    <circle cx="660" cy="93" r="2"/>
                                    <line x1="710" y1="282" x2="710" y2="125"/>
                                    <path d="M 705 125 L 710 110 L 715 125"/>
                                    <circle cx="710" cy="108" r="2"/>
                                    <!-- Horizon -->
                                    <line x1="100" y1="282" x2="750" y2="282"/>
                                </g>
                            </svg>
                            <div class="sgc-content">
                            <table class="topbar"><tr>
                                <td class="l"><span t-field="company.name"/></td>
                                <td class="r">Commercial Proposal · <span t-field="o.name"/></td>
                            </tr></table>

                            <div class="cover-title">
                                <div class="eyebrow">Prepared Exclusively For</div>
                                <div class="rule">
                                    <span class="line"/><span class="diamond"/><span class="line"/>
                                </div>
                                <h1><span t-field="o.partner_id.name"/></h1>
                                <div class="cover-sub">
                                    Commercial <span class="accent">Proposal</span>
                                    <t t-if="o.partner_id.city"> · <span t-field="o.partner_id.city"/></t>
                                </div>
                            </div>

                            <table class="meta-table"><tr>
                                <td>
                                    <div class="meta-lb">Proposal Reference</div>
                                    <div class="meta-val"><span t-field="o.name"/></div>
                                </td>
                                <td>
                                    <div class="meta-lb">Date of Issue</div>
                                    <div class="meta-val"><span t-field="o.date_order" t-options='{"widget": "date"}'/></div>
                                </td>
                                <td class="last">
                                    <div class="meta-lb">Valid Until</div>
                                    <div class="meta-val">
                                        <t t-if="o.validity_date"><span t-field="o.validity_date"/></t>
                                        <t t-else="">Upon Request</t>
                                    </div>
                                </td>
                            </tr><tr>
                                <td>
                                    <div class="meta-lb">Your Consultant</div>
                                    <div class="meta-val"><span t-field="o.user_id.name"/></div>
                                </td>
                                <td>
                                    <div class="meta-lb">Contact</div>
                                    <div class="meta-val" style="font-size:10.5pt;">
                                        <span t-field="o.user_id.email"/>
                                    </div>
                                </td>
                                <td class="last">
                                    <div class="meta-lb">Total Investment</div>
                                    <div class="meta-val"><span t-field="o.amount_total"/></div>
                                </td>
                            </tr></table>

                            <div class="conf">Confidential</div>
                            <div class="pnum">01</div>
                            </div>
                        </div>

                        <!-- ============ PAGE 2 : SCOPE + INVESTMENT ============ -->
                        <div class="sgc-page last">
                            <div class="goldbar"/>
                            <svg class="sgc-watermark" viewBox="0 0 800 300" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
                                <g fill="none" stroke="#152947" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                                    <path d="M 165 282 L 172 60 L 168 60 L 180 50 L 192 60 L 188 60 L 195 282 Z"/>
                                    <line x1="168" y1="100" x2="192" y2="100"/>
                                    <line x1="170" y1="140" x2="190" y2="140"/>
                                    <line x1="172" y1="180" x2="188" y2="180"/>
                                    <line x1="174" y1="220" x2="186" y2="220"/>
                                    <path d="M 380 282 C 380 230 420 180 470 100 C 490 80 500 80 500 80 C 500 80 490 100 480 140 C 470 200 460 250 460 282 Z"/>
                                    <path d="M 400 230 C 430 220 460 215 490 220"/>
                                    <path d="M 410 200 C 440 195 465 195 485 200"/>
                                    <path d="M 595 282 L 595 200 Q 605 175 625 175 Q 645 175 655 200 L 655 282"/>
                                    <line x1="625" y1="175" x2="625" y2="160"/>
                                    <circle cx="625" cy="158" r="2"/>
                                    <path d="M 555 282 L 555 215 Q 565 195 580 195 Q 595 195 600 215 L 600 282"/>
                                    <path d="M 670 282 L 670 218 Q 680 200 695 200 Q 710 200 718 218 L 718 282"/>
                                    <line x1="565" y1="282" x2="565" y2="120"/>
                                    <path d="M 560 120 L 565 105 L 570 120"/>
                                    <circle cx="565" cy="103" r="2"/>
                                    <line x1="615" y1="282" x2="615" y2="80"/>
                                    <path d="M 610 80 L 615 60 L 620 80"/>
                                    <circle cx="615" cy="58" r="2"/>
                                    <line x1="660" y1="282" x2="660" y2="110"/>
                                    <path d="M 655 110 L 660 95 L 665 110"/>
                                    <circle cx="660" cy="93" r="2"/>
                                    <line x1="710" y1="282" x2="710" y2="125"/>
                                    <path d="M 705 125 L 710 110 L 715 125"/>
                                    <circle cx="710" cy="108" r="2"/>
                                    <line x1="100" y1="282" x2="750" y2="282"/>
                                </g>
                            </svg>
                            <div class="sgc-content">
                            <table class="topbar"><tr>
                                <td class="l"><span t-field="company.name"/></td>
                                <td class="r"><span t-field="o.name"/> · <span t-field="o.partner_id.name"/></td>
                            </tr></table>

                            <div class="sec">
                                <div class="sec-head">
                                    <span class="sec-num">1</span>
                                    <span class="sec-t">Scope of Work &amp; Deliverables</span>
                                </div>
                                <table class="lines">
                                    <thead>
                                        <tr>
                                            <th style="width:46%;">Description</th>
                                            <th class="num" style="width:12%;">Qty</th>
                                            <th class="num" style="width:20%;">Unit Price</th>
                                            <th class="num" style="width:22%;">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.order_line" t-as="line">
                                            <tr t-if="line.display_type == 'line_section'" class="section">
                                                <td colspan="4"><span t-field="line.name"/></td>
                                            </tr>
                                            <tr t-elif="line.display_type == 'line_note'" class="note">
                                                <td colspan="4"><span t-field="line.name"/></td>
                                            </tr>
                                            <tr t-else="">
                                                <td><span t-field="line.name"/></td>
                                                <td class="num">
                                                    <span t-field="line.product_uom_qty"/>
                                                </td>
                                                <td class="num"><span t-field="line.price_unit"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                                <td class="num"><span t-field="line.price_subtotal"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

                                <div class="totals-wrap">
                                    <table class="totals">
                                        <tr>
                                            <td class="lbl">Subtotal</td>
                                            <td class="val"><span t-field="o.amount_untaxed"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl">Taxes</td>
                                            <td class="val"><span t-field="o.amount_tax"/></td>
                                        </tr>
                                    </table>
                                    <div class="clear"/>
                                </div>

                                <div class="summary-card">
                                    <div class="lbl">Total Investment</div>
                                    <div class="big"><span t-field="o.amount_total"/></div>
                                </div>
                            </div>

                            <div class="sec">
                                <div class="sec-head">
                                    <span class="sec-num">2</span>
                                    <span class="sec-t">Terms &amp; Conditions</span>
                                </div>
                                <div class="terms">
                                    <t t-if="o.payment_term_id">
                                        <p style="margin:0 0 6px;"><b>Payment Terms:</b>
                                            <span t-field="o.payment_term_id.name"/></p>
                                    </t>
                                    <t t-if="o.validity_date">
                                        <p style="margin:0 0 6px;"><b>Proposal Validity:</b>
                                            This proposal remains valid until
                                            <span t-field="o.validity_date"/>.</p>
                                    </t>
                                    <div t-if="o.note" t-field="o.note"/>
                                </div>
                            </div>

                            <table class="sign-table"><tr>
                                <td>
                                    <div class="sign-lb">Accepted on behalf of the Client</div>
                                    <div class="sign-line"/>
                                    <div class="muted" style="font-size:9pt;">
                                        <span t-field="o.partner_id.name"/> · Name, Signature &amp; Date
                                    </div>
                                </td>
                                <td>
                                    <div class="sign-lb">For and on behalf of
                                        <span style="margin-left:4px;" t-field="company.name"/></div>
                                    <div class="sign-line"/>
                                    <div class="muted" style="font-size:9pt;">
                                        <span t-field="o.user_id.name"/> · Authorized Representative
                                    </div>
                                </td>
                            </tr></table>

                            <table class="contact-strip"><tr>
                                <td>
                                    <div class="l">Company</div>
                                    <div class="v"><span t-field="company.name"/></div>
                                </td>
                                <td>
                                    <div class="l">Email</div>
                                    <div class="v"><span t-field="company.email"/></div>
                                </td>
                                <td>
                                    <div class="l">Web / Phone</div>
                                    <div class="v"><span t-field="company.website"/>
                                        <t t-if="company.phone"> · <span t-field="company.phone"/></t>
                                    </div>
                                </td>
                            </tr></table>

                            <div class="conf">Confidential</div>
                            <div class="pnum">02</div>
                            </div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
