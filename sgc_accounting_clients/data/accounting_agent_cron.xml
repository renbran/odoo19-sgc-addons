<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sgc_accounting_agent_dispatch" model="ir.cron">
            <field name="name">SGC Accounting: dispatch document agent runs</field>
            <field name="model_id" ref="model_sgc_accounting_agent_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_dispatch_queued()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Triggered on every upload (runs within seconds); the interval only
             retries uploads still waiting for their client database. -->
        <record id="ir_cron_sgc_accounting_book_pending" model="ir.cron">
            <field name="name">SGC Accounting: book upload drafts in client databases</field>
            <field name="model_id" ref="model_sgc_accounting_upload"/>
            <field name="state">code</field>
            <field name="code">model._cron_book_pending()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Daily: re-verify every client database link (intake role, companies,
             key expiry) and give the account manager a to-do when it fails. -->
        <record id="ir_cron_sgc_accounting_check_connections" model="ir.cron">
            <field name="name">SGC Accounting: check client database links</field>
            <field name="model_id" ref="model_sgc_accounting_client"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_connections()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
