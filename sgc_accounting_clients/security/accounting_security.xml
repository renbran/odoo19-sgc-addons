<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sgc_accounting_user" model="res.groups">
        <field name="name">Accounting Agency User</field>
        <field name="comment">Can manage accounting client workspaces and documents on app.sgctech.ai.</field>
    </record>

    <record id="group_sgc_accounting_manager" model="res.groups">
        <field name="name">Accounting Agency Manager</field>
        <field name="comment">Can manage accounting clients, documents and provisioning events.</field>
        <field name="implied_ids" eval="[(4, ref('sgc_accounting_clients.group_sgc_accounting_user'))]"/>
    </record>

    <!-- 19.0.1.21.0 briefly made every administrator an agency manager; that is
         undone here. A client's portal belongs to its portal owner only. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('sgc_accounting_clients.group_sgc_accounting_manager'))]"/>
    </record>

    <record id="rule_sgc_accounting_client_internal" model="ir.rule">
        <field name="name">Accounting clients: internal users</field>
        <field name="model_id" ref="model_sgc_accounting_client"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_clients.group_sgc_accounting_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sgc_accounting_client_portal" model="ir.rule">
        <field name="name">Accounting clients: portal owner only</field>
        <field name="model_id" ref="model_sgc_accounting_client"/>
        <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sgc_accounting_company_internal" model="ir.rule">
        <field name="name">Accounting companies: internal users</field>
        <field name="model_id" ref="model_sgc_accounting_company"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_clients.group_sgc_accounting_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sgc_accounting_company_portal" model="ir.rule">
        <field name="name">Accounting companies: portal owner only</field>
        <field name="model_id" ref="model_sgc_accounting_company"/>
        <field name="domain_force">[('client_id.owner_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sgc_accounting_upload_internal" model="ir.rule">
        <field name="name">Accounting documents: internal users</field>
        <field name="model_id" ref="model_sgc_accounting_upload"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sgc_accounting_clients.group_sgc_accounting_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sgc_accounting_upload_portal" model="ir.rule">
        <field name="name">Accounting documents: portal owner only</field>
        <field name="model_id" ref="model_sgc_accounting_upload"/>
        <field name="domain_force">[('client_id.owner_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
