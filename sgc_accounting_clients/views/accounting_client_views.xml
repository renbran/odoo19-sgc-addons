<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_accounting_client_list" model="ir.ui.view">
        <field name="name">sgc.accounting.client.list</field>
        <field name="model">sgc.accounting.client</field>
        <field name="arch" type="xml">
            <list string="Accounting Clients" decoration-danger="status == 'failed'" decoration-muted="not active">
                <field name="name"/>
                <field name="client_code"/>
                <field name="partner_id"/>
                <field name="status" widget="badge"/>
                <field name="company_count" optional="show"/>
                <field name="pending_upload_count" optional="show"/>
                <field name="account_manager_id" optional="hide"/>
                <field name="workspace_url" widget="url" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_accounting_client_form" model="ir.ui.view">
        <field name="name">sgc.accounting.client.form</field>
        <field name="model">sgc.accounting.client</field>
        <field name="arch" type="xml">
            <form string="Accounting Client">
                <header>
                    <button name="action_queue_provision" type="object" string="Queue Provisioning" class="btn-primary" invisible="status in ('provisioning', 'active')"/>
                    <button name="action_sync_companies" type="object" string="Sync Companies" invisible="not db_name"/>
                    <button name="action_open_workspace" type="object" string="Open Workspace" invisible="not workspace_url"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,ready,queued,provisioning,active,suspended"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_companies" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="company_count" widget="statinfo" string="Companies"/>
                        </button>
                        <button name="action_open_uploads" type="object" class="oe_stat_button" icon="fa-files-o">
                            <field name="upload_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Client name"/></h1>
                        <group>
                            <group>
                                <field name="client_code" placeholder="lowercase-code"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="status_label"/>
                                <field name="account_manager_id"/>
                            </group>
                        </group>
                    </div>
                    <notebook>
                        <page string="Workspace" name="workspace">
                            <group>
                                <group string="Identity">
                                    <field name="legal_name"/>
                                    <field name="trn"/>
                                    <field name="trade_license_no"/>
                                    <field name="emirate"/>
                                    <field name="fiscal_year_end"/>
                                    <field name="currency_id"/>
                                </group>
                                <group string="Registration">
                                    <field name="vat_registered"/>
                                    <field name="corporate_tax_registered"/>
                                    <field name="require_trn"/>
                                    <field name="data_residency"/>
                                </group>
                            </group>
                            <group>
                                <group string="Workspace">
                                    <field name="base_url" placeholder="https://demo.sgctech.ai"/>
                                    <field name="workspace_url"/>
                                    <field name="mcp_url"/>
                                </group>
                                <group string="Database">
                                    <field name="db_name"/>
                                    <field name="db_host"/>
                                    <field name="db_port"/>
                                    <field name="db_user"/>
                                    <field name="db_secret_ref" password="True"/>
                                </group>
                            </group>
                        </page>
                        <page string="Companies" name="companies">
                            <field name="company_ids">
                                <list editable="bottom">
                                    <field name="odoo_company_id"/>
                                    <field name="name"/>
                                    <field name="trn"/>
                                    <field name="currency_id"/>
                                    <field name="is_default"/>
                                    <field name="active"/>
                                    <field name="last_sync_at"/>
                                </list>
                            </field>
                            <group>
                                <field name="default_company_id"/>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="upload_ids">
                                <list create="false" edit="false">
                                    <field name="create_date"/>
                                    <field name="doc_type_label"/>
                                    <field name="filename"/>
                                    <field name="accounting_company_id"/>
                                    <field name="state_label"/>
                                    <field name="file_size_human"/>
                                </list>
                            </field>
                        </page>
                        <page string="Automation" name="automation">
                            <group>
                                <group string="Agent">
                                    <field name="assigned_agent"/>
                                    <field name="agent_endpoint" widget="url" placeholder="https://agent.internal/api/v1/process-document"/>
                                    <field name="hitl_reviewer_email" widget="email"/>
                                </group>
                                <group string="Thresholds">
                                    <field name="auto_post_max_aed"/>
                                    <field name="min_confidence"/>
                                </group>
                            </group>
                        </page>
                        <page string="Storage" name="storage">
                            <group>
                                <group string="Backend">
                                    <field name="storage_backend"/>
                                    <field name="storage_bucket" invisible="storage_backend != 's3'"/>
                                    <field name="storage_root"/>
                                </group>
                                <group string="Paths">
                                    <field name="inbox_paths" placeholder="Leave empty for the computed per-type layout"/>
                                    <field name="processed_path"/>
                                    <field name="quarantine_path"/>
                                    <field name="archive_path"/>
                                </group>
                            </group>
                        </page>
                        <page string="Retention" name="retention">
                            <group>
                                <group>
                                    <field name="retention_policy"/>
                                    <field name="retention_until"/>
                                </group>
                                <group>
                                    <field name="provisioned_at"/>
                                    <field name="last_health_check"/>
                                </group>
                            </group>
                            <field name="last_error" invisible="not last_error"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sgc_accounting_client_search" model="ir.ui.view">
        <field name="name">sgc.accounting.client.search</field>
        <field name="model">sgc.accounting.client</field>
        <field name="arch" type="xml">
            <search string="Accounting Clients">
                <field name="name"/>
                <field name="client_code"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="status_active" string="Active workspaces" domain="[('status', '=', 'active')]"/>
                <filter name="status_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter name="status_queued" string="Queued or provisioning" domain="[('status', 'in', ('queued', 'provisioning'))]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_manager" string="Account Manager" context="{'group_by': 'account_manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sgc_accounting_client" model="ir.actions.act_window">
        <field name="name">Accounting Clients</field>
        <field name="res_model">sgc.accounting.client</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first accounting workspace</p>
            <p>Register the customer, the workspace database and the companies that the accounting agents may use.</p>
        </field>
    </record>
</odoo>
