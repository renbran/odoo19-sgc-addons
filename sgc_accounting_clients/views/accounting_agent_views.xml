<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_accounting_agent_run_list" model="ir.ui.view">
        <field name="name">sgc.accounting.agent.run.list</field>
        <field name="model">sgc.accounting.agent.run</field>
        <field name="arch" type="xml">
            <list string="Accounting Agent Runs" decoration-danger="state == 'failed'" decoration-warning="state == 'queued'" decoration-success="state == 'completed'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="bucket_label" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="review_required" optional="show"/>
                <field name="transport" optional="hide"/>
                <field name="attempts" optional="hide"/>
                <field name="response_code" optional="hide"/>
                <field name="dispatched_at" optional="hide"/>
                <field name="last_error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_accounting_agent_run_form" model="ir.ui.view">
        <field name="name">sgc.accounting.agent.run.form</field>
        <field name="model">sgc.accounting.agent.run</field>
        <field name="arch" type="xml">
            <form string="Accounting Agent Run">
                <header>
                    <button name="action_dispatch" type="object" string="Dispatch Now" class="btn-primary" invisible="state not in ('queued', 'failed')"/>
                    <button name="action_retry" type="object" string="Retry" invisible="state not in ('failed', 'cancelled', 'completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,dispatched,running,completed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="run_id" readonly="1"/>
                            <field name="upload_id" readonly="1"/>
                            <field name="client_id" readonly="1"/>
                            <field name="bucket" readonly="1"/>
                        </group>
                        <group>
                            <field name="attempts" readonly="1"/>
                            <field name="response_code" readonly="1"/>
                            <field name="dispatched_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                            <field name="callback_received_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="endpoint" readonly="1"/>
                        <field name="transport" readonly="1"/>
                        <field name="review_required" readonly="1"/>
                        <field name="last_error" readonly="1" invisible="not last_error"/>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload" readonly="1"/>
                        </page>
                        <page string="Match target" name="match_target">
                            <field name="match_target" readonly="1"/>
                        </page>
                        <page string="Matches" name="matches">
                            <field name="matches" readonly="1"/>
                        </page>
                        <page string="Extraction" name="extraction">
                            <field name="extraction" readonly="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_body" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sgc_accounting_agent_run_search" model="ir.ui.view">
        <field name="name">sgc.accounting.agent.run.search</field>
        <field name="model">sgc.accounting.agent.run</field>
        <field name="arch" type="xml">
            <search string="Accounting Agent Runs">
                <field name="run_id"/>
                <field name="upload_id"/>
                <field name="client_id"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="dispatched" string="Dispatched" domain="[('state', '=', 'dispatched')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <group>
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_bucket" string="Bucket" context="{'group_by': 'bucket'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sgc_accounting_agent_run" model="ir.actions.act_window">
        <field name="name">Agent Runs</field>
        <field name="res_model">sgc.accounting.agent.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No agent runs yet</p>
            <p>Every accepted portal document creates an agent run. The cron dispatcher sends queued runs to the configured document-intake endpoint.</p>
        </field>
    </record>
</odoo>
