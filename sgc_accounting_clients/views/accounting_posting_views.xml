<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_accounting_posting_request_list" model="ir.ui.view">
        <field name="name">sgc.accounting.posting.request.list</field>
        <field name="model">sgc.accounting.posting.request</field>
        <field name="arch" type="xml">
            <list string="Posting Requests"
                  decoration-danger="state == 'failed'"
                  decoration-success="state == 'posted'"
                  decoration-muted="state == 'refused'">
                <field name="requested_at"/>
                <field name="client_id"/>
                <field name="upload_id"/>
                <field name="move_name"/>
                <field name="move_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="over_limit"/>
                <field name="approved_at" optional="hide"/>
                <field name="posted_at" optional="hide"/>
                <field name="last_error" optional="hide"/>
                <button name="action_approve" type="object" string="Approve"
                        class="btn-primary" invisible="state != 'pending'"/>
                <button name="action_post" type="object" string="Post"
                        invisible="state != 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_accounting_posting_request_form" model="ir.ui.view">
        <field name="name">sgc.accounting.posting.request.form</field>
        <field name="model">sgc.accounting.posting.request</field>
        <field name="arch" type="xml">
            <form string="Posting Request">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state != 'pending'"/>
                    <button name="action_post" type="object" string="Post"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,posted"/>
                </header>
                <sheet>
                    <group>
                        <group string="Draft">
                            <field name="client_id"/>
                            <field name="upload_id"/>
                            <field name="move_name"/>
                            <field name="move_id"/>
                            <field name="amount"/>
                            <field name="currency"/>
                            <field name="over_limit"/>
                        </group>
                        <group string="Trace">
                            <field name="approval_id"/>
                            <field name="requested_at"/>
                            <field name="approved_at"/>
                            <field name="posted_at"/>
                            <field name="attempts"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sgc_accounting_posting_request" model="ir.actions.act_window">
        <field name="name">Posting Requests</field>
        <field name="res_model">sgc.accounting.posting.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No posting request yet.</p>
            <p>A posting request is opened for every draft the agent booked in a
               client database. A manager approves it, then the posting agent
               posts the entry.</p>
        </field>
    </record>
</odoo>
