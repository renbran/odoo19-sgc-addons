<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgc_accounting_provision_list" model="ir.ui.view">
        <field name="name">sgc.accounting.provision.event.list</field>
        <field name="model">sgc.accounting.provision.event</field>
        <field name="arch" type="xml">
            <list string="Provisioning Events" decoration-danger="state == 'dead'" decoration-warning="state == 'rejected'">
                <field name="create_date"/>
                <field name="event_id" optional="hide"/>
                <field name="client_id"/>
                <field name="event_type"/>
                <field name="state" widget="badge"/>
                <field name="attempts"/>
                <field name="next_attempt_at"/>
                <field name="last_status_code"/>
            </list>
        </field>
    </record>

    <record id="view_sgc_accounting_provision_form" model="ir.ui.view">
        <field name="name">sgc.accounting.provision.event.form</field>
        <field name="model">sgc.accounting.provision.event</field>
        <field name="arch" type="xml">
            <form string="Provisioning Event">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary" invisible="state not in ('rejected', 'dead')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,rejected,dead"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id" readonly="1"/>
                            <field name="client_id" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="attempts" readonly="1"/>
                            <field name="next_attempt_at" readonly="1"/>
                            <field name="last_status_code" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload" readonly="1"/>
                        </page>
                        <page string="Error" name="error">
                            <field name="last_error" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sgc_accounting_provision_search" model="ir.ui.view">
        <field name="name">sgc.accounting.provision.event.search</field>
        <field name="model">sgc.accounting.provision.event</field>
        <field name="arch" type="xml">
            <search string="Provisioning Events">
                <field name="event_id"/>
                <field name="client_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="dead" string="Dead" domain="[('state', '=', 'dead')]"/>
                <separator/>
                <filter name="provision" string="Provision" domain="[('event_type', '=', 'provision')]"/>
                <filter name="sync_companies" string="Sync companies" domain="[('event_type', '=', 'sync_companies')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sgc_accounting_provision" model="ir.actions.act_window">
        <field name="name">Provisioning</field>
        <field name="res_model">sgc.accounting.provision.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No provisioning events</p>
            <p>Provisioning events are created from an accounting client and consumed by the tenant receiver.</p>
        </field>
    </record>
</odoo>
