<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_accounting_home_card" name="Accounting Portal Home Card" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-set="accounting_is_internal" t-value="request.env.user.has_group('sgc_accounting_clients.group_sgc_accounting_user')"/>
            <t t-set="accounting_domain" t-value="[] if accounting_is_internal else [('partner_id.commercial_partner_id', '=', request.env.user.partner_id.commercial_partner_id.id)]"/>
            <t t-set="accounting_count" t-value="request.env['sgc.accounting.client'].sudo().search_count(accounting_domain)"/>
            <div t-if="accounting_count" class="o_portal_category row g-2 mt-3">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="title">Accounting</t>
                    <t t-set="text">Workspaces, companies and document intake</t>
                    <t t-set="url" t-value="'/my/accounting'"/>
                    <t t-set="count" t-value="accounting_count"/>
                    <t t-set="show_count" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="portal_accounting_home" name="Accounting Workspaces">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Accounting</t>
            <div class="o_portal_accounting">
                <div class="d-flex flex-wrap justify-content-between align-items-start mb-4">
                    <div>
                        <h1 class="mb-1">Accounting</h1>
                        <p class="text-muted mb-0">Your accounting workspaces, companies and document intake.</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6 col-lg-4" t-foreach="clients" t-as="client">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0"><t t-esc="client.name"/></h5>
                                    <span t-attf-class="badge #{'text-bg-success' if client.status == 'active' else 'text-bg-secondary'}"><t t-esc="client.status_label"/></span>
                                </div>
                                <p class="text-muted small mb-3"><t t-esc="client.client_code"/></p>
                                <dl class="row small mb-3">
                                    <dt class="col-6">Companies</dt>
                                    <dd class="col-6 text-end"><t t-esc="client.company_count"/></dd>
                                    <dt class="col-6">Documents</dt>
                                    <dd class="col-6 text-end"><t t-esc="client.upload_count"/></dd>
                                    <dt class="col-6">Pending</dt>
                                    <dd class="col-6 text-end"><t t-esc="client.pending_upload_count"/></dd>
                                </dl>
                                <a t-attf-href="/my/accounting/#{client.client_code}" class="btn btn-primary btn-sm mt-auto">Open workspace</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12" t-if="not clients">
                        <div class="alert alert-info mb-0" role="alert">
                            No accounting workspace is linked to your account yet. Please contact your account manager.
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_accounting_client" name="Accounting Workspace">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="additional_title">Accounting Workspace</t>
            <div class="o_portal_accounting">
                <div class="d-flex flex-wrap justify-content-between align-items-start mb-4">
                    <div>
                        <a href="/my/accounting" class="small text-muted text-decoration-none">&#8592; All accounting workspaces</a>
                        <h1 class="mt-2 mb-1"><t t-esc="client.name"/></h1>
                        <p class="text-muted mb-0">
                            <t t-esc="client.client_code"/>
                            <span t-if="client.workspace_url"> &#183; <a t-att-href="client.workspace_url" target="_blank" rel="noopener"><t t-esc="client.workspace_url"/></a></span>
                            <span t-if="not client.workspace_url"> &#183; Workspace pending</span>
                        </p>
                    </div>
                    <div class="text-end">
                        <span t-attf-class="badge #{'text-bg-success' if client.status == 'active' else 'text-bg-secondary'}"><t t-esc="client.status_label"/></span>
                    </div>
                </div>

                <div t-if="message" class="alert alert-info" role="alert"><t t-esc="message"/></div>
                <div t-if="missing_columns" class="alert alert-warning" role="alert">
                    <strong>The file is missing these columns:</strong>
                    <span t-esc="', '.join(missing_columns)"/>.
                    Download the bucket's sample guide and use the exact column names.
                </div>
                <div t-if="format_detail" class="alert alert-warning" role="alert"><t t-esc="format_detail"/></div>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-0">Upload buckets</h5>
                                    <p class="text-muted small mb-0">Choose the accounting bucket, download its format guide, then upload.</p>
                                </div>
                                <span class="badge text-bg-light"><t t-esc="len(bucket_guides)"/> buckets</span>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6" t-foreach="bucket_guides" t-as="item">
                                        <div t-attf-class="border rounded p-3 h-100 #{'border-primary bg-light' if item['code'] == selected_bucket else ''}">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <h6 class="mb-0"><t t-esc="item['name']"/></h6>
                                                <span class="badge text-bg-light"><t t-esc="len(item['required'])"/> columns</span>
                                            </div>
                                            <p class="text-muted small mb-2"><t t-esc="item['short']"/></p>
                                            <p class="small mb-2"><strong>Formats:</strong> <t t-esc="item['formats']"/> &#183; <strong>Limit:</strong> max 50 data rows per file</p>
                                            <details class="small text-muted mb-2">
                                                <summary>Required columns and notes</summary>
                                                <ul class="mb-1 ps-3">
                                                    <li t-foreach="item['required']" t-as="column"><t t-esc="column"/></li>
                                                </ul>
                                                <p class="mb-0" t-foreach="item['notes']" t-as="note"><t t-esc="note"/></p>
                                            </details>
                                            <div class="d-flex flex-wrap gap-2">
                                                <a t-attf-href="/my/accounting/#{client.client_code}/bucket/#{item['code']}/sample" class="btn btn-sm btn-outline-secondary">Download sample CSV</a>
                                                <a t-attf-href="/my/accounting/#{client.client_code}?bucket=#{item['code']}#upload" class="btn btn-sm btn-outline-primary">Use this bucket</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-transparent">
                                <h5 class="mb-0">Recent documents</h5>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Received</th>
                                            <th>Document</th>
                                            <th>Bucket</th>
                                            <th>Status</th>
                                            <th>Agent</th>
                                            <th class="text-end">Size</th>
                                            <th/>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="uploads" t-as="upload">
                                            <td class="text-nowrap"><t t-esc="upload.create_date"/></td>
                                            <td><t t-esc="upload.filename"/></td>
                                            <td><t t-esc="upload.doc_type_label"/></td>
                                            <td><span class="badge text-bg-light"><t t-esc="upload.state_label"/></span></td>
                                            <td><span t-attf-class="badge #{'text-bg-success' if upload.agent_state == 'completed' else ('text-bg-danger' if upload.agent_state == 'failed' else 'text-bg-light')}"><t t-esc="upload.agent_state_label or 'Not queued'"/></span></td>
                                            <td class="text-end text-nowrap"><t t-esc="upload.file_size_human"/></td>
                                            <td class="text-end">
                                                <a t-attf-href="/my/accounting/upload/#{upload.id}/download" class="btn btn-sm btn-outline-secondary">Download</a>
                                            </td>
                                        </tr>
                                        <tr t-if="not uploads">
                                            <td colspan="7" class="text-muted">No documents uploaded yet.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card border-0 shadow-sm mb-4" id="upload">
                            <div class="card-header bg-transparent">
                                <h5 class="mb-0">Upload a document</h5>
                            </div>
                            <div class="card-body">
                                <form t-attf-action="/my/accounting/#{client.client_code}/upload" method="post" enctype="multipart/form-data" class="sgc-upload-form mb-0">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label class="form-label" for="doc_type">Upload bucket</label>
                                        <select class="form-select" id="doc_type" name="doc_type" required="required">
                                            <option value="">Select a bucket</option>
                                            <option t-foreach="bucket_guides" t-as="item" t-att-value="item['code']" t-att-selected="'selected' if item['code'] == selected_bucket else None"><t t-esc="item['name']"/></option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="company_id">Company</label>
                                        <select class="form-select" id="company_id" name="company_id">
                                            <option value="">Use the default company</option>
                                            <option t-foreach="companies" t-as="company" t-att-value="company.id"><t t-esc="company.name"/></option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="file">File</label>
                                        <input class="form-control" id="file" name="file" type="file" required="required" accept=".pdf,.csv,.xlsx,.xls,.png,.jpg,.jpeg"/>
                                        <div class="form-text">PDF, CSV, XLSX, XLS, JPG, JPEG or PNG. Maximum 25 MB per file and maximum 50 data rows per file; split larger files and upload each part.</div>
                                    </div>
                                    <div class="sgc-upload-progress d-none mt-3" aria-live="polite">
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width: 0%"/>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-1">
                                            <span class="small text-muted sgc-upload-status">Uploading&#8230; 0%</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary sgc-upload-cancel">Cancel</button>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Upload and queue agent</button>
                                </form>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-transparent">
                                <h5 class="mb-0">How it works</h5>
                            </div>
                            <div class="card-body small text-muted">
                                <p class="mb-2"><strong>1.</strong> Download the sample CSV for your bucket and keep the exact header names.</p>
                                <p class="mb-2"><strong>2.</strong> Upload the file for the correct company. Tabular files may hold at most 50 data rows; split larger files into parts of 50 rows or fewer.</p>
                                <p class="mb-2"><strong>3.</strong> The portal validates the headers, hashes the file and queues an agent run.</p>
                                <p class="mb-0"><strong>4.</strong> The agent reads the document and matches it against the client workspace (<t t-esc="client.workspace_url or 'target pending'"/>).</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
