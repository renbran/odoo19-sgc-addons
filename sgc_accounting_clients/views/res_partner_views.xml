<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_sgc_accounting" model="ir.ui.view">
        <field name="name">res.partner.form.sgc.accounting</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_accounting_client" type="object" class="oe_stat_button" icon="fa-calculator" invisible="not accounting_client_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Accounting</span>
                        <span class="o_stat_value"><field name="accounting_client_code"/></span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Accounting" name="accounting">
                    <group>
                        <group string="Workspace">
                            <field name="accounting_client_id" readonly="1"/>
                            <field name="accounting_status" readonly="1"/>
                            <field name="accounting_client_code" readonly="1"/>
                            <field name="accounting_db_name" readonly="1"/>
                            <field name="accounting_base_url" widget="url" readonly="1"/>
                            <field name="accounting_storage_root" readonly="1"/>
                        </group>
                        <group string="Agent Context">
                            <field name="accounting_context" readonly="1"/>
                        </group>
                    </group>
                    <field name="accounting_client_ids" readonly="1">
                        <list create="false" edit="false">
                            <field name="name"/>
                            <field name="client_code"/>
                            <field name="status" widget="badge"/>
                            <field name="company_count"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
